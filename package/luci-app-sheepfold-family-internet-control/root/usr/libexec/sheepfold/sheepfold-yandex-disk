#!/bin/sh
# Архивирование журналов и резервных копий настроек в Yandex Disk через WebDAV.
set -eu

WEBDAV_BASE="https://webdav.yandex.ru"
RAM_ARCHIVE_DIR="/tmp/sheepfold/.private/archive"
EVENTS_LOG="/tmp/sheepfold/events.log"
BACKUP_STAGING="/tmp/sheepfold/.yandex-backup-staging"
SYNC_STATUS_FILE="/tmp/sheepfold/.yandex-sync-status.json"

uci_get() {
	uci -q get "sheepfold.cloud.$1" 2>/dev/null || printf '%s' "${2:-}"
}

global_get() {
	uci -q get "sheepfold.global.$1" 2>/dev/null || printf '%s' "${2:-}"
}

json_escape() {
	printf '%s' "$1" | tr '\r\n\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

have_curl() {
	command -v curl >/dev/null 2>&1
}

credentials_ready() {
	# Частичный вывод неуспешного UCI не является реквизитами для сети.
	login="$(uci -q get sheepfold.cloud.login 2>/dev/null)" || return 1
	password="$(uci -q get sheepfold.cloud.password 2>/dev/null)" || return 1
	[ -n "$login" ] && [ -n "$password" ]
}

normalize_root_folder() (
	# Отказ get не означает отсутствия настройки и не разрешает выбрать другое
	# облачное назначение. Сверка замечает изменение между чтениями, не заменяя
	# общую транзакцию UCI. Subshell не меняет переменные вызывающего обработчика.
	snapshot="$(uci -q show sheepfold.cloud 2>/dev/null)" || return 1
	if ! folder="$(uci -q get sheepfold.cloud.root_folder 2>/dev/null)"; then
		case "
$snapshot" in *'
sheepfold.cloud.root_folder='*) return 1 ;; esac
		folder='/sheepfold'
	fi
	current="$(uci -q show sheepfold.cloud 2>/dev/null)" || return 1
	[ "$current" = "$snapshot" ] || return 1
	case "$folder" in
		/*) ;;
		*) folder="/$folder" ;;
	esac
	folder="${folder%/}"
	[ -n "$folder" ] || folder="/sheepfold"
	webdav_url "$folder" >/dev/null || return 1
	printf '%s' "$folder"
)

quota_mb() {
	quota="$(uci_get quota_mb '500')"
	case "$quota" in
		50|100|250|500|1024) printf '%s' "$quota" ;;
		*) printf '500' ;;
	esac
}

# Вход — логический путь из настройки/имени файла, а не уже готовый URI.
# Кодируем байты ровно один раз: «%2F» в имени означает буквальное %2F, не «/».
webdav_url() (
	[ "$#" -eq 1 ] && [ -n "$1" ] || return 1
	path="$1"
	case "$path" in /*) ;; *) path="/$path" ;; esac
	# -g отключает только globbing curl, но не query/fragment, пробелы и «..».
	# Отбрасываем весь вывод отказавшего encoder до возврата URL вызывающему.
	encoded="$(printf '%s\n' "$path" | LC_ALL=C awk '
		BEGIN { for (i = 1; i < 256; i++) codes[sprintf("%c", i)] = i }
		NR != 1 || /[[:cntrl:]]/ { exit 1 }
		{
			count = split($0, parts, "/")
			for (i = 1; i <= count; i++)
				if (parts[i] == "." || parts[i] == "..") exit 1
			result = ""
			for (i = 1; i <= length($0); i++) {
				ch = substr($0, i, 1)
				if (ch ~ /^[A-Za-z0-9_~.\/-]$/) result = result ch
				else {
					if (!(ch in codes)) exit 1
					result = result sprintf("%%%02X", codes[ch])
				}
			}
			printf "%s", result
		}
	')" || return 1
	[ -n "$encoded" ] || return 1
	printf '%s%s' "$WEBDAV_BASE" "$encoded"
)

# Узкий транспорт PROPFIND. Возвращает тело только после успешного curl/207.
# XML-поля и полноту коллекции обязан проверять вызывающий reader отдельно.
webdav_request() (
	[ "$#" -eq 3 ] || return 1
	method="$1"
	url="$2"
	depth="$3"
	[ "$method" = "PROPFIND" ] || return 1
	case "$depth" in 0|1) ;; *) return 1 ;; esac
	credentials_ready || return 1
	# Depth — один аргумент заголовка; прежнее $extra превращало 0/1 в URL.
	# -q первым аргументом исключает скрытый -L из curlrc. TLS не отключается.
	reply="$(curl -q -g -sS -m 45 --proto '=https' -u "$login:$password" \
		-X "$method" -H "Depth: $depth" -w '\n%{http_code}' --url "$url")" || return 1
	separator='
'
	case "$reply" in *"$separator"*) ;; *) return 1 ;; esac
	httpCode="${reply##*"$separator"}"
	[ "$httpCode" = '207' ] || return 1
	printf '%s' "${reply%"$separator"*}"
)

# Это транспортная проба доступа, не проверка всех propstat внутри XML.
# Отказ curl никогда не склеивается с его stdout в JSON-число вроде 000000.
webdav_probe() (
	credentials_ready || return 1
	httpCode="$(curl -q -g -sS -m 30 --proto '=https' -o /dev/null -w '%{http_code}' \
		-u "$login:$password" -X PROPFIND -H 'Depth: 0' --url "$WEBDAV_BASE/")" || return 1
	case "$httpCode" in [1-5][0-9][0-9]) printf '%s' "$httpCode" ;; *) return 1 ;; esac
)

require_tooling() {
	if ! have_curl; then
		printf '{"ok":false,"error":"curl_required"}\n'
		return 1
	fi
	if ! credentials_ready; then
		printf '{"ok":false,"error":"credentials_missing"}\n'
		return 1
	fi
	return 0
}

ensure_webdav_path() (
	[ "$#" -eq 1 ] && [ -n "$1" ] || return 1
	target="$1"
	# Проверяем весь путь до первого MKCOL, а не после создания его предков.
	webdav_url "$target" >/dev/null || return 1
	credentials_ready || return 1
	current=""
	remaining="${target#/}"
	# Не применяем set -- $(...) и IFS='/': имя папки не является файловой
	# маской на роутере. Subshell сохраняет IFS, аргументы и переменные caller.
	while [ -n "$remaining" ]; do
		part="${remaining%%/*}"
		if [ "$part" = "$remaining" ]; then
			remaining=""
		else
			remaining="${remaining#*/}"
		fi
		[ -n "$part" ] || continue
		current="${current}/${part}"
		url="$(webdav_url "$current")" || return 1
		# Проверяем exit отдельно от stdout. Не следуем redirect и не читаем
		# curlrc; MKCOL получает ровно один явный URL с сохранённым TLS.
		code="$(curl -q -g -sS -m 30 --proto '=https' -o /dev/null -w '%{http_code}' \
			-u "$login:$password" -X MKCOL --url "$url")" || return 1
		case "$code" in
			201) ;;
			# Сохраняем повтор для уже существующего URI. Сам по себе 405 не
			# доказывает тип collection: полная проверка DAV XML остаётся R15.
			405) ;;
			*) return 1 ;;
		esac
	done
)

remote_path_allowed() {
	path="$1"
	webdav_url "$path" >/dev/null || return 1
	root="$(normalize_root_folder)" || return 1
	prefix_logs="${root}/logs/"
	prefix_backups="${root}/backups/"

	case "$path" in
		"${prefix_logs}"*) ;;
		"${prefix_backups}"*) ;;
		*) return 1 ;;
	esac
	case "$path" in
		*..*) return 1 ;;
	esac
	return 0
}

resolve_remote_path() {
	spec="$1"
	root="$(normalize_root_folder)" || return 1
	case "$spec" in
		/*)
			remote_path="$spec"
			;;
		logs/*)
			remote_path="${root}/${spec}"
			;;
		backups/*)
			remote_path="${root}/${spec}"
			;;
		*)
			remote_path="${root}/backups/${spec}"
			;;
	esac

	if ! remote_path_allowed "$remote_path"; then
		printf '{"ok":false,"error":"path_not_allowed"}\n'
		return 1
	fi
	printf '%s' "$remote_path"
}

folder_used_bytes() {
	local url
	root="$1"
	url="$(webdav_url "$root")" || return 1
	response="$(webdav_request PROPFIND "$url" 1)" || return 1
	printf '%s' "$response" | awk '
		BEGIN { total = 0 }
		/<[^>]*getcontentlength[^>]*>[0-9]+/ {
			line = $0
			sub(/.*<[^>]*getcontentlength[^>]*>/, "", line)
			sub(/<.*/, "", line)
			if (line ~ /^[0-9]+$/) total += line
		}
		END { print total + 0 }
	'
}

remote_file_bytes() {
	local url
	remote_path="$1"
	url="$(webdav_url "$remote_path")" || return 1
	response="$(webdav_request PROPFIND "$url" 0)" || return 1
	printf '%s' "$response" | sed -n 's/.*getcontentlength>\([0-9]*\).*/\1/p' | head -1
}

usage_state() {
	used_bytes="$1"
	quota_bytes="$2"
	[ "$quota_bytes" -gt 0 ] || { printf 'error\t0\n'; return; }
	pct=$((used_bytes * 100 / quota_bytes))
	if [ "$used_bytes" -ge "$quota_bytes" ]; then
		printf 'error\t%s\n' "$pct"
	elif [ "$pct" -ge 80 ]; then
		printf 'warn\t%s\n' "$pct"
	else
		printf 'ok\t%s\n' "$pct"
	fi
}

write_sync_status() {
	command_name="$1"
	ok="$2"
	message="$3"
	mkdir -p /tmp/sheepfold 2>/dev/null || true
	printf '{"command":"%s","ok":%s,"message":"%s","at":"%s"}\n' \
		"$(json_escape "$command_name")" "$ok" "$(json_escape "$message")" "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
		>"$SYNC_STATUS_FILE"
	chmod 600 "$SYNC_STATUS_FILE" 2>/dev/null || true
}

verify_upload() {
	local_path="$1"
	remote_path="$2"
	local_bytes remote_bytes

	[ -f "$local_path" ] || {
		printf '{"ok":false,"error":"local_missing"}\n'
		return 1
	}

	local_bytes="$(wc -c <"$local_path" | tr -d ' ')"
	case "$local_bytes" in ''|*[!0-9]*) local_bytes=0 ;; esac
	remote_bytes="$(remote_file_bytes "$remote_path" 2>/dev/null || true)"
	case "$remote_bytes" in ''|*[!0-9]*) remote_bytes=0 ;; esac

	if [ "$local_bytes" -gt 0 ] && [ "$local_bytes" -eq "$remote_bytes" ]; then
		printf '{"ok":true,"local_bytes":%s,"remote_bytes":%s}\n' "$local_bytes" "$remote_bytes"
		return 0
	fi

	printf '{"ok":false,"error":"size_mismatch","local_bytes":%s,"remote_bytes":%s}\n' \
		"$local_bytes" "$remote_bytes"
	return 1
}

upload_file() {
	local url
	local_path="$1"
	remote_path="$2"
	url="$(webdav_url "$remote_path")" || return 1
	curl -sS -m 120 -o /dev/null -w '%{http_code}' -T "$local_path" \
		-u "$(uci_get login):$(uci_get password)" "$url"
}

upload_and_verify() {
	local_path="$1"
	remote_path="$2"
	code verify_json

	code="$(upload_file "$local_path" "$remote_path")"
	case "$code" in
		201|204|200) ;;
		*)
			printf '{"ok":false,"http":%s}\n' "$code"
			return 1
			;;
	esac

	verify_json="$(verify_upload "$local_path" "$remote_path" 2>/dev/null || true)"
	case "$verify_json" in
		*"\"ok\":true"*) printf '%s\n' "$verify_json"; return 0 ;;
	esac

	printf '%s\n' "$verify_json"
	return 1
}

# Имя до секунды остаётся внешним именем копии, но не определяет владельца
# локального файла. Каждый архивный проход получает собственный RAM-каталог.
yandex_archive_workdir() (
	umask 077
	[ ! -L /tmp/sheepfold ] || exit 1
	mkdir -p /tmp/sheepfold || exit 1
	chmod 700 /tmp/sheepfold || exit 1
	work="$(mktemp -d /tmp/sheepfold/.yandex-archive.XXXXXX)" || exit 1
	# Не удаляем частичный stdout отказавшего mktemp: это может быть чужой путь.
	chmod 700 "$work" || { rm -rf "$work"; exit 1; }
	printf '%s' "$work"
)

yandex_archive_stamp() (
	stamp="$(date +%Y%m%d-%H%M%S)" || exit 1
	case "$stamp" in
		[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]) ;;
		*) exit 1 ;;
	esac
	printf '%s' "$stamp"
)

create_config_backup() (
	work="${1:-}"
	[ -n "$work" ] && [ -d "$work" ] && [ ! -L "$work" ] || exit 1
	umask 077
	[ -f /etc/config/sheepfold ] && [ ! -L /etc/config/sheepfold ] || exit 1
	mkdir "$work/config-source" || exit 1
	cp -p /etc/config/sheepfold "$work/config-source/sheepfold" || exit 1
	chmod 600 "$work/config-source/sheepfold" || exit 1
	cmp -s /etc/config/sheepfold "$work/config-source/sheepfold" || exit 1
	stamp="$(yandex_archive_stamp)" || exit 1
	backup_file="$work/sheepfold-config-$stamp.tar.gz"
	if command -v gzip >/dev/null 2>&1; then
		tar -C "$work/config-source" -czf "$backup_file" sheepfold || exit 1
		list_flags=-tzf
		read_flags=-xzOf
	else
		backup_file="${backup_file%.gz}"
		tar -C "$work/config-source" -cf "$backup_file" sheepfold || exit 1
		list_flags=-tf
		read_flags=-xOf
	fi
	chmod 600 "$backup_file" || exit 1
	# Проверяем свой архив до отправки, не включаем восстановление. Читаем в
	# stdout: пути/права из архива не применяются к /etc/config или файловой системе.
	members="$(tar "$list_flags" "$backup_file")" || exit 1
	[ "$members" = sheepfold ] || exit 1
	tar "$read_flags" "$backup_file" sheepfold >"$work/config-verified" || exit 1
	cmp -s "$work/config-source/sheepfold" "$work/config-verified" || exit 1
	[ ! -L /etc/config/sheepfold ] || exit 1
	cmp -s /etc/config/sheepfold "$work/config-source/sheepfold" || exit 1
	printf '%s' "$backup_file"
)

yandex_archive_prepare_error() {
	# Неудача служебного статуса не должна скрывать исходную ошибку подготовки.
	write_sync_status archive-push false "completed with errors" >/dev/null 2>&1 || :
	printf '{"ok":false,"error":"%s","pushed":0,"errors":1}\n' "$1"
	return 1
}

propfind_folder_json_array() {
	local url
	folder="$1"
	url="$(webdav_url "$folder")" || return 1
	response="$(webdav_request PROPFIND "$url" 1)" || return 1
	printf '%s' "$response" | awk -v folder="$folder" '
		function json_escape(value,    chars) {
			gsub(/\\/, "\\\\", value)
			gsub(/"/, "\\\"", value)
			return value
		}
		function flush(    name, esc_name, esc_modified) {
			if (href == "" || href == folder || href == folder "/") {
				href = ""
				size = 0
				modified = ""
				return
			}
			name = href
			sub(/^.*\//, "", name)
			if (name == "") {
				href = ""
				size = 0
				modified = ""
				return
			}
			esc_name = json_escape(name)
			esc_modified = json_escape(modified)
			if (items != "") items = items ","
			items = items sprintf("{\"name\":\"%s\",\"path\":\"%s\",\"bytes\":%s,\"modified\":\"%s\"}",
				esc_name, json_escape(href), (size == "" ? 0 : size), esc_modified)
			href = ""
			size = 0
			modified = ""
		}
		BEGIN {
			items = ""
			href = ""
			size = 0
			modified = ""
		}
		/<[dD]:href>/ {
			flush()
			line = $0
			sub(/.*<[dD]:href>/, "", line)
			sub(/<.*/, "", line)
			gsub(/%20/, " ", line)
			href = line
		}
		/getcontentlength/ {
			line = $0
			sub(/.*getcontentlength>/, "", line)
			sub(/<.*/, "", line)
			size = line
		}
		/getlastmodified/ {
			line = $0
			sub(/.*getlastmodified>/, "", line)
			sub(/<.*/, "", line)
			modified = line
		}
		END {
			flush()
			printf "%s", items
		}
	'
}

cmd_test() {
	require_tooling || return 1

	code="$(webdav_probe 2>/dev/null)" || code=0
	case "$code" in
		207)
			printf '{"ok":true,"message":"Yandex Disk login works"}\n'
			;;
		401|403)
			printf '{"ok":false,"error":"auth_failed","http":%s}\n' "$code"
			return 1
			;;
		*)
			printf '{"ok":false,"error":"unreachable","http":%s}\n' "$code"
			return 1
			;;
	esac
}

cmd_list() {
	root logs_json backups_json

	require_tooling || return 1
	root="$(normalize_root_folder)" || return 1
	logs_json="$(propfind_folder_json_array "${root}/logs" 2>/dev/null || true)"
	backups_json="$(propfind_folder_json_array "${root}/backups" 2>/dev/null || true)"
	[ -n "$logs_json" ] || logs_json=""
	[ -n "$backups_json" ] || backups_json=""
	printf '{"ok":true,"root":"%s","logs":[%s],"backups":[%s]}\n' \
		"$(json_escape "$root")" "$logs_json" "$backups_json"
}

cmd_download() {
	local url
	remote_spec="$1"
	local_path="$2"
	remote_path code

	require_tooling || return 1
	[ -n "$remote_spec" ] && [ -n "$local_path" ] || {
		printf '{"ok":false,"error":"usage","hint":"download <remote> <local>"}\n'
		return 1
	}

	remote_path="$(resolve_remote_path "$remote_spec")" || return 1
	url="$(webdav_url "$remote_path")" || return 1
	case "$local_path" in
		/tmp/*) ;;
		*)
			printf '{"ok":false,"error":"local_path_not_allowed"}\n'
			return 1
			;;
	esac

	mkdir -p "${local_path%/*}" 2>/dev/null || true
	code="$(curl -sS -m 120 -o "$local_path" -w '%{http_code}' -u "$(uci_get login):$(uci_get password)" \
		"$url" 2>/dev/null || printf 000)"
	case "$code" in
		200|201|204)
			printf '{"ok":true,"remote":"%s","local":"%s","bytes":%s}\n' \
				"$(json_escape "$remote_path")" "$(json_escape "$local_path")" "$(wc -c <"$local_path" | tr -d ' ')"
			;;
		*)
			rm -f "$local_path"
			printf '{"ok":false,"error":"download_failed","http":%s}\n' "$code"
			return 1
			;;
	esac
}

latest_backup_name() {
	root="$1"
	propfind_folder_json_array "${root}/backups" 2>/dev/null |
		sed -n 's/.*"name":"\([^"]*\)".*/\1/p' |
		grep '^sheepfold-config-.*\.tar' |
		sort |
		tail -1
}

cmd_restore_config() {
	requested="$1"
	root remote_spec remote_path local_archive safety_backup restore_dir tar_extract_flags=""

	require_tooling || return 1
	root="$(normalize_root_folder)" || return 1
	mkdir -p "$BACKUP_STAGING" 2>/dev/null || true

	if [ -n "$requested" ]; then
		remote_spec="backups/$requested"
	else
		requested="$(latest_backup_name "$root")"
		[ -n "$requested" ] || {
			printf '{"ok":false,"error":"no_backups"}\n'
			return 1
		}
		remote_spec="backups/$requested"
	fi

	remote_path="$(resolve_remote_path "$remote_spec")" || return 1
	local_archive="$BACKUP_STAGING/restore-config-$$.tar.gz"
	cmd_download "$remote_spec" "$local_archive" >/dev/null || return 1

	if tar -tzf "$local_archive" 2>/dev/null | grep -Eq '^sheepfold$'; then
		tar_extract_flags="-xzf"
	elif tar -tf "$local_archive" 2>/dev/null | grep -Eq '^sheepfold$'; then
		tar_extract_flags="-xf"
	else
		rm -f "$local_archive"
		printf '{"ok":false,"error":"invalid_backup_archive"}\n'
		return 1
	fi

	safety_backup="/tmp/sheepfold/sheepfold-config-before-restore-$(date +%Y%m%d-%H%M%S).tar.gz"
	mkdir -p /tmp/sheepfold 2>/dev/null || true
	if command -v gzip >/dev/null 2>&1; then
		tar -C /etc/config -czf "$safety_backup" sheepfold 2>/dev/null || safety_backup=""
	else
		safety_backup="${safety_backup%.gz}"
		tar -C /etc/config -cf "$safety_backup" sheepfold 2>/dev/null || safety_backup=""
	fi

	restore_dir="$BACKUP_STAGING/restore-config-extract-$$"
	mkdir -p "$restore_dir"
	if ! tar -C "$restore_dir" $tar_extract_flags "$local_archive" sheepfold 2>/dev/null; then
		rm -rf "$restore_dir" "$local_archive"
		printf '{"ok":false,"error":"extract_failed"}\n'
		return 1
	fi

	if [ ! -f "$restore_dir/sheepfold" ]; then
		rm -rf "$restore_dir" "$local_archive"
		printf '{"ok":false,"error":"missing_sheepfold_config"}\n'
		return 1
	fi

	cp "$restore_dir/sheepfold" /etc/config/sheepfold
	chmod 600 /etc/config/sheepfold 2>/dev/null || true
	rm -rf "$restore_dir" "$local_archive"

	if [ -x /etc/init.d/sheepfold ]; then
		/etc/init.d/sheepfold restart >/dev/null 2>&1 || true
	fi

	printf '{"ok":true,"restored":"%s","safety_backup":"%s"}\n' \
		"$(json_escape "$requested")" "$(json_escape "${safety_backup:-}")"
}

cmd_status() {
	backend="yandex_disk"
	authorized=0
	state="error"
	message="Yandex Disk is not configured"
	used_mb=0
	quota="$(quota_mb)"
	free_pct=100

	if [ "$(global_get log_storage ram)" != "yandex_disk" ]; then
		message="Yandex Disk is selected only when log storage is set to Yandex Disk"
		printf '{"backend":"%s","state":"%s","message":"%s","authorized":%s,"used_mb":%s,"quota_mb":%s,"free_pct":%s}\n' \
			"$backend" "$state" "$(json_escape "$message")" "$authorized" "$used_mb" "$quota" "$free_pct"
		return 0
	fi

	if ! have_curl; then
		message="curl is required for Yandex Disk on the router"
		printf '{"backend":"%s","state":"%s","message":"%s","authorized":%s,"used_mb":%s,"quota_mb":%s,"free_pct":%s}\n' \
			"$backend" "$state" "$(json_escape "$message")" "$authorized" "$used_mb" "$quota" "$free_pct"
		return 0
	fi

	if ! credentials_ready; then
		message="Enter Yandex Disk login and password"
		printf '{"backend":"%s","state":"%s","message":"%s","authorized":%s,"used_mb":%s,"quota_mb":%s,"free_pct":%s}\n' \
			"$backend" "$state" "$(json_escape "$message")" "$authorized" "$used_mb" "$quota" "$free_pct"
		return 0
	fi

	code="$(webdav_probe 2>/dev/null)" || code=0
	case "$code" in
		207)
			authorized=1
			;;
		401|403)
			message="Yandex Disk authorization failed"
			printf '{"backend":"%s","state":"error","message":"%s","authorized":0,"used_mb":0,"quota_mb":%s,"free_pct":0}\n' \
				"$backend" "$(json_escape "$message")" "$quota"
			return 0
			;;
		*)
			message="Cannot reach Yandex Disk (HTTP $code)"
			printf '{"backend":"%s","state":"error","message":"%s","authorized":0,"used_mb":0,"quota_mb":%s,"free_pct":0}\n' \
				"$backend" "$(json_escape "$message")" "$quota"
			return 0
			;;
	esac

	root="$(normalize_root_folder)" || {
		printf '{"backend":"%s","state":"error","message":"Could not read storage status.","authorized":%s,"used_mb":0,"quota_mb":%s,"free_pct":0}\n' \
			"$backend" "$authorized" "$quota"
		return 0
	}
	if ! used_bytes="$(folder_used_bytes "$root" 2>/dev/null)"; then
		printf '{"backend":"%s","state":"error","message":"Could not read storage status.","authorized":%s,"used_mb":0,"quota_mb":%s,"free_pct":0}\n' \
			"$backend" "$authorized" "$quota"
		return 0
	fi
	case "$used_bytes" in ''|*[!0-9]*)
		printf '{"backend":"%s","state":"error","message":"Could not read storage status.","authorized":%s,"used_mb":0,"quota_mb":%s,"free_pct":0}\n' \
			"$backend" "$authorized" "$quota"
		return 0 ;;
	esac
	used_mb=$((used_bytes / 1024 / 1024))
	quota_bytes=$((quota * 1024 * 1024))
	state_line="$(usage_state "$used_bytes" "$quota_bytes")"
	state="${state_line%%	*}"
	used_pct="${state_line#*	}"
	free_pct=$((100 - used_pct))
	[ "$free_pct" -ge 0 ] || free_pct=0

	case "$state" in
		ok) message="Connected, ${used_mb} MB of ${quota} MB used" ;;
		warn) message="Low space soon, ${used_mb} MB of ${quota} MB used" ;;
		error) message="Sheepfold quota exceeded (${used_mb} MB of ${quota} MB)" ;;
	esac

	# status только сообщает результат. Общий commit захватывал чужой черновик,
	# а отдельный set оставил бы наш флаг в чужой очереди следующего сохранения.

	printf '{"backend":"%s","state":"%s","message":"%s","authorized":%s,"used_mb":%s,"quota_mb":%s,"free_pct":%s}\n' \
		"$backend" "$state" "$(json_escape "$message")" "$authorized" "$used_mb" "$quota" "$free_pct"
}

prune_remote_logs() {
	local url
	root="$1"
	quota_bytes="$2"
	used_bytes="$(folder_used_bytes "$root" 2>/dev/null || printf 0)"
	[ "$used_bytes" -le "$quota_bytes" ] && return 0

	url="$(webdav_url "$root/logs")" || return 1
	response="$(webdav_request PROPFIND "$url" 1)" || return 0
	printf '%s' "$response" | sed -n 's/.*href="\([^"]*\)".*/\1/p' | grep "${root}/logs/" | grep -v '/$' | sort | while IFS= read -r href; do
		[ -n "$href" ] || continue
		# Старый reader не декодирует DAV href. Не удаляем другой файл после
		# двойного кодирования URI; полный проверяемый XML-reader остаётся R15.
		case "$href" in *%*) return 1 ;; esac
		url="$(webdav_url "$href")" || return 1
		curl -sS -m 30 -o /dev/null -u "$(uci_get login):$(uci_get password)" \
			-X DELETE "$url" >/dev/null 2>&1 || true
		used_bytes="$(folder_used_bytes "$root" 2>/dev/null || printf 0)"
		[ "$used_bytes" -le "$quota_bytes" ] && break
	done
}

cmd_push_events() {
	remote_path verify_json

	[ "$(global_get log_storage ram)" = "yandex_disk" ] || return 0
	[ -f "$EVENTS_LOG" ] || return 0
	require_tooling || return 1

	root="$(normalize_root_folder)" || {
		printf '{"ok":false,"error":"root_unavailable"}\n'
		return 1
	}
	ensure_webdav_path "$root" || {
		printf '{"ok":false,"error":"remote_prepare_failed"}\n'
		return 1
	}
	ensure_webdav_path "$root/logs" || {
		printf '{"ok":false,"error":"remote_prepare_failed"}\n'
		return 1
	}

	remote_path="${root}/logs/events.log"
	verify_json="$(upload_and_verify "$EVENTS_LOG" "$remote_path")" || {
		write_sync_status push-events false "upload verify failed"
		printf '%s\n' "$verify_json"
		return 1
	}

	write_sync_status push-events true "events.log uploaded"
	printf '%s\n' "$verify_json"
}

cmd_archive_push() (
	[ "$(global_get log_storage ram)" = "yandex_disk" ] || return 0
	require_tooling || return 1
	# Просмотр больше не записывает authorized. Явная отправка проверяет доступ
	# сейчас, а не полагается на исторический флаг и не сохраняет чужой UCI.
	probeResult="$(cmd_test)" || { printf '%s\n' "$probeResult"; return 1; }

	root="$(normalize_root_folder)" || {
		printf '{"ok":false,"error":"root_unavailable"}\n'
		return 1
	}
	quota_bytes=$(( $(quota_mb) * 1024 * 1024 ))
	# Подготовка всех обязательных локальных копий предшествует MKCOL/PUT и
	# удалению отправленных RAM-архивов. Сбой tar не означает «копия не нужна».
	umask 077
	work="$(yandex_archive_workdir)" || { yandex_archive_prepare_error backup_prepare_failed; return 1; }
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	backup_file="$(create_config_backup "$work")" || {
		yandex_archive_prepare_error backup_prepare_failed
		return 1
	}
	events_copy=''
	if [ -e "$EVENTS_LOG" ] || [ -L "$EVENTS_LOG" ]; then
		[ -f "$EVENTS_LOG" ] && [ ! -L "$EVENTS_LOG" ] || {
			yandex_archive_prepare_error events_snapshot_failed; return 1;
		}
		stamp="$(yandex_archive_stamp)" || { yandex_archive_prepare_error events_snapshot_failed; return 1; }
		events_copy="$work/events-$stamp.log"
		if ! cp "$EVENTS_LOG" "$events_copy" || ! chmod 600 "$events_copy" ||
			! cmp -s "$EVENTS_LOG" "$events_copy"; then
			yandex_archive_prepare_error events_snapshot_failed
			return 1
		fi
	fi
	ensure_webdav_path "$root" || {
		printf '{"ok":false,"error":"remote_prepare_failed"}\n'
		return 1
	}
	ensure_webdav_path "$root/logs" || {
		printf '{"ok":false,"error":"remote_prepare_failed"}\n'
		return 1
	}
	ensure_webdav_path "$root/backups" || {
		printf '{"ok":false,"error":"remote_prepare_failed"}\n'
		return 1
	}

	pushed=0
	errors=0

	for archive in "$RAM_ARCHIVE_DIR"/*.tar.gz "$RAM_ARCHIVE_DIR"/*.tar; do
		[ -f "$archive" ] || continue
		remote="${root}/logs/$(basename "$archive")"
		if upload_and_verify "$archive" "$remote" >/dev/null 2>&1; then
			rm -f "$archive"
			pushed=$((pushed + 1))
		else
			errors=$((errors + 1))
		fi
	done

	if [ -n "$events_copy" ]; then
		remote="${root}/logs/$(basename "$events_copy")"
		if upload_and_verify "$events_copy" "$remote" >/dev/null 2>&1; then
			pushed=$((pushed + 1))
		else
			errors=$((errors + 1))
		fi
	fi

	remote="${root}/backups/$(basename "$backup_file")"
	if upload_and_verify "$backup_file" "$remote" >/dev/null 2>&1; then
		pushed=$((pushed + 1))
	else
		errors=$((errors + 1))
	fi

	prune_remote_logs "$root" "$quota_bytes" || true

	if [ "$errors" -gt 0 ]; then
		write_sync_status archive-push false "completed with errors"
		printf '{"ok":false,"pushed":%d,"errors":%d}\n' "$pushed" "$errors"
		return 1
	fi

	write_sync_status archive-push true "archive push completed"
	printf '{"ok":true,"pushed":%d,"errors":0}\n' "$pushed"
)

cmd_sync_status() {
	if [ -r "$SYNC_STATUS_FILE" ]; then
		cat "$SYNC_STATUS_FILE"
		return 0
	fi
	printf '{"ok":false,"message":"no sync yet"}\n'
}

command_name="${1:-}"
shift || true
case "$command_name" in
	status) cmd_status ;;
	test) cmd_test ;;
	list) cmd_list ;;
	download) cmd_download "$1" "$2" ;;
	restore-config) cmd_restore_config "$1" ;;
	sync-status) cmd_sync_status ;;
	verify) verify_upload "$1" "$2" ;;
	push-events) cmd_push_events ;;
	archive-push) cmd_archive_push ;;
	*)
		echo "Usage: sheepfold-yandex-disk <status|test|list|download|restore-config|sync-status|verify|push-events|archive-push>" >&2
		exit 1
		;;
esac
