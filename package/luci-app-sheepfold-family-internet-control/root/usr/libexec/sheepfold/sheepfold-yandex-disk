#!/bin/sh
# Архивирование журналов и резервных копий настроек в Yandex Disk через WebDAV.
set -eu

WEBDAV_BASE="https://webdav.yandex.ru"
RAM_ARCHIVE_DIR="/tmp/sheepfold/.private/archive"
EVENTS_LOG="/tmp/sheepfold/events.log"
BACKUP_STAGING="/tmp/sheepfold/.yandex-backup-staging"
SYNC_STATUS_FILE="/tmp/sheepfold/.yandex-sync-status.json"

uci_get() {
	uci -q get "sheepfold.cloud.$1" 2>/dev/null || printf '%s' "${2:-}"
}

global_get() {
	uci -q get "sheepfold.global.$1" 2>/dev/null || printf '%s' "${2:-}"
}

json_escape() {
	printf '%s' "$1" | tr '\r\n\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

have_curl() {
	command -v curl >/dev/null 2>&1
}

credentials_ready() {
	# Частичный вывод неуспешного UCI не является реквизитами для сети.
	login="$(uci -q get sheepfold.cloud.login 2>/dev/null)" || return 1
	password="$(uci -q get sheepfold.cloud.password 2>/dev/null)" || return 1
	[ -n "$login" ] && [ -n "$password" ]
}

normalize_root_folder() (
	# Отказ get не означает отсутствия настройки и не разрешает выбрать другое
	# облачное назначение. Сверка замечает изменение между чтениями, не заменяя
	# общую транзакцию UCI. Subshell не меняет переменные вызывающего обработчика.
	snapshot="$(uci -q show sheepfold.cloud 2>/dev/null)" || return 1
	if ! folder="$(uci -q get sheepfold.cloud.root_folder 2>/dev/null)"; then
		case "
$snapshot" in *'
sheepfold.cloud.root_folder='*) return 1 ;; esac
		folder='/sheepfold'
	fi
	current="$(uci -q show sheepfold.cloud 2>/dev/null)" || return 1
	[ "$current" = "$snapshot" ] || return 1
	case "$folder" in
		/*) ;;
		*) folder="/$folder" ;;
	esac
	folder="${folder%/}"
	[ -n "$folder" ] || folder="/sheepfold"
	webdav_url "$folder" >/dev/null || return 1
	printf '%s' "$folder"
)

quota_mb() {
	quota="$(uci_get quota_mb '500')"
	case "$quota" in
		50|100|250|500|1024) printf '%s' "$quota" ;;
		*) printf '500' ;;
	esac
}

# Вход — логический путь из настройки/имени файла, а не уже готовый URI.
# Кодируем байты ровно один раз: «%2F» в имени означает буквальное %2F, не «/».
webdav_url() (
	[ "$#" -eq 1 ] && [ -n "$1" ] || return 1
	path="$1"
	case "$path" in /*) ;; *) path="/$path" ;; esac
	# -g отключает только globbing curl, но не query/fragment, пробелы и «..».
	# Отбрасываем весь вывод отказавшего encoder до возврата URL вызывающему.
	encoded="$(printf '%s\n' "$path" | LC_ALL=C awk '
		BEGIN { for (i = 1; i < 256; i++) codes[sprintf("%c", i)] = i }
		NR != 1 || /[[:cntrl:]]/ { exit 1 }
		{
			count = split($0, parts, "/")
			for (i = 1; i <= count; i++)
				if (parts[i] == "." || parts[i] == "..") exit 1
			result = ""
			for (i = 1; i <= length($0); i++) {
				ch = substr($0, i, 1)
				if (ch ~ /^[A-Za-z0-9_~.\/-]$/) result = result ch
				else {
					if (!(ch in codes)) exit 1
					result = result sprintf("%%%02X", codes[ch])
				}
			}
			printf "%s", result
		}
	')" || return 1
	[ -n "$encoded" ] || return 1
	printf '%s%s' "$WEBDAV_BASE" "$encoded"
)

# Узкий транспорт PROPFIND. Возвращает тело только после успешного curl/207.
# XML-поля и полноту коллекции обязан проверять вызывающий reader отдельно.
webdav_request() (
	[ "$#" -eq 3 ] || return 1
	method="$1"
	url="$2"
	depth="$3"
	[ "$method" = "PROPFIND" ] || return 1
	case "$depth" in 0|1) ;; *) return 1 ;; esac
	credentials_ready || return 1
	# Depth — один аргумент заголовка; прежнее $extra превращало 0/1 в URL.
	# -q первым аргументом исключает скрытый -L из curlrc. TLS не отключается.
	reply="$(curl -q -g -sS -m 45 --proto '=https' -u "$login:$password" \
		-X "$method" -H "Depth: $depth" -w '\n%{http_code}' --url "$url")" || return 1
	separator='
'
	case "$reply" in *"$separator"*) ;; *) return 1 ;; esac
	httpCode="${reply##*"$separator"}"
	[ "$httpCode" = '207' ] || return 1
	printf '%s' "${reply%"$separator"*}"
)

# Это транспортная проба доступа, не проверка всех propstat внутри XML.
# Отказ curl никогда не склеивается с его stdout в JSON-число вроде 000000.
webdav_probe() (
	credentials_ready || return 1
	httpCode="$(curl -q -g -sS -m 30 --proto '=https' -o /dev/null -w '%{http_code}' \
		-u "$login:$password" -X PROPFIND -H 'Depth: 0' --url "$WEBDAV_BASE/")" || return 1
	case "$httpCode" in [1-5][0-9][0-9]) printf '%s' "$httpCode" ;; *) return 1 ;; esac
)

require_tooling() {
	if ! have_curl; then
		printf '{"ok":false,"error":"curl_required"}\n'
		return 1
	fi
	if ! credentials_ready; then
		printf '{"ok":false,"error":"credentials_missing"}\n'
		return 1
	fi
	return 0
}

ensure_webdav_path() (
	[ "$#" -eq 1 ] && [ -n "$1" ] || return 1
	target="$1"
	# Проверяем весь путь до первого MKCOL, а не после создания его предков.
	webdav_url "$target" >/dev/null || return 1
	credentials_ready || return 1
	current=""
	remaining="${target#/}"
	# Не применяем set -- $(...) и IFS='/': имя папки не является файловой
	# маской на роутере. Subshell сохраняет IFS, аргументы и переменные caller.
	while [ -n "$remaining" ]; do
		part="${remaining%%/*}"
		if [ "$part" = "$remaining" ]; then
			remaining=""
		else
			remaining="${remaining#*/}"
		fi
		[ -n "$part" ] || continue
		current="${current}/${part}"
		url="$(webdav_url "$current")" || return 1
		# Проверяем exit отдельно от stdout. Не следуем redirect и не читаем
		# curlrc; MKCOL получает ровно один явный URL с сохранённым TLS.
		code="$(curl -q -g -sS -m 30 --proto '=https' -o /dev/null -w '%{http_code}' \
			-u "$login:$password" -X MKCOL --url "$url")" || return 1
		case "$code" in
			201) ;;
			# Сохраняем повтор для уже существующего URI. Сам по себе 405 не
			# доказывает тип collection: полная проверка DAV XML остаётся R15.
			405) ;;
			*) return 1 ;;
		esac
	done
)

remote_path_allowed() {
	path="$1"
	webdav_url "$path" >/dev/null || return 1
	root="$(normalize_root_folder)" || return 1
	prefix_logs="${root}/logs/"
	prefix_backups="${root}/backups/"

	case "$path" in
		"${prefix_logs}"*) ;;
		"${prefix_backups}"*) ;;
		*) return 1 ;;
	esac
	case "$path" in
		*..*) return 1 ;;
	esac
	return 0
}

resolve_remote_path() {
	spec="$1"
	root="$(normalize_root_folder)" || return 1
	case "$spec" in
		/*)
			remote_path="$spec"
			;;
		logs/*)
			remote_path="${root}/${spec}"
			;;
		backups/*)
			remote_path="${root}/${spec}"
			;;
		*)
			remote_path="${root}/backups/${spec}"
			;;
	esac

	if ! remote_path_allowed "$remote_path"; then
		printf '{"ok":false,"error":"path_not_allowed"}\n'
		return 1
	fi
	printf '%s' "$remote_path"
}

folder_used_bytes() {
	local url
	root="$1"
	url="$(webdav_url "$root")" || return 1
	response="$(webdav_request PROPFIND "$url" 1)" || return 1
	printf '%s' "$response" | awk '
		BEGIN { total = 0 }
		/<[^>]*getcontentlength[^>]*>[0-9]+/ {
			line = $0
			sub(/.*<[^>]*getcontentlength[^>]*>/, "", line)
			sub(/<.*/, "", line)
			if (line ~ /^[0-9]+$/) total += line
		}
		END { print total + 0 }
	'
}

# Проверяем размер одного объекта через HEAD, не регулярным выражением по DAV XML.
# Сервер вправе не вернуть Content-Length: тогда подтверждения нет, а не «ноль».
yandex_transfer_workdir() (
	umask 077
	[ ! -L /tmp/sheepfold ] || exit 1
	mkdir -p /tmp/sheepfold || exit 1
	chmod 700 /tmp/sheepfold || exit 1
	work="$(mktemp -d /tmp/sheepfold/.yandex-transfer.XXXXXX)" || exit 1
	chmod 700 "$work" || { rm -rf "$work"; exit 1; }
	printf '%s' "$work"
)

yandex_file_bytes() (
	[ "$#" -eq 1 ] && [ -f "$1" ] && [ ! -L "$1" ] || exit 1
	# Exit wc проверяется до нормализации; его частичный stdout не есть размер.
	bytes="$(LC_ALL=C wc -c <"$1")" || exit 1
	printf '%s\n' "$bytes" | LC_ALL=C awk '
		NR != 1 { bad = 1; exit 1 }
		{ sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "")
		  if ($0 !~ /^[0-9]+$/) { bad = 1; exit 1 }
		  sub(/^0+/, ""); if ($0 == "") $0 = "0"
		  if (length($0) > 18) { bad = 1; exit 1 }; value = $0 }
		END { if (bad || NR != 1) exit 1; printf "%s", value }
	'
)

# Ограниченная сверка одного PUT/HEAD-прохода. Это не блокировка UCI и не
# снимок всей архивной команды; она не разрешает смешивать замеченные настройки.
yandex_transfer_settings_ok() (
	[ "${transferPinned:-0}" = 1 ] || exit 0
	current="$(uci -q show sheepfold.cloud 2>/dev/null)" || exit 1
	[ "$current" = "$transferSettings" ]
)

remote_file_bytes() (
	[ "$#" -eq 1 ] && [ -n "$1" ] || exit 1
	url="$(webdav_url "$1")" || exit 1
	credentials_ready || exit 1
	yandex_transfer_settings_ok || exit 1
	work="$(yandex_transfer_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	umask 077
	# HTTP/1.1 даёт один известный формат status line. Промежуточные proxy/auth
	# блоки не становятся метаданными: reader принимает только последний блок.
	code="$(curl -q -g -sS -m 45 --proto '=https' --http1.1 --head \
		-H 'Accept-Encoding: identity' -H 'Cache-Control: no-cache' \
		-D "$work/headers" -o /dev/null -w '%{http_code}' \
		-u "$login:$password" --url "$url")" || exit 1
	[ "$code" = 200 ] || exit 1
	yandex_transfer_settings_ok || exit 1
	headerBytes="$(yandex_file_bytes "$work/headers")" || exit 1
	[ "${#headerBytes}" -le 5 ] && [ "$headerBytes" -le 65536 ] || exit 1
	LC_ALL=C awk '
		function fail() { bad = 1; exit 1 }
		{ sub(/\r$/, "") }
		/^HTTP\/1\.[01] [1-5][0-9][0-9]( |$)/ {
			if (seen && !closed) fail()
			split($0, parts, " "); status = parts[2]; seen = 1; closed = 0
			lengths = 0; size = ""; incompatible = 0; next
		}
		!seen || closed { fail() }
		/^$/ { closed = 1; next }
		/^[ \t]/ { fail() }
		{
			line = $0; gsub(/\t/, "", line)
			if (line ~ /[[:cntrl:]]/ || $0 !~ /^[^:[:space:]]+:/) fail()
			key = $0; sub(/:.*/, "", key); key = tolower(key)
			value = $0; sub(/^[^:]+:/, "", value)
			sub(/^[ \t]+/, "", value); sub(/[ \t]+$/, "", value)
			if (key == "content-length") {
				lengths++; if (value !~ /^[0-9]+$/) fail()
				sub(/^0+/, "", value); if (value == "") value = "0"
				if (length(value) > 18) fail(); size = value
			}
			if (key == "transfer-encoding" || key == "content-range" ||
			    (key == "content-encoding" && tolower(value) != "identity")) incompatible = 1
		}
		END {
			if (bad || !seen || !closed || status != "200" || lengths != 1 || incompatible) exit 1
			printf "%s", size
		}
	' "$work/headers"
)

usage_state() {
	used_bytes="$1"
	quota_bytes="$2"
	[ "$quota_bytes" -gt 0 ] || { printf 'error\t0\n'; return; }
	pct=$((used_bytes * 100 / quota_bytes))
	if [ "$used_bytes" -ge "$quota_bytes" ]; then
		printf 'error\t%s\n' "$pct"
	elif [ "$pct" -ge 80 ]; then
		printf 'warn\t%s\n' "$pct"
	else
		printf 'ok\t%s\n' "$pct"
	fi
}

# Статус — результат последнего завершённого прохода, не журнал всех попыток.
# Изолируем переменные и публикуем один готовый файл: reader не видит половину JSON.
yandex_sync_path_ok() {
	[ ! -L /tmp/sheepfold ] && [ -d /tmp/sheepfold ] || return 1
	[ ! -L "$SYNC_STATUS_FILE" ] || return 1
	[ ! -e "$SYNC_STATUS_FILE" ] || [ -f "$SYNC_STATUS_FILE" ]
}

yandex_sync_quote() {
	# Только представление строки: управляющие байты не удаляются и не становятся
	# пробелами. Общий legacy serializer вне sync-status этим не объявлен исправным.
	printf '%s\n' "$1" | LC_ALL=C awk '
		BEGIN { for (i = 1; i < 32; i++) esc[sprintf("%c", i)] = sprintf("\\u%04x", i) }
		{
			if (NR > 1) printf "\\n"
			for (i = 1; i <= length($0); i++) {
				c = substr($0, i, 1)
				if (c == "\\") printf "\\\\"
				else if (c == "\"") printf "\\\""
				else if (c in esc) printf "%s", esc[c]
				else printf "%s", c
			}
		}'
}

yandex_sync_json() (
	[ "$#" -eq 4 ] || exit 1
	case "$1" in push-events|archive-push) ;; *) exit 1 ;; esac
	case "$2" in true|false) ;; *) exit 1 ;; esac
	LC_ALL=C; export LC_ALL
	[ "${#3}" -le 1024 ] || exit 1
	case "$4" in
		[0-9][0-9][0-9][0-9]-[01][0-9]-[0-3][0-9]T[0-2][0-9]:[0-5][0-9]:[0-6][0-9][+-][0-2][0-9][0-5][0-9]) ;;
		*) exit 1 ;;
	esac
	messageJson="$(yandex_sync_quote "$3")" || exit 1
	printf '{"command":"%s","ok":%s,"message":"%s","at":"%s"}\n' "$1" "$2" "$messageJson" "$4"
)

write_sync_status() (
	[ "$#" -eq 3 ] || exit 1
	stamp="$(date '+%Y-%m-%dT%H:%M:%S%z')" || exit 1
	payload="$(yandex_sync_json "$1" "$2" "$3" "$stamp")" || exit 1
	umask 077
	[ ! -L /tmp/sheepfold ] || exit 1
	mkdir -p /tmp/sheepfold || exit 1
	chmod 700 /tmp/sheepfold || exit 1
	yandex_sync_path_ok || exit 1
	work="$(mktemp -d /tmp/sheepfold/.yandex-sync.XXXXXX)" || exit 1
	# Неудачный mktemp не даёт права удалять напечатанный им чужой каталог.
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	chmod 700 "$work" || exit 1
	printf '%s\n' "$payload" >"$work/status.json" || exit 1
	chmod 600 "$work/status.json" || exit 1
	yandex_sync_path_ok || exit 1
	mv -f "$work/status.json" "$SYNC_STATUS_FILE" || exit 1
)

# trap охватывает и ранние отказы tooling/root/MKCOL, не меняя set -e внутри
# основной команды. Служебная запись не отменяет уже выполненный PUT или его JSON.
yandex_sync_finish() {
	local result="$1" action="$2" skipped="${3:-0}" ok message
	trap - EXIT
	[ "$skipped" -ne 1 ] || exit 0
	case "$action:$result" in push-events:4) exit 0 ;; esac
	ok=false
	message='completed with errors'
	if [ "$result" -eq 0 ]; then
		ok=true
		case "$action" in push-events) message='events.log uploaded' ;; *) message='archive push completed' ;; esac
	fi
	if ! write_sync_status "$action" "$ok" "$message" >/dev/null; then
		printf '%s\n' 'Sheepfold: Yandex sync status could not be saved; operation result is unchanged.' >&2
	fi
	exit "$result"
}

yandex_sync_run() (
	action="$1"
	skipped=0
	trap 'yandex_sync_finish "$?" "$action" "$skipped"' EXIT
	trap 'exit 1' HUP INT TERM
	# Неуспешное get не является выбором другого backend. Отсутствующая опция
	# допустима только после подтверждения show; частичный вывод отбрасывается.
	if ! backend="$(uci -q get sheepfold.global.log_storage 2>/dev/null)"; then
		settings="$(uci -q show sheepfold.global 2>/dev/null)" || {
			yandex_transfer_error storage_unavailable; exit 1;
		}
		case "
$settings" in *'
sheepfold.global.log_storage='*) yandex_transfer_error storage_unavailable; exit 1 ;; esac
		backend=ram
	fi
	[ "$backend" = yandex_disk ] || { skipped=1; exit 0; }
	"$2"
)

yandex_transfer_error() {
	printf '{"ok":false,"error":"%s"}\n' "$1"
	return 1
}

verify_upload() (
	[ "$#" -eq 2 ] && [ -n "$1" ] && [ -n "$2" ] || {
		yandex_transfer_error usage; exit 1;
	}
	local_path="$1"
	remote_path="$2"
	local_bytes="$(yandex_file_bytes "$local_path")" || {
		yandex_transfer_error local_read_failed; exit 1;
	}
	remote_bytes="$(remote_file_bytes "$remote_path")" || {
		yandex_transfer_error remote_metadata_unavailable; exit 1;
	}
	# Строковое сравнение нормализованных чисел не переполняет shell на 32 bit.
	# Пустой файл допустим, но лишь при подтверждённом remote Content-Length: 0.
	if [ "$local_bytes" = "$remote_bytes" ]; then
		printf '{"ok":true,"local_bytes":%s,"remote_bytes":%s}\n' "$local_bytes" "$remote_bytes"
		return 0
	fi
	printf '{"ok":false,"error":"size_mismatch","local_bytes":%s,"remote_bytes":%s}\n' \
		"$local_bytes" "$remote_bytes"
	return 1
)

upload_file() (
	[ "$#" -eq 2 ] && [ -f "$1" ] && [ ! -L "$1" ] || exit 1
	local_path="$1"
	url="$(webdav_url "$2")" || exit 1
	credentials_ready || exit 1
	yandex_transfer_settings_ok || exit 1
	# Один URL, без curlrc, URL glob и redirect. Частичный вывод отказавшего
	# curl не подменяет успешный PUT и не попадает в JSON как число HTTP.
	code="$(curl -q -g -sS -m 120 --proto '=https' -o /dev/null -w '%{http_code}' \
		-T "$local_path" -u "$login:$password" --url "$url")" || exit 1
	yandex_transfer_settings_ok || exit 1
	case "$code" in 200|201|204) printf '%s' "$code" ;; *) exit 1 ;; esac
)

upload_and_verify() (
	[ "$#" -eq 2 ] && [ -n "$1" ] && [ -n "$2" ] || {
		yandex_transfer_error usage; exit 1;
	}
	local_path="$1"
	remote_path="$2"
	[ -f "$local_path" ] && [ ! -L "$local_path" ] || {
		yandex_transfer_error local_missing; exit 1;
	}
	webdav_url "$remote_path" >/dev/null || { yandex_transfer_error path_not_allowed; exit 1; }
	transferSettings="$(uci -q show sheepfold.cloud 2>/dev/null)" || {
		yandex_transfer_error settings_unavailable; exit 1;
	}
	transferPinned=1
	# Архив удаляется caller после успеха. Отправляем неизменяемую копию и
	# не подтверждаем удаление, если источник изменился во время HTTP.
	work="$(yandex_transfer_workdir)" || { yandex_transfer_error snapshot_failed; exit 1; }
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	umask 077
	if ! cp "$local_path" "$work/source" || ! chmod 600 "$work/source" ||
		! cmp -s "$local_path" "$work/source"; then
		yandex_transfer_error snapshot_failed; exit 1
	fi
	yandex_file_bytes "$work/source" >/dev/null || { yandex_transfer_error snapshot_failed; exit 1; }
	if ! upload_file "$work/source" "$remote_path" >/dev/null; then
		yandex_transfer_error upload_failed; exit 1
	fi
	if verify_json="$(verify_upload "$work/source" "$remote_path")"; then
		:
	else
		[ -n "$verify_json" ] || verify_json='{"ok":false,"error":"remote_metadata_unavailable"}'
		printf '%s\n' "$verify_json"; exit 1
	fi
	if [ -L "$local_path" ] || [ ! -f "$local_path" ] || ! cmp -s "$local_path" "$work/source"; then
		yandex_transfer_error source_changed; exit 1
	fi
	yandex_transfer_settings_ok || { yandex_transfer_error settings_changed; exit 1; }
	printf '%s\n' "$verify_json"
)

# Имя до секунды остаётся внешним именем копии, но не определяет владельца
# локального файла. Каждый архивный проход получает собственный RAM-каталог.
yandex_archive_workdir() (
	umask 077
	[ ! -L /tmp/sheepfold ] || exit 1
	mkdir -p /tmp/sheepfold || exit 1
	chmod 700 /tmp/sheepfold || exit 1
	work="$(mktemp -d /tmp/sheepfold/.yandex-archive.XXXXXX)" || exit 1
	# Не удаляем частичный stdout отказавшего mktemp: это может быть чужой путь.
	chmod 700 "$work" || { rm -rf "$work"; exit 1; }
	printf '%s' "$work"
)

yandex_archive_stamp() (
	stamp="$(date +%Y%m%d-%H%M%S)" || exit 1
	case "$stamp" in
		[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]) ;;
		*) exit 1 ;;
	esac
	printf '%s' "$stamp"
)

create_config_backup() (
	work="${1:-}"
	[ -n "$work" ] && [ -d "$work" ] && [ ! -L "$work" ] || exit 1
	umask 077
	[ -f /etc/config/sheepfold ] && [ ! -L /etc/config/sheepfold ] || exit 1
	mkdir "$work/config-source" || exit 1
	cp -p /etc/config/sheepfold "$work/config-source/sheepfold" || exit 1
	chmod 600 "$work/config-source/sheepfold" || exit 1
	cmp -s /etc/config/sheepfold "$work/config-source/sheepfold" || exit 1
	stamp="$(yandex_archive_stamp)" || exit 1
	backup_file="$work/sheepfold-config-$stamp.tar.gz"
	if command -v gzip >/dev/null 2>&1; then
		tar -C "$work/config-source" -czf "$backup_file" sheepfold || exit 1
		list_flags=-tzf
		read_flags=-xzOf
	else
		backup_file="${backup_file%.gz}"
		tar -C "$work/config-source" -cf "$backup_file" sheepfold || exit 1
		list_flags=-tf
		read_flags=-xOf
	fi
	chmod 600 "$backup_file" || exit 1
	# Проверяем свой архив до отправки, не включаем восстановление. Читаем в
	# stdout: пути/права из архива не применяются к /etc/config или файловой системе.
	members="$(tar "$list_flags" "$backup_file")" || exit 1
	[ "$members" = sheepfold ] || exit 1
	tar "$read_flags" "$backup_file" sheepfold >"$work/config-verified" || exit 1
	cmp -s "$work/config-source/sheepfold" "$work/config-verified" || exit 1
	[ ! -L /etc/config/sheepfold ] || exit 1
	cmp -s /etc/config/sheepfold "$work/config-source/sheepfold" || exit 1
	printf '%s' "$backup_file"
)

yandex_archive_prepare_error() {
	printf '{"ok":false,"error":"%s","pushed":0,"errors":1}\n' "$1"
	return 1
}

propfind_folder_json_array() {
	local url
	folder="$1"
	url="$(webdav_url "$folder")" || return 1
	response="$(webdav_request PROPFIND "$url" 1)" || return 1
	printf '%s' "$response" | awk -v folder="$folder" '
		function json_escape(value,    chars) {
			gsub(/\\/, "\\\\", value)
			gsub(/"/, "\\\"", value)
			return value
		}
		function flush(    name, esc_name, esc_modified) {
			if (href == "" || href == folder || href == folder "/") {
				href = ""
				size = 0
				modified = ""
				return
			}
			name = href
			sub(/^.*\//, "", name)
			if (name == "") {
				href = ""
				size = 0
				modified = ""
				return
			}
			esc_name = json_escape(name)
			esc_modified = json_escape(modified)
			if (items != "") items = items ","
			items = items sprintf("{\"name\":\"%s\",\"path\":\"%s\",\"bytes\":%s,\"modified\":\"%s\"}",
				esc_name, json_escape(href), (size == "" ? 0 : size), esc_modified)
			href = ""
			size = 0
			modified = ""
		}
		BEGIN {
			items = ""
			href = ""
			size = 0
			modified = ""
		}
		/<[dD]:href>/ {
			flush()
			line = $0
			sub(/.*<[dD]:href>/, "", line)
			sub(/<.*/, "", line)
			gsub(/%20/, " ", line)
			href = line
		}
		/getcontentlength/ {
			line = $0
			sub(/.*getcontentlength>/, "", line)
			sub(/<.*/, "", line)
			size = line
		}
		/getlastmodified/ {
			line = $0
			sub(/.*getlastmodified>/, "", line)
			sub(/<.*/, "", line)
			modified = line
		}
		END {
			flush()
			printf "%s", items
		}
	'
}

cmd_test() {
	require_tooling || return 1

	code="$(webdav_probe 2>/dev/null)" || code=0
	case "$code" in
		207)
			printf '{"ok":true,"message":"Yandex Disk login works"}\n'
			;;
		401|403)
			printf '{"ok":false,"error":"auth_failed","http":%s}\n' "$code"
			return 1
			;;
		*)
			printf '{"ok":false,"error":"unreachable","http":%s}\n' "$code"
			return 1
			;;
	esac
}

cmd_list() {
	root logs_json backups_json

	require_tooling || return 1
	root="$(normalize_root_folder)" || return 1
	logs_json="$(propfind_folder_json_array "${root}/logs" 2>/dev/null || true)"
	backups_json="$(propfind_folder_json_array "${root}/backups" 2>/dev/null || true)"
	[ -n "$logs_json" ] || logs_json=""
	[ -n "$backups_json" ] || backups_json=""
	printf '{"ok":true,"root":"%s","logs":[%s],"backups":[%s]}\n' \
		"$(json_escape "$root")" "$logs_json" "$backups_json"
}

cmd_download() {
	local url
	remote_spec="$1"
	local_path="$2"
	remote_path code

	require_tooling || return 1
	[ -n "$remote_spec" ] && [ -n "$local_path" ] || {
		printf '{"ok":false,"error":"usage","hint":"download <remote> <local>"}\n'
		return 1
	}

	remote_path="$(resolve_remote_path "$remote_spec")" || return 1
	url="$(webdav_url "$remote_path")" || return 1
	case "$local_path" in
		/tmp/*) ;;
		*)
			printf '{"ok":false,"error":"local_path_not_allowed"}\n'
			return 1
			;;
	esac

	mkdir -p "${local_path%/*}" 2>/dev/null || true
	code="$(curl -sS -m 120 -o "$local_path" -w '%{http_code}' -u "$(uci_get login):$(uci_get password)" \
		"$url" 2>/dev/null || printf 000)"
	case "$code" in
		200|201|204)
			printf '{"ok":true,"remote":"%s","local":"%s","bytes":%s}\n' \
				"$(json_escape "$remote_path")" "$(json_escape "$local_path")" "$(wc -c <"$local_path" | tr -d ' ')"
			;;
		*)
			rm -f "$local_path"
			printf '{"ok":false,"error":"download_failed","http":%s}\n' "$code"
			return 1
			;;
	esac
}

latest_backup_name() {
	root="$1"
	propfind_folder_json_array "${root}/backups" 2>/dev/null |
		sed -n 's/.*"name":"\([^"]*\)".*/\1/p' |
		grep '^sheepfold-config-.*\.tar' |
		sort |
		tail -1
}

cmd_restore_config() {
	requested="$1"
	root remote_spec remote_path local_archive safety_backup restore_dir tar_extract_flags=""

	require_tooling || return 1
	root="$(normalize_root_folder)" || return 1
	mkdir -p "$BACKUP_STAGING" 2>/dev/null || true

	if [ -n "$requested" ]; then
		remote_spec="backups/$requested"
	else
		requested="$(latest_backup_name "$root")"
		[ -n "$requested" ] || {
			printf '{"ok":false,"error":"no_backups"}\n'
			return 1
		}
		remote_spec="backups/$requested"
	fi

	remote_path="$(resolve_remote_path "$remote_spec")" || return 1
	local_archive="$BACKUP_STAGING/restore-config-$$.tar.gz"
	cmd_download "$remote_spec" "$local_archive" >/dev/null || return 1

	if tar -tzf "$local_archive" 2>/dev/null | grep -Eq '^sheepfold$'; then
		tar_extract_flags="-xzf"
	elif tar -tf "$local_archive" 2>/dev/null | grep -Eq '^sheepfold$'; then
		tar_extract_flags="-xf"
	else
		rm -f "$local_archive"
		printf '{"ok":false,"error":"invalid_backup_archive"}\n'
		return 1
	fi

	safety_backup="/tmp/sheepfold/sheepfold-config-before-restore-$(date +%Y%m%d-%H%M%S).tar.gz"
	mkdir -p /tmp/sheepfold 2>/dev/null || true
	if command -v gzip >/dev/null 2>&1; then
		tar -C /etc/config -czf "$safety_backup" sheepfold 2>/dev/null || safety_backup=""
	else
		safety_backup="${safety_backup%.gz}"
		tar -C /etc/config -cf "$safety_backup" sheepfold 2>/dev/null || safety_backup=""
	fi

	restore_dir="$BACKUP_STAGING/restore-config-extract-$$"
	mkdir -p "$restore_dir"
	if ! tar -C "$restore_dir" $tar_extract_flags "$local_archive" sheepfold 2>/dev/null; then
		rm -rf "$restore_dir" "$local_archive"
		printf '{"ok":false,"error":"extract_failed"}\n'
		return 1
	fi

	if [ ! -f "$restore_dir/sheepfold" ]; then
		rm -rf "$restore_dir" "$local_archive"
		printf '{"ok":false,"error":"missing_sheepfold_config"}\n'
		return 1
	fi

	cp "$restore_dir/sheepfold" /etc/config/sheepfold
	chmod 600 /etc/config/sheepfold 2>/dev/null || true
	rm -rf "$restore_dir" "$local_archive"

	if [ -x /etc/init.d/sheepfold ]; then
		/etc/init.d/sheepfold restart >/dev/null 2>&1 || true
	fi

	printf '{"ok":true,"restored":"%s","safety_backup":"%s"}\n' \
		"$(json_escape "$requested")" "$(json_escape "${safety_backup:-}")"
}

cmd_status() {
	backend="yandex_disk"
	authorized=0
	state="error"
	message="Yandex Disk is not configured"
	used_mb=0
	quota="$(quota_mb)"
	free_pct=100

	if [ "$(global_get log_storage ram)" != "yandex_disk" ]; then
		message="Yandex Disk is selected only when log storage is set to Yandex Disk"
		printf '{"backend":"%s","state":"%s","message":"%s","authorized":%s,"used_mb":%s,"quota_mb":%s,"free_pct":%s}\n' \
			"$backend" "$state" "$(json_escape "$message")" "$authorized" "$used_mb" "$quota" "$free_pct"
		return 0
	fi

	if ! have_curl; then
		message="curl is required for Yandex Disk on the router"
		printf '{"backend":"%s","state":"%s","message":"%s","authorized":%s,"used_mb":%s,"quota_mb":%s,"free_pct":%s}\n' \
			"$backend" "$state" "$(json_escape "$message")" "$authorized" "$used_mb" "$quota" "$free_pct"
		return 0
	fi

	if ! credentials_ready; then
		message="Enter Yandex Disk login and password"
		printf '{"backend":"%s","state":"%s","message":"%s","authorized":%s,"used_mb":%s,"quota_mb":%s,"free_pct":%s}\n' \
			"$backend" "$state" "$(json_escape "$message")" "$authorized" "$used_mb" "$quota" "$free_pct"
		return 0
	fi

	code="$(webdav_probe 2>/dev/null)" || code=0
	case "$code" in
		207)
			authorized=1
			;;
		401|403)
			message="Yandex Disk authorization failed"
			printf '{"backend":"%s","state":"error","message":"%s","authorized":0,"used_mb":0,"quota_mb":%s,"free_pct":0}\n' \
				"$backend" "$(json_escape "$message")" "$quota"
			return 0
			;;
		*)
			message="Cannot reach Yandex Disk (HTTP $code)"
			printf '{"backend":"%s","state":"error","message":"%s","authorized":0,"used_mb":0,"quota_mb":%s,"free_pct":0}\n' \
				"$backend" "$(json_escape "$message")" "$quota"
			return 0
			;;
	esac

	root="$(normalize_root_folder)" || {
		printf '{"backend":"%s","state":"error","message":"Could not read storage status.","authorized":%s,"used_mb":0,"quota_mb":%s,"free_pct":0}\n' \
			"$backend" "$authorized" "$quota"
		return 0
	}
	if ! used_bytes="$(folder_used_bytes "$root" 2>/dev/null)"; then
		printf '{"backend":"%s","state":"error","message":"Could not read storage status.","authorized":%s,"used_mb":0,"quota_mb":%s,"free_pct":0}\n' \
			"$backend" "$authorized" "$quota"
		return 0
	fi
	case "$used_bytes" in ''|*[!0-9]*)
		printf '{"backend":"%s","state":"error","message":"Could not read storage status.","authorized":%s,"used_mb":0,"quota_mb":%s,"free_pct":0}\n' \
			"$backend" "$authorized" "$quota"
		return 0 ;;
	esac
	used_mb=$((used_bytes / 1024 / 1024))
	quota_bytes=$((quota * 1024 * 1024))
	state_line="$(usage_state "$used_bytes" "$quota_bytes")"
	state="${state_line%%	*}"
	used_pct="${state_line#*	}"
	free_pct=$((100 - used_pct))
	[ "$free_pct" -ge 0 ] || free_pct=0

	case "$state" in
		ok) message="Connected, ${used_mb} MB of ${quota} MB used" ;;
		warn) message="Low space soon, ${used_mb} MB of ${quota} MB used" ;;
		error) message="Sheepfold quota exceeded (${used_mb} MB of ${quota} MB)" ;;
	esac

	# status только сообщает результат. Общий commit захватывал чужой черновик,
	# а отдельный set оставил бы наш флаг в чужой очереди следующего сохранения.

	printf '{"backend":"%s","state":"%s","message":"%s","authorized":%s,"used_mb":%s,"quota_mb":%s,"free_pct":%s}\n' \
		"$backend" "$state" "$(json_escape "$message")" "$authorized" "$used_mb" "$quota" "$free_pct"
}

prune_remote_logs() {
	local url
	root="$1"
	quota_bytes="$2"
	used_bytes="$(folder_used_bytes "$root" 2>/dev/null || printf 0)"
	[ "$used_bytes" -le "$quota_bytes" ] && return 0

	url="$(webdav_url "$root/logs")" || return 1
	response="$(webdav_request PROPFIND "$url" 1)" || return 0
	printf '%s' "$response" | sed -n 's/.*href="\([^"]*\)".*/\1/p' | grep "${root}/logs/" | grep -v '/$' | sort | while IFS= read -r href; do
		[ -n "$href" ] || continue
		# Старый reader не декодирует DAV href. Не удаляем другой файл после
		# двойного кодирования URI; полный проверяемый XML-reader остаётся R15.
		case "$href" in *%*) return 1 ;; esac
		url="$(webdav_url "$href")" || return 1
		curl -sS -m 30 -o /dev/null -u "$(uci_get login):$(uci_get password)" \
			-X DELETE "$url" >/dev/null 2>&1 || true
		used_bytes="$(folder_used_bytes "$root" 2>/dev/null || printf 0)"
		[ "$used_bytes" -le "$quota_bytes" ] && break
	done
}

# Код 4 — подтверждённое отсутствие выбранного журнала; ошибка UCI/чтения
# не разрешает отправить старый events.log. Общий lock держим только для снимка,
# чтобы медленная сеть не останавливала запись, чтение и ротацию событий.
yandex_events_snapshot() (
	[ "$#" -eq 1 ] && [ -n "$1" ] || exit 1
	destination="$1"
	umask 077
	logCommon="${0%/*}/sheepfold-log-common"
	[ -r "$logCommon" ] || logCommon=/usr/libexec/sheepfold/sheepfold-log-common
	lockCommon="${0%/*}/sheepfold-lock-common"
	[ -r "$lockCommon" ] || lockCommon=/usr/libexec/sheepfold/sheepfold-lock-common
	. "$logCommon" || exit 1
	. "$lockCommon" || exit 1
	logFile="$(sheepfold_log_path_read uci "$EVENTS_LOG")" || exit 1
	sheepfold_log_path_check "$logFile" allow-missing || exit 1
	sheepfold_lock_acquire "${SHEEPFOLD_LOG_LOCK:-/tmp/sheepfold/log-maintenance.flock}" 5 || exit 1
	trap 'sheepfold_lock_release' EXIT
	trap 'exit 1' HUP INT TERM
	# После ожидания lock заново выбираем путь: writer мог уже перейти на новый.
	logFile="$(sheepfold_log_path_read uci "$EVENTS_LOG")" || exit 1
	sheepfold_log_path_check "$logFile" allow-missing || exit 1
	[ -f "$logFile" ] || exit 4
	cp "$logFile" "$destination" || exit 1
	chmod 600 "$destination" || exit 1
	cmp -s "$logFile" "$destination" || exit 1
	currentPath="$(sheepfold_log_path_read uci "$EVENTS_LOG")" || exit 1
	[ "$currentPath" = "$logFile" ] || exit 1
	sheepfold_log_path_check "$logFile" || exit 1
)

cmd_push_events() (
	umask 077
	work="$(yandex_archive_workdir)" || {
		printf '{"ok":false,"error":"events_snapshot_failed"}\n'
		return 1
	}
	trap 'result=$?; trap - EXIT; rm -rf "$work" || printf "Sheepfold: Yandex work cleanup failed.\n" >&2; exit "$result"' EXIT
	trap 'exit 1' HUP INT TERM
	snapshotStatus=0
	yandex_events_snapshot "$work/events.log" || snapshotStatus=$?
	case "$snapshotStatus" in
		0) ;;
		4) return 4 ;;
		*)
			printf '{"ok":false,"error":"events_snapshot_failed"}\n'
			return 1 ;;
	esac
	require_tooling || return 1

	root="$(normalize_root_folder)" || {
		printf '{"ok":false,"error":"root_unavailable"}\n'
		return 1
	}
	ensure_webdav_path "$root" || {
		printf '{"ok":false,"error":"remote_prepare_failed"}\n'
		return 1
	}
	ensure_webdav_path "$root/logs" || {
		printf '{"ok":false,"error":"remote_prepare_failed"}\n'
		return 1
	}

	remote_path="${root}/logs/events.log"
	# Uploader сравнивает именно снимок. Новое событие в живом журнале не
	# отменяет уже подтверждённую копию и остаётся для следующей отправки.
	verify_json="$(upload_and_verify "$work/events.log" "$remote_path")" || {
		printf '%s\n' "$verify_json"
		return 1
	}

	printf '%s\n' "$verify_json"
)

cmd_archive_push() (
	require_tooling || return 1
	# Просмотр больше не записывает authorized. Явная отправка проверяет доступ
	# сейчас, а не полагается на исторический флаг и не сохраняет чужой UCI.
	probeResult="$(cmd_test)" || { printf '%s\n' "$probeResult"; return 1; }

	root="$(normalize_root_folder)" || {
		printf '{"ok":false,"error":"root_unavailable"}\n'
		return 1
	}
	quota_bytes=$(( $(quota_mb) * 1024 * 1024 ))
	# Подготовка всех обязательных локальных копий предшествует MKCOL/PUT и
	# удалению отправленных RAM-архивов. Сбой tar не означает «копия не нужна».
	umask 077
	work="$(yandex_archive_workdir)" || { yandex_archive_prepare_error backup_prepare_failed; return 1; }
	trap 'result=$?; trap - EXIT; rm -rf "$work" || printf "Sheepfold: Yandex work cleanup failed.\n" >&2; exit "$result"' EXIT
	trap 'exit 1' HUP INT TERM
	backup_file="$(create_config_backup "$work")" || {
		yandex_archive_prepare_error backup_prepare_failed
		return 1
	}
	stamp="$(yandex_archive_stamp)" || { yandex_archive_prepare_error events_snapshot_failed; return 1; }
	events_copy="$work/events-$stamp.log"
	snapshotStatus=0
	yandex_events_snapshot "$events_copy" || snapshotStatus=$?
	case "$snapshotStatus" in
		0) ;;
		4) events_copy='' ;;
		*) yandex_archive_prepare_error events_snapshot_failed; return 1 ;;
	esac
	ensure_webdav_path "$root" || {
		printf '{"ok":false,"error":"remote_prepare_failed"}\n'
		return 1
	}
	ensure_webdav_path "$root/logs" || {
		printf '{"ok":false,"error":"remote_prepare_failed"}\n'
		return 1
	}
	ensure_webdav_path "$root/backups" || {
		printf '{"ok":false,"error":"remote_prepare_failed"}\n'
		return 1
	}

	pushed=0
	errors=0

	for archive in "$RAM_ARCHIVE_DIR"/*.tar.gz "$RAM_ARCHIVE_DIR"/*.tar; do
		[ -f "$archive" ] || continue
		remote="${root}/logs/$(basename "$archive")"
		if upload_and_verify "$archive" "$remote" >/dev/null 2>&1; then
			rm -f "$archive"
			pushed=$((pushed + 1))
		else
			errors=$((errors + 1))
		fi
	done

	if [ -n "$events_copy" ]; then
		remote="${root}/logs/$(basename "$events_copy")"
		if upload_and_verify "$events_copy" "$remote" >/dev/null 2>&1; then
			pushed=$((pushed + 1))
		else
			errors=$((errors + 1))
		fi
	fi

	remote="${root}/backups/$(basename "$backup_file")"
	if upload_and_verify "$backup_file" "$remote" >/dev/null 2>&1; then
		pushed=$((pushed + 1))
	else
		errors=$((errors + 1))
	fi

	prune_remote_logs "$root" "$quota_bytes" || true

	if [ "$errors" -gt 0 ]; then
		printf '{"ok":false,"pushed":%d,"errors":%d}\n' "$pushed" "$errors"
		return 1
	fi

	printf '{"ok":true,"pushed":%d,"errors":0}\n' "$pushed"
)

yandex_sync_read() (
	yandex_sync_path_ok || exit 1
	[ -f "$SYNC_STATUS_FILE" ] || exit 4
	# Ограничиваем именно чтение, а не размер уже загруженного в shell ответа.
	LC_ALL=C; export LC_ALL
	payload="$(head -c 8193 "$SYNC_STATUS_FILE" && printf .)" || exit 1
	payload="${payload%.}"
	[ -n "$payload" ] && [ "${#payload}" -le 8192 ] || exit 1
	# jshn уже входит в обе редакции. Его shell API использует unset-переменные;
	# снимаем nounset только в этом subshell и явно проверяем обязательные поля.
	set +u
	[ -r /usr/share/libubox/jshn.sh ] || exit 1
	. /usr/share/libubox/jshn.sh || exit 1
	json_init || exit 1
	jsonScript="$(jshn -r "$payload")" || exit 1
	# Только проверенный вывод штатного parser, никогда сам текст cache.
	eval "$jsonScript" || exit 1
	json_get_keys keys || exit 1
	count=0
	for key in $keys; do
		case "$key" in command|ok|message|at) ;; *) exit 1 ;; esac
		count=$((count + 1))
	done
	[ "$count" -eq 4 ] || exit 1
	for key in command message at; do
		json_get_type valueType "$key" || exit 1
		[ "$valueType" = string ] || exit 1
	done
	json_get_type valueType ok || exit 1
	[ "$valueType" = boolean ] || exit 1
	json_get_var action command || exit 1
	json_get_var ok ok || exit 1
	json_get_var message message || exit 1
	json_get_var stamp at || exit 1
	case "$ok" in 1) ok=true ;; 0) ok=false ;; *) exit 1 ;; esac
	yandex_sync_json "$action" "$ok" "$message" "$stamp"
)

cmd_sync_status() (
	# Отсутствие RAM-каталога допустимо после reboot. Ссылка или отказ чтения
	# не означает «синхронизации ещё не было» и не разрешает выдавать чужой файл.
	if [ ! -e /tmp/sheepfold ] && [ ! -L /tmp/sheepfold ]; then
		printf '{"ok":false,"message":"no sync yet"}\n'; exit 0
	fi
	result=0
	payload="$(yandex_sync_read)" || result=$?
	case "$result" in
		0) printf '%s\n' "$payload" ;;
		4) printf '{"ok":false,"message":"no sync yet"}\n' ;;
		*) printf '{"ok":false,"error":"sync_status_unavailable"}\n'; exit 1 ;;
	esac
)

command_name="${1:-}"
shift || true
case "$command_name" in
	status) cmd_status ;;
	test) cmd_test ;;
	list) cmd_list ;;
	download) cmd_download "$1" "$2" ;;
	restore-config) cmd_restore_config "$1" ;;
	sync-status) cmd_sync_status ;;
	verify) verify_upload "${1:-}" "${2:-}" ;;
