#!/bin/sh
# Очередь добровольных просьб: только RAM, без выдачи доступа. create/list/TTL
# согласованы отдельным lock; неисправную запись не удаляем как просроченную.
# Это не транзакция с UCI, не доставка уведомления и не сохранность после reboot.
set -eu
umask 077

. /usr/libexec/sheepfold/sheepfold-lock-common

STATE_DIR="/tmp/sheepfold/access-requests"
LOG_HELPER="/usr/libexec/sheepfold/sheepfold-log"
MAX_AGE_SECONDS=86400
REQUEST_TEMP_FILE=""

json_escape() {
    # Не заменяем пользовательский текст пробелами: JSON требует escaping всех
    # control-байтов. Дополнительный LF сохраняет исходные переводы строк в awk.
    printf '%s\n' "${1:-}" | LC_ALL=C awk '
        BEGIN {
            for (code = 1; code < 32; code++)
                escaped[sprintf("%c", code)] = sprintf("\\u%04x", code)
        }
        {
            if (NR > 1) printf "\\n"
            for (pos = 1; pos <= length($0); pos++) {
                char = substr($0, pos, 1)
                if (char == "\\") printf "\\\\"
                else if (char == "\"") printf "\\\""
                else if (char in escaped) printf "%s", escaped[char]
                else printf "%s", char
            }
        }
    '
}

normalize_mac() { printf '%s' "$1" | tr 'a-z' 'A-Z'; }

mac_for_ip() {
    client_ip="$1"
    mac=""
    [ ! -r /tmp/dhcp.leases ] || mac="$(awk -v ip="$client_ip" '$3 == ip { print toupper($2); exit }' /tmp/dhcp.leases)"
    [ -n "$mac" ] || [ ! -r /proc/net/arp ] || mac="$(awk -v ip="$client_ip" '$1 == ip { print toupper($4); exit }' /proc/net/arp)"
    normalize_mac "$mac"
}

device_section_for_mac() {
    wanted="$(normalize_mac "$1")"
    for section in $(uci -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=device$/\1/p'); do
        existing="$(uci -q get "sheepfold.$section.mac" 2>/dev/null || true)"
        [ "$(normalize_mac "$existing")" = "$wanted" ] || continue
        printf '%s\n' "$section"
        return 0
    done
    return 1
}

admin_section_for_login() {
    wanted="$1"
    for section in $(uci -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=administrator$/\1/p'); do
        [ "$(uci -q get "sheepfold.$section.login" 2>/dev/null || true)" = "$wanted" ] || continue
        printf '%s\n' "$section"
        return 0
    done
    return 1
}

requests_enabled() {
    # Вызов идёт в том же shell: цикл не должен заменить секцию ребёнка родителем.
    local section
    for section in $(uci -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=administrator$/\1/p'); do
        [ "$(uci -q get "sheepfold.$section.allow_child_access_requests" 2>/dev/null || printf 0)" = 1 ] && return 0
    done
    return 1
}

request_cleanup() {
    # Удаляется только временный файл этой операции, не чужая аварийная копия.
    [ -z "$REQUEST_TEMP_FILE" ] || rm -f "$REQUEST_TEMP_FILE" 2>/dev/null || true
    sheepfold_lock_release
}

request_lock_queue() {
    local lock_path lock_parent wait_seconds waited_seconds
    [ ! -L "$STATE_DIR" ] || return 5
    mkdir -p "$STATE_DIR" 2>/dev/null || return 5
    chmod 700 "$STATE_DIR" 2>/dev/null || return 5
    lock_path="$STATE_DIR/.queue.lock"
    [ ! -L "$lock_path" ] || return 5
    [ ! -e "$lock_path" ] || [ -f "$lock_path" ] || return 5
    # Не удаляем lock-файл: ожидающий процесс должен держать тот же inode.
    : >> "$lock_path" || return 5
    trap 'request_cleanup' EXIT
    trap 'exit 5' HUP INT TERM
    sheepfold_lock_acquire "$lock_path" 3 >/dev/null 2>&1 || return 5
}

request_time() {
    local value
    value="$1"
    case "$value" in ''|*[!0-9]*) return 5 ;; esac
    while [ "${value#0}" != "$value" ] && [ "${#value}" -gt 1 ]; do value="${value#0}"; done
    [ "${#value}" -le 10 ] && [ "$value" -gt 0 ] || return 5
    printf '%s\n' "$value"
}

read_request() {
    local file data key value
    file="$1"
    [ -f "$file" ] && [ ! -L "$file" ] || return 5
    # Один reader подтверждает всю запись. Ошибка I/O или повреждение не равны
    # отсутствию просьбы; частичный stdout не используется даже при похожих полях.
    data="$(LC_ALL=C awk '
        BEGIN {
            split("id created_at device_id device_name ip mac", fields, " ")
            for (i = 1; i <= 6; i++) required[fields[i]] = 1
        }
        {
            sep = index($0, "=")
            key = substr($0, 1, sep - 1)
            if (!sep || !(key in required) || seen[key]++) { bad = 1; next }
            value[key] = substr($0, sep + 1)
        }
        END {
            for (i = 1; i <= 6; i++) if (seen[fields[i]] != 1) bad = 1
            if (value["id"] !~ /^[0-9]+-[0-9]+$/ || value["device_id"] !~ /^[0-9]+$/) bad = 1
            stamp = value["created_at"]
            if (stamp !~ /^[0-9]+$/) bad = 1
            sub(/^0+/, "", stamp)
            if (length(stamp) > 10 || stamp + 0 <= 0) bad = 1
            if (bad) exit 5
            for (i = 1; i <= 6; i++) {
                key = fields[i]
                if (key == "created_at") printf "%s=%.0f\n", key, stamp + 0
                else printf "%s=%s\n", key, value[key]
            }
        }
    ' "$file")" || return 5
    # Не исполняем сохранённые строки как shell. Имена полей фиксированы.
    while IFS='=' read -r key value; do
        case "$key" in
            id) REQUEST_ID="$value" ;;
            created_at) REQUEST_CREATED_AT="$value" ;;
            device_id) REQUEST_DEVICE_ID="$value" ;;
            device_name) REQUEST_DEVICE_NAME="$value" ;;
            ip) REQUEST_IP="$value" ;;
            mac) REQUEST_MAC="$value" ;;
        esac
    done <<EOF
$data
EOF
}

cleanup_expired() {
    local file
    # Часы подтверждены до первого удаления. Вычитание — только десятичные числа.
    for file in "$STATE_DIR"/*.request; do
        [ -e "$file" ] || [ -L "$file" ] || continue
        read_request "$file" || return 5
        if [ "$REQUEST_CREATED_AT" -gt "$now" ] || [ $((now - REQUEST_CREATED_AT)) -gt "$MAX_AGE_SECONDS" ]; then
            rm -f "$file" || return 5
        fi
    done
}

log_request() {
    local message
    message="$1"
    if [ -x "$LOG_HELPER" ] && "$LOG_HELPER" "$message" >/dev/null 2>&1; then
        return 0
    fi
    if command -v logger >/dev/null 2>&1 && logger -t sheepfold-access-request "$message" >/dev/null 2>&1; then
        return 0
    fi
    printf 'Sheepfold access request saved, but diagnostic logging failed.\n' >&2
    return 0
}

create_request() {
    local temp_file stored_name
    remote_ip="$1"
    mac="$(mac_for_ip "$remote_ip")"
    [ -n "$mac" ] || return 2
    section="$(device_section_for_mac "$mac" 2>/dev/null || true)"
    [ -n "$section" ] || return 2
    [ "$(uci -q get "sheepfold.$section.admin_device" 2>/dev/null || printf 0)" != 1 ] || return 4
    requests_enabled || return 3

    # ID может быть напечатан до commit; частичный вывод не подтверждает успех.
    device_id="$(/usr/libexec/sheepfold/sheepfold-device-id ensure "$section" 2>/dev/null)" || return 5
    # ID участвует в имени временного файла, поэтому здесь допустимы только цифры.
    case "$device_id" in ''|*[!0-9]*) return 2 ;; esac
    device_name="$(uci -q get "sheepfold.$section.name" 2>/dev/null || true)"
    [ -n "$device_name" ] || device_name="$(awk -v ip="$remote_ip" '$3 == ip { print $4; exit }' /tmp/dhcp.leases 2>/dev/null || true)"
    [ "$device_name" != '*' ] || device_name=''
    # ID-подготовка не держит queue-lock и не наследует его в UCI helper.
    request_lock_queue || return 5
    now="$(date +%s)" || return 5
    now="$(request_time "$now")" || return 5
    cleanup_expired || return 5

    # Повторное нажатие возвращает прежнюю просьбу; TTL не продлевается.
    for file in "$STATE_DIR"/*.request; do
        [ -e "$file" ] || [ -L "$file" ] || continue
        read_request "$file" || return 5
        [ "$REQUEST_DEVICE_ID" = "$device_id" ] || continue
        request_id="$REQUEST_ID"
        printf '{"app":"sheepfold","ok":true,"requestId":"%s","duplicate":true}\n' "$(json_escape "$request_id")"
        return 0
    done

    request_id="${now}-${device_id:-unknown}"
    file="$STATE_DIR/$request_id.request"
    # mktemp в той же очереди: до успешной публикации готовый файл не виден.
    temp_file="$(mktemp "$STATE_DIR/.request.XXXXXX")" || return 1
    REQUEST_TEMP_FILE="$temp_file"
    stored_name="$(printf '%s' "$device_name" | tr '\n\r\t=' '    ')" || return 1
    # Один проверяемый write: не теряем ошибку раннего printf внутри группы.
    printf 'id=%s\ncreated_at=%s\ndevice_id=%s\ndevice_name=%s\nip=%s\nmac=%s\n' \
        "$request_id" "$now" "$device_id" "$stored_name" "$remote_ip" "$mac" \
        > "$REQUEST_TEMP_FILE" || return 1
    chmod 600 "$REQUEST_TEMP_FILE" 2>/dev/null || return 1
    mv -f "$REQUEST_TEMP_FILE" "$file" || return 1
    REQUEST_TEMP_FILE=""
    # Медленный журнал не удерживает очередь и не передаёт lock потомкам.
    sheepfold_lock_release

    # Просьба уже сохранена: диагностика не отменяет её и не загрязняет JSON.
    log_request "Устройство #${device_id:-?} ${device_name:-$mac} попросило 30 минут доступа в интернет"
    printf '{"app":"sheepfold","ok":true,"requestId":"%s","duplicate":false}\n' "$(json_escape "$request_id")"
}

list_requests() {
    login="$1"
    admin_section="$(admin_section_for_login "$login" 2>/dev/null || true)"
    [ -n "$admin_section" ] || { printf '{"app":"sheepfold","ok":false,"error":"administrator_not_found"}\n'; return 0; }
    [ "$(uci -q get "sheepfold.$admin_section.allow_child_access_requests" 2>/dev/null || printf 0)" = 1 ] || {
        printf '{"app":"sheepfold","ok":true,"requests":[]}\n'
        return 0
    }

    request_lock_queue || return 5
    now="$(date +%s)" || return 5
    now="$(request_time "$now")" || return 5
    cleanup_expired || return 5
    printf '{"app":"sheepfold","ok":true,"requests":['
    first=1
    for file in "$STATE_DIR"/*.request; do
        [ -e "$file" ] || [ -L "$file" ] || continue
        read_request "$file" || return 5
        [ "$first" = 1 ] || printf ','
        first=0
        printf '{"id":"%s","deviceId":"%s","deviceName":"%s","ip":"%s","mac":"%s","createdAt":%s}' \
            "$(json_escape "$REQUEST_ID")" \
            "$(json_escape "$REQUEST_DEVICE_ID")" \
            "$(json_escape "$REQUEST_DEVICE_NAME")" \
            "$(json_escape "$REQUEST_IP")" \
            "$(json_escape "$REQUEST_MAC")" \
            "$REQUEST_CREATED_AT"
    done
    printf ']}\n'
}

command="${1:-enabled}"
case "$command" in
    enabled)
        requests_enabled && printf '1\n' || printf '0\n'
        ;;
    create)
        create_request "${2:-}"
        ;;
    list)
        list_requests "${2:-}"
        ;;
    *)
        echo "Unknown access request command: $command" >&2
        exit 2
        ;;
esac
