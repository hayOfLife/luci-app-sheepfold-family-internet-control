#!/bin/sh
set -eu

. /usr/libexec/sheepfold/sheepfold-token-common

LEGACY="/usr/libexec/sheepfold/sheepfold-router-control-legacy"
PAIR_DEVICE="/usr/libexec/sheepfold/sheepfold-pair-device"
PAIR_ACTIVATE="/usr/libexec/sheepfold/sheepfold-pair-activate"
CLIENT_STATUS="/usr/libexec/sheepfold/sheepfold-client-status-effective"
DEVICE_RECLASSIFY="/usr/libexec/sheepfold/sheepfold-device-reclassify"
DEVICE_PRESENCE="/usr/libexec/sheepfold/sheepfold-device-presence"
LED_CONTROL="/usr/libexec/sheepfold/sheepfold-led-control"
FEEDBACK="/usr/libexec/sheepfold/sheepfold-feedback"
SUPPORT_REPORT="/usr/libexec/sheepfold/sheepfold-support-report"
IPV6_CONTROL="/usr/libexec/sheepfold/sheepfold-ipv6-control"
CHILD_WIFI_MONITOR="/usr/libexec/sheepfold/sheepfold-child-wifi-monitor"
TLS_FINGERPRINT="/usr/libexec/sheepfold/sheepfold-tls-fingerprint"
LOG_HELPER="/usr/libexec/sheepfold/sheepfold-log"
TOKEN_STATE_DIR="/etc/sheepfold/tokens"
TOKEN_RUNTIME_LINK="/tmp/sheepfold/tokens"

if [ "${1:-}" = "--luci" ]; then
    # Доверяем маркеру только внутри rpcd ACL: публичный Sheepfold API не
    # прокидывает его и ведёт собственную аутентификацию/атрибуцию. §logaudit
    SHEEPFOLD_ACTION_ACTOR='LuCI (Изменено на роутере)'
    export SHEEPFOLD_ACTION_ACTOR
    shift
fi
command="${1:-status}"

root_password_status() {
    password_field="$(awk -F: '$1 == "root" { print $2; exit }' /etc/shadow 2>/dev/null || true)"
    case "$password_field" in
        ''|'!'|'*'|'!!'|'x') printf 'unset\n' ;;
        *) printf 'set\n' ;;
    esac
}

# Переносим только проверенные обычные файлы. Сначала приватная копия, затем
# публикация без замены существующего файла; старый файл удаляется последним.
# rmdir вместо rm -rf не уничтожит поздно появившийся или неизвестный элемент.
migrate_token_storage() {
    local token_file target temporary
    for token_file in "$TOKEN_RUNTIME_LINK"/*; do
        [ -e "$token_file" ] || [ -L "$token_file" ] || continue
        [ -f "$token_file" ] && [ ! -L "$token_file" ] || {
            echo "Unexpected legacy token entry; migration stopped." >&2
            return 1
        }
        target="$TOKEN_STATE_DIR/${token_file##*/}"
        if [ -e "$target" ] || [ -L "$target" ]; then
            # Повтор после прерывания допустим только для тождественной копии.
            # При конфликте не выбираем старую/новую привязку за пользователя.
            [ -f "$target" ] && [ ! -L "$target" ] && cmp -s "$token_file" "$target" || {
                echo "Conflicting persistent token; migration stopped." >&2
                return 1
            }
            chmod 600 "$target" || return 1
        else
            temporary="$(mktemp "$TOKEN_STATE_DIR/.migration.XXXXXX")" || return 1
            if ! cp "$token_file" "$temporary" || ! chmod 600 "$temporary" ||
                ! cmp -s "$token_file" "$temporary" || ! ln -T "$temporary" "$target"; then
                rm -f "$temporary" 2>/dev/null || true
                echo "Token migration failed; the source was retained." >&2
                return 1
            fi
            # Оба имени в одной ФС: ln публикует готовый файл без перезаписи
            # конкурирующей записи. При отказе публикации источник не удалён.
            rm -f "$temporary" || return 1
        fi
        rm -f "$token_file" || return 1
    done
    rmdir "$TOKEN_RUNTIME_LINK" || return 1
}

ensure_token_storage() {
    umask 077
    mkdir -p /etc/sheepfold "$TOKEN_STATE_DIR" /tmp/sheepfold
    chmod 700 /etc/sheepfold "$TOKEN_STATE_DIR" 2>/dev/null || true

    if [ -L "$TOKEN_RUNTIME_LINK" ]; then
        if [ "$(readlink "$TOKEN_RUNTIME_LINK" 2>/dev/null || true)" = "$TOKEN_STATE_DIR" ]; then
            return 0
        fi
        rm -f "$TOKEN_RUNTIME_LINK"
    elif [ -d "$TOKEN_RUNTIME_LINK" ]; then
        migrate_token_storage || return 1
    elif [ -e "$TOKEN_RUNTIME_LINK" ]; then
        # Не удаляем неизвестный файл под видом каталога сеансов.
        echo "Unexpected token storage entry; migration stopped." >&2
        return 1
    fi

    ln -s "$TOKEN_STATE_DIR" "$TOKEN_RUNTIME_LINK"
}

sha256_value() (
    # Результат последнего cut/awk не подтверждает работу hash-процесса.
    # Сначала проверяем завершение, затем ровно 64 hex-символа; MD5 не допустим.
    if command -v sha256sum >/dev/null 2>&1; then
        digest="$(printf '%s' "$1" | sha256sum)" || return 1
        digest="${digest%% *}"
    elif command -v openssl >/dev/null 2>&1; then
        digest="$(printf '%s' "$1" | openssl dgst -sha256)" || return 1
        digest="${digest##* }"
    else
        echo "SHA-256 implementation is unavailable." >&2
        return 1
    fi
    case "$digest" in ''|*[!0-9a-fA-F]*) return 1 ;; esac
    [ "${#digest}" -eq 64 ] || return 1
    printf '%s' "$digest" | tr 'A-F' 'a-f'
)

check_token() {
    local bearer client_device_id client_mac token_file hash now section login
    bearer="${1:-}"
    client_device_id="${2:-}"
    client_mac="${3:-}"

    [ -n "$bearer" ] || { printf 'fail\n'; return 0; }

    for section in $(uci -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=administrator$/\1/p'); do
        login="$(uci -q get "sheepfold.$section.login" 2>/dev/null || true)"
        [ -n "$login" ] || continue
        hash="$(sha256_value "$login:$bearer")" || { printf 'fail\n'; return 0; }
        token_file="$TOKEN_STATE_DIR/$hash"
        [ -f "$token_file" ] || continue
        now="$(date +%s)"
        if token_bound_file_valid "$token_file" "$client_device_id" "$client_mac" "$now" "$login"; then
            printf 'ok\n'
            return 0
        fi
        printf 'fail\n'
        return 0
    done

    printf 'fail\n'
}

authenticate_token() {
    local bearer client_ip token_file hash now file_login device_id mac issued_at expires_at section login record_status
    bearer="${1:-}"
    client_ip="${2:-}"

    [ -n "$bearer" ] || return 2
    [ -n "$client_ip" ] || return 3

    for section in $(uci -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=administrator$/\1/p'); do
        login="$(uci -q get "sheepfold.$section.login" 2>/dev/null || true)"
        [ -n "$login" ] || continue
        hash="$(sha256_value "$login:$bearer")" || return 5
        token_file="$TOKEN_STATE_DIR/$hash"
        [ -f "$token_file" ] || continue

        # uhttpd на части OpenWrt-сборок не передаёт произвольные X-Sheepfold-*
        # заголовки CGI. Поэтому доверенные ID и MAC берём только из серверной
        # записи токена, а телефон предъявляет один Bearer. §pairtx1 §authrs1
        record_status=0
        token_load_bound_file "$token_file" || record_status=$?
        [ "$record_status" -eq 0 ] || return "$record_status"
        file_login="$TOKEN_RECORD_LOGIN"
        device_id="$TOKEN_RECORD_DEVICE_ID"
        mac="$TOKEN_RECORD_MAC"
        issued_at="$TOKEN_RECORD_ISSUED_AT"
        expires_at="$TOKEN_RECORD_EXPIRES_AT"

        [ "$file_login" = "$login" ] || return 4
        [ -n "$device_id" ] || return 4
        token_valid_mac "$mac" || return 4
        case "$issued_at" in ''|*[!0-9]*) return 4 ;; esac
        case "$expires_at" in ''|*[!0-9]*) return 4 ;; esac
        now="$(date +%s)" || return 5
        case "$now" in ''|*[!0-9]*) return 5 ;; esac
        [ "$expires_at" -le 0 ] || [ "$now" -le "$expires_at" ] || return 2
        token_device_is_admin_paired "$device_id" "$mac" || return 4
        token_request_source_matches "$client_ip" "$mac" || return 3

        printf 'login=%s\ndevice_id=%s\nmac=%s\n' "$login" "$device_id" "$mac"
        return 0
    done

    return 2
}

token_login() {
    local bearer client_device_id client_mac section login hash token_file
    bearer="${1:-}"
    client_device_id="${2:-}"
    client_mac="${3:-}"

    [ -n "$bearer" ] || return 1
    for section in $(uci -q show sheepfold 2>/dev/null | sed -n 's/^sheepfold\.\([^.=]*\)=administrator$/\1/p'); do
        login="$(uci -q get "sheepfold.$section.login" 2>/dev/null || true)"
        [ -n "$login" ] || continue
        hash="$(sha256_value "$login:$bearer")" || return 1
        token_file="$TOKEN_STATE_DIR/$hash"
        [ -f "$token_file" ] || continue
        if token_bound_file_valid "$token_file" "$client_device_id" "$client_mac" "$(date +%s)" "$login"; then
            printf '%s\n' "$login"
            return 0
        fi
        return 1
    done
    return 1
}

revoke_tokens() {
    local login token_file file_login revoked failed actor
    login="${1:-}"
    revoked=0
    failed=0

    for token_file in "$TOKEN_STATE_DIR"/*; do
        [ -f "$token_file" ] || continue
        if [ -n "$login" ]; then
            token_file_is_legacy "$token_file" && continue
            file_login="$(token_file_get "$token_file" login)" || {
                failed=$((failed + 1))
                continue
            }
            [ "$file_login" = "$login" ] || continue
        fi
        # Не объявляем существующий Bearer отозванным и не бросаем остальные
        # сеансы после первого отказа удаления (например, read-only overlay).
        if rm -f "$token_file" 2>/dev/null; then
            revoked=$((revoked + 1))
        else
            failed=$((failed + 1))
        fi
    done

    printf 'revoked=%s\n' "$revoked"
    if [ "$failed" -ne 0 ]; then
        printf 'failed=%s\n' "$failed"
        echo "Token revocation incomplete; failed records may remain active." >&2
        return 1
    fi
    actor="${SHEEPFOLD_ACTION_ACTOR:-Sheepfold API}"
    if [ -n "$login" ] && [ -x "$LOG_HELPER" ]; then
        "$LOG_HELPER" "$actor: выполнен отзыв телефонных сеансов администратора $login; удалено записей токенов: $revoked" >/dev/null 2>&1 || true
    fi
    return 0
}

revoke_device_tokens() {
    local device_id token_file file_device_id failed
    device_id="${1:-}"
    failed=0

    [ -n "$device_id" ] || return 1
    for token_file in "$TOKEN_STATE_DIR"/*; do
        [ -f "$token_file" ] || continue
        token_file_is_legacy "$token_file" && continue
        file_device_id="$(token_file_get "$token_file" device_id)" || {
            failed=$((failed + 1))
            continue
        }
        [ "$file_device_id" = "$device_id" ] || continue
        rm -f "$token_file" 2>/dev/null || failed=$((failed + 1))
    done
    [ "$failed" -eq 0 ] || {
        echo "Device token revocation incomplete; failed records may remain active." >&2
        return 1
    }
    return 0
}

ensure_token_storage

case "$command" in
    home-network-status)
        exec /usr/libexec/sheepfold/sheepfold-home-network status
        ;;
    home-network-configure)
        exec /usr/libexec/sheepfold/sheepfold-home-network configure "${2:-}" "${3:-}"
        ;;
    adguard-install-status)
        [ "$#" -eq 1 ] || exit 2
        exec /usr/libexec/sheepfold/sheepfold-adguard-install status
        ;;
    adguard-install-start)
        [ "$#" -eq 2 ] && [ "$2" = confirmed ] || exit 2
        exec /usr/libexec/sheepfold/sheepfold-adguard-install start confirmed
        ;;
    root-password-status)
        root_password_status
        ;;
    check-token)
        check_token "${2:-}" "${3:-}" "${4:-}"
        ;;
    authenticate-token)
        authenticate_token "${2:-}" "${3:-}"
        ;;
    token-login)
        token_login "${2:-}" "${3:-}" "${4:-}"
        ;;
    revoke-tokens)
        revoke_tokens "${2:-}"
        ;;
    revoke-device-tokens)
        revoke_device_tokens "${2:-}"
        ;;
    pair-admin-device)
        shift
        exec "$PAIR_DEVICE" "$@"
        ;;
    activate-admin-pairing-code)
        shift
        exec "$PAIR_ACTIVATE" "$@"
        ;;
    client-status)
        shift
        exec "$CLIENT_STATUS" "$@"
        ;;
    device-reclassify)
        shift
        exec "$DEVICE_RECLASSIFY" "$@"
        ;;
    device-presence)
        shift
        exec "$DEVICE_PRESENCE" "$@"
        ;;
    led-dependency-status)
        exec "$LED_CONTROL" dependency-status
        ;;
    led-dependency-install)
        exec "$LED_CONTROL" dependency-install
        ;;
    led-repair-status)
        exec "$LED_CONTROL" repair-status
        ;;
    led-repair-apply)
        exec "$LED_CONTROL" repair-apply
        ;;
    led-apply)
        exec "$LED_CONTROL" apply
        ;;
    feedback-status)
        exec "$FEEDBACK" status
        ;;
    feedback-submit)
        shift
        exec "$FEEDBACK" submit "$@"
        ;;
    support-report-status)
        exec "$SUPPORT_REPORT" status
        ;;
    support-report-config)
        exec "$SUPPORT_REPORT" config
        ;;
    support-report-submit)
        shift
        exec "$SUPPORT_REPORT" submit-encrypted "$@"
        ;;
    ipv6-apply)
        exec "$IPV6_CONTROL" apply
        ;;
    ipv6-status)
        exec "$IPV6_CONTROL" status
        ;;
    ipv6-release)
        exec "$IPV6_CONTROL" release
        ;;
    child-wifi-history-clear)
        exec "$CHILD_WIFI_MONITOR" clear
        ;;
    tls-public-key-fingerprint)
        exec "$TLS_FINGERPRINT"
        ;;
    *)
        exec "$LEGACY" "$@"
        ;;
esac
