#!/bin/sh
set -eu

ROOT="${1:-}"

path() { printf '%s%s' "$ROOT" "$1"; }
die() { echo "Sheepfold hardening check failed: $*" >&2; exit 1; }

for helper in /usr/libexec/sheepfold/sheepfold-home-network /usr/libexec/sheepfold/sheepfold-home-firewall /etc/hotplug.d/iface/90-sheepfold-home-network; do
    [ -f "$(path "$helper")" ] || die "missing file $helper"
    chmod 0755 "$(path "$helper")"
done

CGI="$(path /www/cgi-bin/sheepfold-api)"
CGI_LEGACY="$(path /usr/libexec/sheepfold/sheepfold-api-legacy)"
CONTROL="$(path /usr/libexec/sheepfold/sheepfold-router-control)"
CONTROL_LEGACY="$(path /usr/libexec/sheepfold/sheepfold-router-control-legacy)"
CLIENT_STATUS="$(path /usr/libexec/sheepfold/sheepfold-client-status-effective)"
SERVICE="$(path /usr/libexec/sheepfold/sheepfold-service)"
DEVICE_DETECTOR="$(path /usr/libexec/sheepfold/sheepfold-device-detector)"
DEVICE_ID="$(path /usr/libexec/sheepfold/sheepfold-device-id)"
DEVICE_CLASSIFIER="$(path /usr/libexec/sheepfold/sheepfold-device-classifier)"
DEVICE_OUI_OVERRIDES="$(path /usr/share/sheepfold/device-oui-overrides)"
DEVICE_MDNS="$(path /usr/libexec/sheepfold/sheepfold-device-mdns)"
DEVICE_MDNS_UCODE="$(path /usr/share/sheepfold/device-mdns.uc)"
DEVICE_SSDP="$(path /usr/libexec/sheepfold/sheepfold-device-ssdp)"
DEVICE_SSDP_UCODE="$(path /usr/share/sheepfold/device-ssdp.uc)"
DEVICE_UPNP_DESCRIPTION="$(path /usr/libexec/sheepfold/sheepfold-device-upnp-description)"
DEVICE_WSD="$(path /usr/libexec/sheepfold/sheepfold-device-ws-discovery)"
DEVICE_WSD_UCODE="$(path /usr/share/sheepfold/device-ws-discovery.uc)"
DEVICE_IDENTITY="$(path /usr/libexec/sheepfold/sheepfold-device-identity)"
DEVICE_PRESENCE="$(path /usr/libexec/sheepfold/sheepfold-device-presence)"
DEVICE_RECLASSIFY="$(path /usr/libexec/sheepfold/sheepfold-device-reclassify)"
DHCP_SIGNALS="$(path /etc/hotplug.d/dhcp/90-sheepfold-device-signals)"
LED_CONTROL="$(path /usr/libexec/sheepfold/sheepfold-led-control)"
IPV6_CONTROL="$(path /usr/libexec/sheepfold/sheepfold-ipv6-control)"
PACKAGE_MANAGER="$(path /usr/libexec/sheepfold/sheepfold-package-manager)"
PAIR_ACTIVATE="$(path /usr/libexec/sheepfold/sheepfold-pair-activate)"
PAIR_DEVICE="$(path /usr/libexec/sheepfold/sheepfold-pair-device)"
PAIR_COMMON="$(path /usr/libexec/sheepfold/sheepfold-pair-common)"
PAIR_ATTEMPTS="$(path /usr/libexec/sheepfold/sheepfold-pair-attempt-common)"
TOKEN_COMMON="$(path /usr/libexec/sheepfold/sheepfold-token-common)"
PAIR_API="$(path /usr/libexec/sheepfold/sheepfold-api-pair)"
API_RATE_LIMIT="$(path /usr/libexec/sheepfold/sheepfold-api-rate-limit)"
STATUS_API="$(path /usr/libexec/sheepfold/sheepfold-api-client-status)"
ACCESS_REQUEST="$(path /usr/libexec/sheepfold/sheepfold-access-request)"
ADMIN_NOTIFICATION="$(path /usr/libexec/sheepfold/sheepfold-admin-notification)"
SIM_MONITOR="$(path /usr/libexec/sheepfold/sheepfold-sim-monitor)"
CHILD_WIFI_MONITOR="$(path /usr/libexec/sheepfold/sheepfold-child-wifi-monitor)"
TLS_FINGERPRINT="$(path /usr/libexec/sheepfold/sheepfold-tls-fingerprint)"
HASH_COMMON="$(path /usr/libexec/sheepfold/sheepfold-hash-common)"
LOCK_COMMON="$(path /usr/libexec/sheepfold/sheepfold-lock-common)"
LOG_COMMON="$(path /usr/libexec/sheepfold/sheepfold-log-common)"
FORM_COMMON="$(path /usr/libexec/sheepfold/sheepfold-lib-form)"
POLICY_COMMON="$(path /usr/libexec/sheepfold/sheepfold-lib-access-policy)"
FIREWALL="$(path /usr/libexec/sheepfold/sheepfold-firewall)"
SCHEDULE_EVALUATOR="$(path /usr/libexec/sheepfold/sheepfold-schedule-evaluator)"
EMERGENCY_SITES="$(path /usr/libexec/sheepfold/sheepfold-emergency-sites)"
COUNTRY_PROFILE="$(path /usr/libexec/sheepfold/sheepfold-country-profile)"
COUNTRY_PROFILE_RU="$(path /usr/share/sheepfold/country-profiles/ru.json)"
COUNTRY_PROFILE_BY="$(path /usr/share/sheepfold/country-profiles/by.json)"
COUNTRY_PROFILE_CN="$(path /usr/share/sheepfold/country-profiles/cn.json)"
SITE_LISTS="$(path /usr/libexec/sheepfold/sheepfold-site-lists)"
DOMAIN_POLICY="$(path /usr/libexec/sheepfold/sheepfold-domain-policy)"
ADGUARD_ADAPTER="$(path /usr/libexec/sheepfold/sheepfold-adguard)"
ADGUARD_INSTALL="$(path /usr/libexec/sheepfold/sheepfold-adguard-install)"
ADGUARD_PROFILE="$(path /usr/share/sheepfold/adguard-install-profile.json)"
ADGUARD_FEED="$(path /www/cgi-bin/sheepfold-adguard-list)"
VARIANT_REQUIRED=""
VARIANT_EXECUTABLES=""
# SHEEPFOLD_AI_BEGIN
AI_GATE="$(path /usr/libexec/sheepfold/sheepfold-ai-gate)"
AI_HANDLER="$(path /usr/libexec/sheepfold/sheepfold-ai-handler)"
JSON_COMMON="$(path /usr/libexec/sheepfold/sheepfold-lib-json)"
ACTIVITY_LOG="$(path /usr/libexec/sheepfold/sheepfold-activity-log)"
OPENSSL_ENSURE="$(path /usr/libexec/sheepfold/sheepfold-openssl-ensure)"
VARIANT_REQUIRED="$AI_GATE $AI_HANDLER $JSON_COMMON $ACTIVITY_LOG $OPENSSL_ENSURE"
VARIANT_EXECUTABLES="$AI_GATE $AI_HANDLER $ACTIVITY_LOG $OPENSSL_ENSURE"
# SHEEPFOLD_AI_END
MAINTENANCE_WINDOW="$(path /usr/libexec/sheepfold/sheepfold-maintenance-window)"
KEY_DERIVE="$(path /usr/libexec/sheepfold/sheepfold-key-derive)"
USB_STORAGE="$(path /usr/libexec/sheepfold/sheepfold-usb-storage)"
WELL_KNOWN_GENERATOR="$(path /www/.well-known/sheepfold.json.sh)"
ACL="$(path /usr/share/rpcd/acl.d/luci-app-sheepfold-family-internet-control.json)"
PRIVACY_NOTICE="$(path /usr/share/sheepfold/PRIVACY_NOTICE.md)"
CUDY_PROFILE="$(path /usr/share/sheepfold/router-profiles/cudy,wr3000s-v1)"
CUDY_LED_APPLY_MODE="$CUDY_PROFILE/led/apply-mode"
CUDY_LED_PACKAGE="$CUDY_PROFILE/led/dependency-package"
CUDY_LED_COMMAND="$CUDY_PROFILE/led/dependency-command"
CUDY_FIX_INSTALL="$CUDY_PROFILE/fixLed/install"
CUDY_FIX_UNINSTALL="$CUDY_PROFILE/fixLed/uninstall"

for required in \
    "$CGI" "$CGI_LEGACY" "$CONTROL" "$CONTROL_LEGACY" "$CLIENT_STATUS" \
	"$SERVICE" "$DEVICE_DETECTOR" "$DEVICE_ID" "$DEVICE_CLASSIFIER" "$DEVICE_OUI_OVERRIDES" "$DEVICE_MDNS" \
    "$DEVICE_MDNS_UCODE" "$DEVICE_SSDP" "$DEVICE_SSDP_UCODE" "$DEVICE_UPNP_DESCRIPTION" "$DEVICE_WSD" "$DEVICE_WSD_UCODE" "$DEVICE_IDENTITY" "$DEVICE_PRESENCE" "$DEVICE_RECLASSIFY" \
    "$DHCP_SIGNALS" "$LED_CONTROL" "$IPV6_CONTROL" "$PACKAGE_MANAGER" "$PAIR_ACTIVATE" "$PAIR_DEVICE" \
	"$PAIR_COMMON" "$PAIR_ATTEMPTS" "$TOKEN_COMMON" "$PAIR_API" "$API_RATE_LIMIT" "$STATUS_API" "$ACCESS_REQUEST" "$ADMIN_NOTIFICATION" "$SIM_MONITOR" "$CHILD_WIFI_MONITOR" "$TLS_FINGERPRINT" "$HASH_COMMON" "$LOCK_COMMON" "$LOG_COMMON" "$FORM_COMMON" "$POLICY_COMMON" \
    "$FIREWALL" "$SCHEDULE_EVALUATOR" "$EMERGENCY_SITES" "$COUNTRY_PROFILE" \
    "$COUNTRY_PROFILE_RU" "$COUNTRY_PROFILE_BY" "$COUNTRY_PROFILE_CN" "$SITE_LISTS" "$DOMAIN_POLICY" \
    "$ADGUARD_ADAPTER" "$ADGUARD_INSTALL" "$ADGUARD_PROFILE" "$ADGUARD_FEED" $VARIANT_REQUIRED \
    "$MAINTENANCE_WINDOW" "$KEY_DERIVE" \
    "$USB_STORAGE" "$WELL_KNOWN_GENERATOR" "$ACL" "$PRIVACY_NOTICE" \
    "$CUDY_LED_APPLY_MODE" "$CUDY_LED_PACKAGE" "$CUDY_LED_COMMAND" \
    "$CUDY_FIX_INSTALL" "$CUDY_FIX_UNINSTALL"; do
    [ -f "$required" ] || die "missing file $required"
done

# Git contents API не сохраняет executable bit, поэтому восстанавливаем его явно.
for executable in \
    "$CGI" "$CGI_LEGACY" "$CONTROL" "$CONTROL_LEGACY" "$CLIENT_STATUS" \
    "$SERVICE" "$DEVICE_DETECTOR" "$DEVICE_ID" "$DEVICE_CLASSIFIER" "$DEVICE_MDNS" "$DEVICE_SSDP" "$DEVICE_UPNP_DESCRIPTION" "$DEVICE_WSD" "$DEVICE_IDENTITY" \
    "$DEVICE_PRESENCE" "$DEVICE_RECLASSIFY" "$DHCP_SIGNALS" "$LED_CONTROL" "$PACKAGE_MANAGER" \
	"$STATUS_API" "$ACCESS_REQUEST" "$ADMIN_NOTIFICATION" "$SIM_MONITOR" "$CHILD_WIFI_MONITOR" "$TLS_FINGERPRINT" "$FIREWALL" "$SCHEDULE_EVALUATOR" \
    "$EMERGENCY_SITES" "$COUNTRY_PROFILE" "$SITE_LISTS" "$DOMAIN_POLICY" "$ADGUARD_ADAPTER" "$ADGUARD_INSTALL" "$ADGUARD_FEED" \
    "$PAIR_API" "$API_RATE_LIMIT" "$PAIR_ACTIVATE" "$PAIR_DEVICE" $VARIANT_EXECUTABLES \
    "$MAINTENANCE_WINDOW" "$KEY_DERIVE" "$USB_STORAGE" "$WELL_KNOWN_GENERATOR" \
    "$CUDY_LED_APPLY_MODE" "$CUDY_FIX_INSTALL" "$CUDY_FIX_UNINSTALL" \
    "$(path /usr/libexec/sheepfold/sheepfold-runtime-hardening)"; do
    chmod 0755 "$executable"
done
chmod 0644 "$PAIR_COMMON" "$PAIR_ATTEMPTS" "$TOKEN_COMMON" "$HASH_COMMON" "$LOCK_COMMON" "$LOG_COMMON" "$FORM_COMMON" "$POLICY_COMMON" ${JSON_COMMON:+"$JSON_COMMON"} "$ACL" "$PRIVACY_NOTICE" "$DEVICE_OUI_OVERRIDES" "$DEVICE_MDNS_UCODE" "$DEVICE_SSDP_UCODE" "$DEVICE_WSD_UCODE" \
    "$COUNTRY_PROFILE_RU" "$COUNTRY_PROFILE_BY" "$COUNTRY_PROFILE_CN" "$CUDY_LED_PACKAGE" "$CUDY_LED_COMMAND"

mkdir -p "$(path /etc/sheepfold/tokens)"
chmod 0700 "$(path /etc/sheepfold)" "$(path /etc/sheepfold/tokens)" 2>/dev/null || true

# Публичный CGI обязан скрывать выпуск кода и защищать диагностику.
grep -q 'sheepfold-api-legacy' "$CGI" || die "public CGI does not delegate through the hardened dispatcher"
grep -q '\[ "\$path_info" = "/pair-token" \]' "$CGI" || die "public CGI does not return 404 for pair-token"
! grep -q '^generate_pair_token_json()' "$CGI" || die "pair-token generator is present in public CGI"
! grep -q '^[[:space:]]*/pair-token)' "$CGI" || die "pair-token route is present in public CGI"
# SHEEPFOLD_AI_BEGIN
grep -q 'AI_HANDLER=' "$CGI" || die "role-aware AI handler is not connected"
# SHEEPFOLD_AI_END
grep -q '/router-info|/pair-status)' "$CGI" || die "diagnostic routes are not intercepted"
grep -q '^[[:space:]]*/ping)' "$CGI" || die "dedicated discovery ping route is missing"
grep -q 'query_token_forbidden' "$CGI" || die "Bearer token is still accepted in query string"
grep -q 'legacy_settings_writer_disabled' "$CGI" || die "legacy untyped settings writer remains enabled"

# AdGuard adapter владеет только своей URL-лентой и не заменяет правила пользователя. §dompol
grep -q '/control/filtering/add_url' "$ADGUARD_ADAPTER" || die "AdGuard managed-filter creation is missing"
grep -q '/control/filtering/set_url' "$ADGUARD_ADAPTER" || die "AdGuard managed-filter toggle is missing"
! grep -q '/control/filtering/set_rules' "$ADGUARD_ADAPTER" || die "AdGuard user rules can be overwritten"
grep -q 'REMOTE_ADDR' "$ADGUARD_FEED" || die "AdGuard feed is not restricted to loopback"
grep -q 'requested_token' "$ADGUARD_FEED" || die "AdGuard feed token check is missing"

# Pairing не создаёт администратора, повторно проверяет blocklist и фиксирует
# device ID, токен, права и одноразовый код одной UCI-транзакцией. §pairtx1
grep -q 'PAIR_DEVICE=.*/sheepfold-pair-device' "$CONTROL" || die "pair-admin-device is not intercepted"
grep -q 'PAIR_ACTIVATE=.*/sheepfold-pair-activate' "$CONTROL" || die "pairing-code activation is not intercepted"
grep -q 'CLIENT_STATUS=.*/sheepfold-client-status-effective' "$CONTROL" || die "effective client status is not intercepted"
grep -q 'exec "\$PAIR_DEVICE"' "$CONTROL" || die "pair device helper is not executed"
grep -q 'exec "\$PAIR_ACTIVATE"' "$CONTROL" || die "pair activation helper is not executed"
grep -q 'exec "\$CLIENT_STATUS"' "$CONTROL" || die "effective client status helper is not executed"
grep -q '/etc/sheepfold/tokens' "$CONTROL" || die "persistent administrator token storage is missing"
grep -q 'pair_admin_section_for_login' "$PAIR_ACTIVATE" || die "existing administrator lookup is missing"
grep -q 'Create the account in LuCI first' "$PAIR_ACTIVATE" || die "missing-admin failure is not explicit"
grep -q 'reset_old_pairing_attempts' "$PAIR_ACTIVATE" || die "new pairing code does not reset stale attempts"
grep -q 'reset-bucket)' "$API_RATE_LIMIT" || die "pairing rate-limit reset is unavailable"
# r294 перенёс учёт попыток в reserve-before-backend. Проверяем реальное
# подключение и обязательные границы, а не имя удалённой локальной функции.
for consumer in "$PAIR_API" "$PAIR_ACTIVATE"; do
    grep -Fqx '. /usr/libexec/sheepfold/sheepfold-pair-attempt-common' "$consumer" || \
        die "pairing attempt library is not connected in $consumer"
done
grep -q '^pair_attempt_reserve() {' "$PAIR_ATTEMPTS" || die "pairing attempt reservation is missing"
grep -Fq 'pair_attempt_reserve "$attempt_identity_value" || attempt_status="$?"' "$PAIR_API" || \
    die "pairing request does not reserve an attempt"
grep -Fq 'pair_attempt_lock || return 2' "$PAIR_ATTEMPTS" || die "pairing attempt reservation is not locked"
grep -Fq 'sheepfold_lock_acquire "$path" 3' "$PAIR_ATTEMPTS" || die "pairing attempt kernel lock is missing"
grep -Fq 'pair_attempt_write "$((PAIR_ATTEMPT_PREVIOUS + 1))" || return 2' "$PAIR_ATTEMPTS" || \
    die "pairing attempt reservation is not persisted"
grep -Fq 'pair_attempt_reset || return 1' "$PAIR_ACTIVATE" || die "new pairing code does not reset reserved attempts"
! grep -q '=administrator' "$PAIR_ACTIVATE" || die "pair activation can create an administrator"

block_checks="$(grep -c 'pair_list_has_mac blocklist' "$PAIR_DEVICE" || true)"
[ "$block_checks" -ge 2 ] || die "pairing does not recheck blocklist"
! grep -q 'remove.*blocklist\|delete.*blocklist' "$PAIR_DEVICE" || die "pairing can mutate blocklist"
grep -q 'pair_store_token' "$PAIR_DEVICE" || die "successful pairing does not store a token hash"
grep -q 'PAIR_UCI_SAVEDIR' "$PAIR_DEVICE" || die "pairing does not isolate its UCI delta"
grep -q 'uci -t "\$PAIR_UCI_SAVEDIR" -p "\$PAIR_UCI_SAVEDIR"' "$PAIR_DEVICE" || \
    die "pairing does not separate UCI delta writes from the main config commit"
! grep -q 'uci -P "\$PAIR_UCI_SAVEDIR"' "$PAIR_DEVICE" || \
    die "pairing uses -P and can commit only into the disposable UCI directory"
grep -q 'uci -t "\$SHEEPFOLD_UCI_SAVEDIR" -p "\$SHEEPFOLD_UCI_SAVEDIR"' "$DEVICE_ID" || \
    die "staged device ID does not share the safe pairing UCI transaction"
grep -q 'pair_committed_state_is_valid' "$PAIR_DEVICE" || \
    die "pairing does not verify the main UCI config before returning a token"
grep -q 'ensure-staged' "$PAIR_DEVICE" || die "pairing device ID is committed before the transaction"
grep -q 'ensure-staged)' "$DEVICE_ID" || die "staged device ID allocation is unavailable"
grep -q 'pair_restore_snapshot' "$PAIR_DEVICE" || die "pairing has no commit-failure recovery"
grep -q 'token_write_bound_file' "$PAIR_COMMON" || die "pairing does not store token device metadata"
grep -q 'token_device_is_admin_paired' "$TOKEN_COMMON" || die "token device binding helper is missing"
grep -q 'authenticate-token)' "$CONTROL" || die "server-side bound-token authentication is missing"
grep -q 'token_load_bound_file "\$token_file"' "$CONTROL" || die "API auth does not validate the complete bound token"
grep -q 'device_id="\$TOKEN_RECORD_DEVICE_ID"' "$CONTROL" || die "API auth does not read server-bound device id"
grep -q 'token_load_bound_file()' "$TOKEN_COMMON" || die "bound token record reader is missing"
grep -q 'authenticate-token "\$bearer" "\$client_ip"' "$CGI" || die "CGI does not use server-side bound-token authentication"
! grep -q 'HTTP_X_SHEEPFOLD_DEVICE_ID\|HTTP_X_SHEEPFOLD_DEVICE_MAC' "$CGI" || \
    die "CGI trusts optional client identity headers"
grep -q 'revoke-device-tokens' "$CONTROL" || die "per-device token revoke is missing"
grep -q 'pair_valid_code' "$PAIR_COMMON" || die "pairing-code alphabet validation is missing"
grep -q 'device_id' "$PAIR_DEVICE" || die "pairing does not return stable device id"

# Запрос ребёнка не принимает MAC/IP из тела запроса: устройство определяется самим роутером.
grep -q '/access-request)' "$CGI" || die "public child access request route is missing"
grep -q '/access-requests)' "$CGI" || die "administrator access request route is missing"
grep -q 'mac_for_ip' "$ACCESS_REQUEST" || die "access request does not resolve the device on the router"
grep -q '/tmp/sheepfold/access-requests' "$ACCESS_REQUEST" || die "access requests are not stored in RAM"

# Системные предупреждения доступны только через аутентифицированный API и не считаются прочитанными одним телефоном за все остальные.
grep -q '/notifications)' "$CGI" || die "administrator notifications route is missing"
grep -q 'require_admin' "$CGI" || die "administrator notifications are not protected"
grep -q 'MAX_NOTIFICATIONS' "$ADMIN_NOTIFICATION" || die "administrator notification queue is unbounded"

# SIM-отчёт детского APK не может выбрать произвольное устройство и не даёт прав.
grep -q '/sim-report)' "$CGI" || die "public SIM report route is missing"
grep -q 'enforce_rate_limit sim_report' "$CGI" || die "SIM report route is not rate limited"
grep -q 'mac_for_ip' "$SIM_MONITOR" || die "SIM report trusts a client device identifier"
grep -q 'sim_change_notifications' "$SIM_MONITOR" || die "SIM notification mode is ignored"
grep -q 'sim_phone_history' "$SIM_MONITOR" || die "long-term SIM phone history is missing"
grep -q 'sheepfold_lock_acquire' "$SIM_MONITOR" || die "SIM reports are not serialized"

# Wi-Fi-отчёт хранит только локальный отпечаток сети и определяет устройство по IP.
grep -q '/wifi-network-report)' "$CGI" || die "public child Wi-Fi report route is missing"
grep -q 'enforce_rate_limit wifi_network_report' "$CGI" || die "child Wi-Fi report route is not rate limited"
grep -q 'mac_for_ip' "$CHILD_WIFI_MONITOR" || die "child Wi-Fi report trusts a client device identifier"
grep -q 'child_wifi_network_notifications' "$CHILD_WIFI_MONITOR" || die "child Wi-Fi notification mode is ignored"
grep -q 'HISTORY_RETENTION_SECONDS=.*7776000' "$CHILD_WIFI_MONITOR" || die "child Wi-Fi history has no 90-day retention"
! grep -q 'bssid=' "$CHILD_WIFI_MONITOR" || die "raw child Wi-Fi BSSID can be stored on the router"
grep -q 'child-wifi-history-clear' "$CONTROL" || die "child Wi-Fi history cannot be cleared from LuCI"

# С r287 расчёт вынесен в общую библиотеку. Проверяем и подключение, и её
# содержимое: поиск прежних строк в тонком wrapper отклонял исправный postinst.
grep -q '^\. "\$POLICY_COMMON"' "$CLIENT_STATUS" || die "effective status does not load the shared policy"
grep -q 'sheepfold_policy_evaluate "\$device_section" "\$client_mac"' "$CLIENT_STATUS" || die "effective status does not invoke the shared policy"
grep -q 'global_block' "$POLICY_COMMON" || die "effective status ignores global block"
grep -q 'temporary_access_expired' "$POLICY_COMMON" || die "effective status ignores expired temporary access"
grep -q 'schedule_pending_evaluation' "$POLICY_COMMON" || die "scheduled status still claims an unverified result"

# Автоопределение использует независимые сигналы и не повторяет побочные действия.
grep -q 'DNSMASQ_VENDOR_CLASS' "$DHCP_SIGNALS" || die "DHCP vendor-class collection is missing"
grep -q 'DNSMASQ_REQUESTED_OPTIONS' "$DHCP_SIGNALS" || die "DHCP option fingerprint collection is missing"
grep -q 'device-signals.changed' "$SERVICE" || die "DHCP signal changes do not trigger detection"
grep -q 'device-detection.flock' "$SERVICE" || die "background detection is not serialized"
grep -q 'sheepfold_lock_acquire' "$SERVICE" || die "background detection ignores the common lock helper"
grep -q 'run_scan_locked' "$DEVICE_DETECTOR" || die "direct device detection is not serialized"
# При проверке staged root нельзя требовать flock от Windows/SDK-хоста.
# На настоящем роутере ROOT пуст, и зависимость пакета обязана дать команду. §owrtci1
if [ -z "$ROOT" ]; then
    command -v flock >/dev/null 2>&1 || die "flock is unavailable"
fi
grep -q 'NETWORK_NAME_PATTERN=' "$DEVICE_CLASSIFIER" || die "network infrastructure guard is missing"
classifier_policy="$(sed -n 's/^POLICY_VERSION="\([^"]*\)"/\1/p' "$DEVICE_CLASSIFIER" | sed -n '1p')"
detector_policy="$(sed -n 's/^POLICY_VERSION="\([^"]*\)"/\1/p' "$DEVICE_DETECTOR" | sed -n '1p')"
[ -n "$classifier_policy" ] && [ "$classifier_policy" = "$detector_policy" ] || \
    die "device classifier and detector policy versions differ"
grep -q 'EVIDENCE_COUNT' "$DEVICE_CLASSIFIER" || die "independent evidence counting is missing"
grep -q 'nmap-mac-prefixes' "$DEVICE_CLASSIFIER" || die "local OUI lookup is missing"
grep -q '^FC671F Tuya Smart Inc\.$' "$DEVICE_OUI_OVERRIDES" || die "supplemental OUI database is invalid"
grep -q 'mdns_has' "$DEVICE_CLASSIFIER" || die "mDNS evidence handling is missing"
grep -q 'ucode "\$UCODE_SOURCE"' "$DEVICE_MDNS" || die "mDNS shell wrapper does not invoke ucode safely"
grep -q 'ubus.call("umdns", "browse"' "$DEVICE_MDNS_UCODE" || die "mDNS reader does not use the OpenWrt browse API"
grep -q 'ubus.call("umdns", "hosts"' "$DEVICE_MDNS_UCODE" || die "mDNS reader does not use the OpenWrt hosts API"
grep -q 'device-mdns.tsv' "$DEVICE_DETECTOR" || die "mDNS snapshot is not included in detection"
grep -q 'detection_mdns_services' "$DEVICE_DETECTOR" || die "mDNS evidence is not persisted"
grep -q 'SO_BINDTODEVICE' "$DEVICE_SSDP_UCODE" || die "SSDP discovery is not bound to LAN"
grep -q 'M-SEARCH' "$DEVICE_SSDP_UCODE" || die "SSDP discovery request is missing"
! grep -q 'uclient-fetch\|curl\|wget' "$DEVICE_SSDP_UCODE" || die "SSDP discovery must not fetch arbitrary description URLs"
grep -q '\[ "\$host" = "\$PEER_IP" \]' "$DEVICE_UPNP_DESCRIPTION" || die "UPnP LOCATION is not pinned to the responding peer"
grep -q -- "--max-redirs 0" "$DEVICE_UPNP_DESCRIPTION" || die "UPnP LOCATION redirects are not disabled"
grep -q -- "--max-filesize" "$DEVICE_UPNP_DESCRIPTION" || die "UPnP description size is not bounded"
grep -q -- "--interface \"\$lan_device\"" "$DEVICE_UPNP_DESCRIPTION" || die "UPnP description fetch is not LAN-bound"
grep -q 'SO_BINDTODEVICE' "$DEVICE_WSD_UCODE" || die "WS-Discovery is not bound to LAN"
grep -q 'IP_ADD_MEMBERSHIP' "$DEVICE_WSD_UCODE" || die "WS-Discovery passive listener is missing"
grep -q '<d:Probe' "$DEVICE_WSD_UCODE" || die "WS-Discovery active probe is missing"
grep -q 'SHEEPFOLD_WSD_ACTIVE_PROBE="\$FORCE"' "$DEVICE_WSD" || die "WS-Discovery probe is not restricted to a new-device event"
grep -q 'if (ACTIVE_PROBE)' "$DEVICE_WSD_UCODE" || die "WS-Discovery probe is sent during passive scans"
! grep -q 'uclient-fetch\|curl\|wget' "$DEVICE_WSD_UCODE" || die "WS-Discovery must not open advertised XAddrs"
grep -q 'detection_ssdp_profile' "$DEVICE_DETECTOR" || die "SSDP evidence is not persisted"
grep -q 'detection_wsd_profile' "$DEVICE_DETECTOR" || die "WS-Discovery evidence is not persisted"
grep -q 'detection_identity_keys' "$DEVICE_DETECTOR" || die "stable device identity keys are not persisted"
grep -q 'multiple_signal_families' "$DEVICE_IDENTITY" || die "logical-device linking lacks multifactor matching"
! grep -Eq 'uci.*(set|add_list).*(allowlist|blocklist|\.group)' "$DEVICE_IDENTITY" || die "logical-device linking must not inherit access policy"
grep -q '\[ "\$evidence_count" -lt 2 \]' "$DEVICE_DETECTOR" || die "automatic group assignment does not require two evidence families"
grep -q 'detection_fingerprint' "$DEVICE_DETECTOR" || die "device fingerprint persistence is missing"
grep -q 'detection_policy_version' "$DEVICE_DETECTOR" || die "classification policy version is not persisted"
grep -q 'device-detection.last-scan' "$DEVICE_DETECTOR" || die "runtime last-scan state is missing"
assignment_calls="$(grep -c 'assign_detected_group_if_allowed "\$section"' "$DEVICE_DETECTOR" || true)"
[ "$assignment_calls" -ge 2 ] || die "automatic group assignment is not connected to fresh and locked detection paths"
grep -q 'auto_configure="$(global_get auto_configure 1)"' "$DEVICE_DETECTOR" || die "automatic group assignment ignores auto-configure setting"
! grep -q 'revoke_unsafe_auto_assignment' "$DEVICE_DETECTOR" || die "automatic group rollback must not be present"
grep -q 'classify <name>' "$DEVICE_DETECTOR" || die "detector regression interface is missing"

# Онлайн-статус хранится только в RAM и не считает статическую запись присутствием.
grep -q 'DEVICE_PRESENCE=.*/sheepfold-device-presence' "$CONTROL" || die "device presence is not routed"
grep -q 'exec "\$DEVICE_PRESENCE"' "$CONTROL" || die "device presence helper is not executed"
grep -q 'ONLINE_WINDOW_SECONDS=900' "$DEVICE_PRESENCE" || die "device online window is not fifteen minutes"
grep -q 'refresh_from_dhcp_signals' "$DEVICE_PRESENCE" || die "DHCP presence history is missing"
grep -q 'current_from_arp' "$DEVICE_PRESENCE" || die "ARP presence source is missing"
grep -q 'refresh_from_current_snapshot' "$DEVICE_PRESENCE" || die "current LAN presence snapshot is not applied"
grep -q '\*,arp,\*' "$DEVICE_PRESENCE" || die "static-only detector state can be treated as online"
grep -q '"\$PRESENCE" refresh' "$SERVICE" || die "presence history is not refreshed after detection"
! grep -q '/etc/sheepfold/device-presence' "$DEVICE_PRESENCE" || die "device presence is written to persistent flash"

# Повторное определение не может менять пользовательскую политику доступа.
grep -q 'DEVICE_RECLASSIFY=.*/sheepfold-device-reclassify' "$CONTROL" || die "device reclassification is not routed"
grep -q 'exec "\$DEVICE_RECLASSIFY"' "$CONTROL" || die "device reclassification helper is not executed"
grep -q 'manual_device_type_locked' "$DEVICE_RECLASSIFY" || die "manual device type is not protected"
grep -q 'device-detection.flock' "$DEVICE_RECLASSIFY" || die "manual reclassification is not serialized"
grep -q 'sheepfold_lock_acquire' "$DEVICE_RECLASSIFY" || die "manual reclassification ignores the common lock helper"
! grep -q 'delete.*\.group\|delete.*allowlist\|delete.*blocklist' "$DEVICE_RECLASSIFY" || die "reclassification can change access policy"

# LED helper выбирает профиль по board name и сохраняет общий fallback.
grep -q 'PROFILE_ROOT="/usr/share/sheepfold/router-profiles"' "$LED_CONTROL" || die "router profile root is missing"
grep -q '/led/apply-mode' "$LED_CONTROL" || die "explicit LED apply-mode entry point is missing"
grep -q 'exec "\$LEGACY" led-apply' "$LED_CONTROL" || die "generic LED fallback is missing"
grep -q 'led-repair-status' "$CONTROL" || die "LED repair status is not routed"
grep -q 'led-repair-apply' "$CONTROL" || die "LED repair apply is not routed"
[ "$(cat "$CUDY_LED_PACKAGE")" = "mdio-tools" ] || die "Cudy LED dependency package is invalid"
[ "$(cat "$CUDY_LED_COMMAND")" = "mdio" ] || die "Cudy LED dependency command is invalid"
grep -q 'mdio mt7530-0 0:0x1f raw 0x21 0x0008' "$CUDY_LED_APPLY_MODE" || die "Cudy WR3000S LED command is missing"
grep -q 'PREFERRED_LED="white:wan-online"' "$CUDY_FIX_INSTALL" || die "Cudy WAN online LED name is missing"
grep -q 'system.\$SECTION.sheepfold_managed' "$CUDY_FIX_INSTALL" || die "LED fix ownership marker is missing"
grep -q 'find_equivalent_section' "$CUDY_FIX_INSTALL" || die "LED fix does not preserve existing equivalent settings"
grep -q 'system.\$SECTION.sheepfold_managed' "$CUDY_FIX_UNINSTALL" || die "LED fix rollback does not verify ownership"

# SHEEPFOLD_AI_BEGIN
# AI gate проверяет идентичность, роль, согласие и квоту серверными данными.
grep -q 'device_identity_mismatch' "$AI_GATE" || die "AI device identity verification is missing"
grep -q 'client_role_mismatch' "$AI_GATE" || die "AI role verification is missing"
grep -q 'parental_consent_required' "$AI_GATE" || die "child AI parental consent is missing"
grep -q 'ai_rate_limit_requests' "$AI_GATE" || die "AI per-device request limit is missing"
grep -q 'privileged_context_forbidden' "$AI_GATE" || die "AI privileged context guard is missing"
grep -q 'Проверенная роль: ребёнок' "$AI_HANDLER" || die "child AI prompt is missing"
grep -q 'Обезличенное состояние роутера' "$AI_HANDLER" || die "AI diagnostics masking is missing"

# Журнал активности входит только в AI Support.
grep -q 'sheepfold.log' "$ACTIVITY_LOG" || die "explicit activity-log filename format is missing"
grep -q 'restore_staged_logs' "$ACTIVITY_LOG" || die "activity-log rollback is missing"
! grep -q 'mtime "+7"' "$ACTIVITY_LOG" || die "hard-coded seven-day retention remains"
# SHEEPFOLD_AI_END

# Общие ключи и хранилища должны быть транзакционными.
grep -q '.key-derive.lock' "$KEY_DERIVE" || die "key initialization lock is missing"
grep -q 'extroot_not_implemented_safely' "$USB_STORAGE" || die "unsafe automatic extroot remains enabled"
grep -q 'PRIVACY_NOTICE_SOURCE' "$USB_STORAGE" || die "USB privacy notice is not copied after mount"

# LuCI не получает общий read/write wildcard на runtime-каталог.
! grep -q '"/tmp/sheepfold/\*"' "$ACL" || die "broad runtime ACL wildcard remains"
# SHEEPFOLD_AI_BEGIN
grep -q 'sheepfold-openssl-ensure' "$ACL" || die "OpenSSL verification helper is absent from LuCI ACL"
grep -q "ai_individual_logs='0'" "$OPENSSL_ENSURE" || die "OpenSSL failure does not disable individual logs"
grep -q "private_logs='0'" "$OPENSSL_ENSURE" || die "OpenSSL failure does not disable the local log collector"
# SHEEPFOLD_AI_END

# QR v2 закрепляет публичный ключ API до первого сетевого запроса Android.
grep -q 'openssl pkey -pubin' "$TLS_FINGERPRINT" || die "TLS SPKI fingerprint calculation is missing"
grep -q 'tls-public-key-fingerprint' "$CONTROL" || die "TLS SPKI fingerprint command is not connected"

for script in \
    "$CGI" "$CGI_LEGACY" "$CONTROL" "$CONTROL_LEGACY" "$CLIENT_STATUS" \
    "$SERVICE" "$DEVICE_DETECTOR" "$DEVICE_ID" "$DEVICE_CLASSIFIER" "$DEVICE_MDNS" \
    "$DEVICE_PRESENCE" "$DEVICE_RECLASSIFY" "$DHCP_SIGNALS" "$LED_CONTROL" \
    "$STATUS_API" "$ACCESS_REQUEST" "$ADMIN_NOTIFICATION" "$FIREWALL" "$SCHEDULE_EVALUATOR" \
    "$EMERGENCY_SITES" "$SITE_LISTS" "$DOMAIN_POLICY" "$ADGUARD_ADAPTER" "$ADGUARD_INSTALL" "$ADGUARD_FEED" \
	"$PAIR_API" "$PAIR_COMMON" "$PAIR_ATTEMPTS" "$TOKEN_COMMON" "$HASH_COMMON" "$LOCK_COMMON" "$LOG_COMMON" "$POLICY_COMMON" "$PAIR_ACTIVATE" "$PAIR_DEVICE" "$TLS_FINGERPRINT" \
    $VARIANT_EXECUTABLES "$MAINTENANCE_WINDOW" \
    "$KEY_DERIVE" "$USB_STORAGE" "$WELL_KNOWN_GENERATOR" \
    "$CUDY_LED_APPLY_MODE" "$CUDY_FIX_INSTALL" "$CUDY_FIX_UNINSTALL"; do
    /bin/sh -n "$script" || die "shell syntax error in $script"
done

exit 0
