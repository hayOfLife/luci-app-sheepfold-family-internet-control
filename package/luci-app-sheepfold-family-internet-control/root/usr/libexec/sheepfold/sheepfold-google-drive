#!/bin/sh
# Архивирование журналов и резервных копий настроек в Google Drive через Drive API v3.
set -eu
# Списки переменных объявляются через local: без него shell запускает первое
# имя как команду. Локальные имена также не перезаписывают состояние caller.

DRIVE_API="https://www.googleapis.com/drive/v3"
DRIVE_UPLOAD="https://www.googleapis.com/upload/drive/v3"
TOKEN_URL="https://oauth2.googleapis.com/token"
RAM_ARCHIVE_DIR="/tmp/sheepfold/.private/archive"
EVENTS_LOG="/tmp/sheepfold/events.log"
BACKUP_STAGING="/tmp/sheepfold/.gdrive-backup-staging"
SYNC_STATUS_FILE="/tmp/sheepfold/.gdrive-sync-status.json"
TOKEN_CACHE="/tmp/sheepfold/.gdrive-token.json"
FOLDER_CACHE="/tmp/sheepfold/.gdrive-folders.json"
# Контекст задаётся самим процессом, а не доверяется переменным окружения.
DOWNLOAD_ROOT="/tmp"
DRIVE_CONTEXT_KEY=''
DRIVE_CONTEXT_ROOT=''
DRIVE_CONTEXT_SNAPSHOT=''

uci_get() {
	uci -q get "sheepfold.gdrive.$1" 2>/dev/null || printf '%s' "${2:-}"
}

global_get() {
	uci -q get "sheepfold.global.$1" 2>/dev/null || printf '%s' "${2:-}"
}

json_escape() {
	printf '%s' "$1" | tr '\r\n\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

have_curl() {
	command -v curl >/dev/null 2>&1
}

credentials_ready() {
	local client_id refresh_token
	client_id="$(uci_get client_id '')"
	refresh_token="$(uci_get refresh_token '')"
	[ -n "$client_id" ] && [ -n "$refresh_token" ]
}

normalize_root_folder() {
	local folder snapshot current
	# Недоступная настройка не разрешает выбрать другую папку по умолчанию.
	snapshot="$(uci -q show sheepfold.gdrive)" || return 1
	if ! folder="$(uci -q get sheepfold.gdrive.root_folder)"; then
		case "
$snapshot" in *'
sheepfold.gdrive.root_folder='*) return 1 ;; esac
		folder='/sheepfold'
	fi
	current="$(uci -q show sheepfold.gdrive)" || return 1
	[ "$current" = "$snapshot" ] || return 1
	folder="${folder#/}"
	folder="${folder%/}"
	[ -n "$folder" ] || folder="sheepfold"
	printf '%s' "$folder"
}

quota_mb() {
	local quota snapshot current
	snapshot="$(uci -q show sheepfold.gdrive)" || return 1
	if ! quota="$(uci -q get sheepfold.gdrive.quota_mb)"; then
		case "
$snapshot" in *'
sheepfold.gdrive.quota_mb='*) return 1 ;; esac
		quota=500
	fi
	current="$(uci -q show sheepfold.gdrive)" || return 1
	[ "$snapshot" = "$current" ] || return 1
	case "$quota" in
		50|100|250|500|1024) printf '%s' "$quota" ;;
		*) return 1 ;;
	esac
}

require_tooling() {
	if ! have_curl; then
		printf '{"ok":false,"error":"curl_required"}\n'
		return 1
	fi
	if ! credentials_ready; then
		printf '{"ok":false,"error":"credentials_missing"}\n'
		return 1
	fi
	return 0
}

json_get_string() {
	local key
	key="$1"
	printf '%s' "$2" | sed -n "s/.*\"$key\":\"\\([^\"]*\\)\".*/\\1/p" | head -1
}

json_get_number() {
	local key
	key="$1"
	printf '%s' "$2" | sed -n "s/.*\"$key\":\\([0-9][0-9]*\\).*/\\1/p" | head -1
}

# Снимок реквизитов нужен и для обмена, и для ключа кэша. Ошибку get нельзя
# принимать за пустой client_secret: пустое поле допустимо только если отсутствует.
drive_auth_read() {
	auth_snapshot="$(uci -q show sheepfold.gdrive)" || return 1
	client_id="$(uci -q get sheepfold.gdrive.client_id)" || return 1
	refresh_token="$(uci -q get sheepfold.gdrive.refresh_token)" || return 1
	if ! client_secret="$(uci -q get sheepfold.gdrive.client_secret)"; then
		case "
$auth_snapshot" in *'
sheepfold.gdrive.client_secret='*) return 1 ;; esac
		client_secret=''
	fi
	[ -n "$client_id" ] && [ -n "$refresh_token" ] || return 1
	[ "${#client_id}" -le 8192 ] && [ "${#client_secret}" -le 8192 ] && [ "${#refresh_token}" -le 8192 ] || return 1
	drive_auth_unchanged
}

drive_auth_unchanged() {
	local current
	current="$(uci -q show sheepfold.gdrive)" || return 1
	[ "$current" = "$auth_snapshot" ]
}

# Ключ папок отличается от ключа токена: место загрузки определяется также
# нормализованным root_folder. Секреты остаются в закрытом временном файле.
drive_folder_context_key() (
	umask 077
	LC_ALL=C
	export LC_ALL
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	{
		printf 'gdrive-folders-v1\n' || exit 1
		for value in "$@"; do
			printf '%s:%s' "${#value}" "$value" || exit 1
		done
	} >"$work/identity" || exit 1
	chmod 600 "$work/identity" || exit 1
	drive_auth_key "$work/identity"
)

# Вложенные вызовы наследуют один снимок, а не начинают новую операцию после
# замеченной смены аккаунта. Это обнаружение изменений, не UCI-транзакция.
drive_context_check() {
	local current
	[ -n "$DRIVE_CONTEXT_KEY" ] || return 0
	current="$(uci -q show sheepfold.gdrive)" || return 1
	[ "$current" = "$DRIVE_CONTEXT_SNAPSHOT" ]
}

drive_context_begin() {
	local auth_snapshot client_id client_secret refresh_token root_name context_key
	if [ -n "$DRIVE_CONTEXT_KEY" ]; then
		drive_context_check
		return $?
	fi
	drive_auth_read || return 1
	root_name="$(normalize_root_folder)" || return 1
	drive_auth_unchanged || return 1
	context_key="$(drive_folder_context_key "$client_id" "$client_secret" "$refresh_token" "$root_name")" || return 1
	drive_auth_unchanged || return 1
	DRIVE_CONTEXT_SNAPSHOT="$auth_snapshot"
	DRIVE_CONTEXT_ROOT="$root_name"
	DRIVE_CONTEXT_KEY="$context_key"
}

# Нулевые/нечисловые часы не подтверждают срок. Ограничение разрядности
# удерживает всю арифметику внутри int64; ведущие нули остаются десятичными.
drive_auth_number() {
	local value
	value="$(drive_decimal "$1")" || return 1
	[ "${#value}" -le 10 ] || return 1
	printf '%s' "$value"
}

drive_auth_now() {
	local now
	now="$(date +%s)" || return 1
	now="$(drive_auth_number "$now")" || return 1
	[ "$now" -gt 0 ] || return 1
	printf '%s' "$now"
}

drive_bearer_valid() {
	[ "${#1}" -le 8192 ] || return 1
	case "$1" in ''|*[!A-Za-z0-9._~+/=-]*) return 1 ;; esac
	# Bearer не может добавлять строки HTTP-заголовков или JSON-кавычки.
	return 0
}

drive_auth_key() {
	local digest
	if command -v sha256sum >/dev/null 2>&1; then
		digest="$(sha256sum "$1")" || return 1
		digest="${digest%% *}"
	elif command -v openssl >/dev/null 2>&1; then
		digest="$(openssl dgst -sha256 "$1")" || return 1
		digest="${digest##* }"
	else
		return 1
	fi
	[ "${#digest}" = 64 ] || return 1
	case "$digest" in *[!a-fA-F0-9]*) return 1 ;; esac
	printf '%s' "$digest" | tr 'A-F' 'a-f'
}

# json_load в jshn.sh использует eval командной подстановки и может скрыть
# exit парсера. Исполняем только полностью полученный вывод доверенного jshn.
drive_json_load() {
	local json_script
	json_script="$(jshn -r "$1")" || return 1
	eval "$json_script"
}

# Не regex: OAuth JSON может содержать пробелы и другой порядок полей.
# Разбираем ответ в subshell, не меняя JSON-контекст вызывающего обработчика.
drive_oauth_values() (
	# Native jshn проверяет отсутствующие поля через unset-переменные.
	set +u
	[ -r /usr/share/libubox/jshn.sh ] || exit 1
	. /usr/share/libubox/jshn.sh
	json_init
	drive_json_load "$1" || exit 1
	if json_get_type value_type error; then exit 1; fi
	json_get_type value_type access_token || exit 1
	[ "$value_type" = string ] || exit 1
	json_get_var new_token access_token || exit 1
	drive_bearer_valid "$new_token" || exit 1
	json_get_type value_type token_type || exit 1
	[ "$value_type" = string ] || exit 1
	json_get_var token_kind token_type || exit 1
	token_kind="$(printf '%s' "$token_kind" | tr 'A-Z' 'a-z')" || exit 1
	[ "$token_kind" = bearer ] || exit 1
	json_get_type value_type expires_in || exit 1
	[ "$value_type" = int ] || exit 1
	json_get_var lifetime expires_in || exit 1
	lifetime="$(drive_auth_number "$lifetime")" || exit 1
	[ "$lifetime" -gt 0 ] && [ "$lifetime" -le 2147483647 ] || exit 1
	printf '%s\t%s' "$new_token" "$lifetime"
)

drive_cached_token() (
	# Native jshn проверяет отсутствующие поля через unset-переменные.
	set +u
	[ -r /usr/share/libubox/jshn.sh ] || exit 1
	. /usr/share/libubox/jshn.sh
	json_init
	drive_json_load "$1" || exit 1
	json_get_type value_type cache_key || exit 1
	[ "$value_type" = string ] || exit 1
	json_get_var stored_key cache_key || exit 1
	[ "$stored_key" = "$2" ] || exit 1
	json_get_type value_type access_token || exit 1
	[ "$value_type" = string ] || exit 1
	json_get_var cached_token access_token || exit 1
	drive_bearer_valid "$cached_token" || exit 1
	for key in issued_at expires_at; do
		json_get_type value_type "$key" || exit 1
		[ "$value_type" = int ] || exit 1
	done
	json_get_var issued_at issued_at || exit 1
	json_get_var expires_at expires_at || exit 1
	issued_at="$(drive_auth_number "$issued_at")" || exit 1
	expires_at="$(drive_auth_number "$expires_at")" || exit 1
	[ "$issued_at" -gt 0 ] && [ "$3" -ge "$issued_at" ] && [ "$expires_at" -gt "$3" ] || exit 1
	printf '%s' "$cached_token"
)

access_token() (
	drive_context_check || exit 1
	umask 077
	LC_ALL=C
	export LC_ALL
	require_tooling || exit 1
	# Кэш необязателен, но произвольный объект по его пути нельзя перезаписать.
	[ ! -L "$TOKEN_CACHE" ] || exit 1
	[ ! -e "$TOKEN_CACHE" ] || [ -f "$TOKEN_CACHE" ] || exit 1
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	drive_auth_read || exit 1
	# Длины отделяют поля без неоднозначной конкатенации; в кэше нет refresh token.
	printf '%s:%s%s:%s%s:%s' "${#client_id}" "$client_id" \
		"${#client_secret}" "$client_secret" "${#refresh_token}" "$refresh_token" >"$work/identity" || exit 1
	cache_key="$(drive_auth_key "$work/identity")" || exit 1
	now="$(drive_auth_now)" || exit 1
	if [ -f "$TOKEN_CACHE" ]; then
		chmod 600 "$TOKEN_CACHE" || exit 1
		cache_data="$(cat "$TOKEN_CACHE")" || exit 1
		if cached_token="$(drive_cached_token "$cache_data" "$cache_key" "$now")"; then
			drive_auth_unchanged || exit 1
			drive_context_check || exit 1
			printf '%s' "$cached_token"
			exit 0
		fi
	fi
	# curl кодирует содержимое, а argv содержит пути, не сами секреты.
	printf '%s' "$client_id" >"$work/client-id" || exit 1
	printf '%s' "$client_secret" >"$work/client-secret" || exit 1
	printf '%s' "$refresh_token" >"$work/refresh-token" || exit 1
	chmod 600 "$work/identity" "$work/client-id" "$work/client-secret" "$work/refresh-token" || exit 1
	drive_context_check || exit 1
	code="$(curl -sS -m 30 -X POST -o "$work/response" -w '%{http_code}' "$TOKEN_URL" \
		--data-urlencode "client_id@$work/client-id" \
		--data-urlencode "client_secret@$work/client-secret" \
		--data-urlencode "refresh_token@$work/refresh-token" \
		--data 'grant_type=refresh_token')" || exit 1
	drive_context_check || exit 1
	[ "$code" = 200 ] || exit 1
	response_bytes="$(drive_local_bytes "$work/response")" || exit 1
	[ "$response_bytes" -le 65536 ] || exit 1
	response="$(cat "$work/response")" || exit 1
	values="$(drive_oauth_values "$response")" || exit 1
	new_token="${values%%	*}"
	expires_in="${values#*	}"
	expires_at=$((now + expires_in))
	finished_at="$(drive_auth_now)" || exit 1
	[ "$finished_at" -ge "$now" ] && [ "$finished_at" -lt "$expires_at" ] || exit 1
	drive_auth_unchanged || exit 1
	# Короткий положительный срок не продлеваем запасным значением. Такой токен
	# используется сейчас, но не кэшируется с фиктивным длинным сроком.
	expires_at=$((expires_at - 60))
	if [ "$expires_at" -gt "$finished_at" ]; then
		printf '{"access_token":"%s","issued_at":%s,"expires_at":%s,"cache_key":"%s"}\n' \
			"$new_token" "$now" "$expires_at" "$cache_key" >"$work/cache" || exit 1
		chmod 600 "$work/cache" || exit 1
		[ ! -L "$TOKEN_CACHE" ] || exit 1
		[ ! -e "$TOKEN_CACHE" ] || [ -f "$TOKEN_CACHE" ] || exit 1
		# Сначала целая закрытая запись, затем rename на той же файловой системе.
		# Отказ не обнуляет предыдущий кэш и не публикует частичный JSON.
		mv "$work/cache" "$TOKEN_CACHE" || exit 1
	fi
	drive_context_check || exit 1
	printf '%s' "$new_token"
)

drive_request() {
	local method url extra token
	method="$1"
	url="$2"
	extra="${3:-}"

	token="$(access_token)" || return 1
	drive_context_check || return 1
	# shellcheck disable=SC2086
	curl -sS -m 120 -H "Authorization: Bearer $token" -X "$method" $extra "$url"
}


# Эти функции запускаются также внутри if: set -e там не защищает от
# промежуточного отказа. Каждый шаг до отправки/удаления проверяется явно.
drive_workdir() (
	umask 077
	[ ! -L /tmp/sheepfold ] || exit 1
	mkdir -p /tmp/sheepfold || exit 1
	chmod 700 /tmp/sheepfold || exit 1
	work="$(mktemp -d /tmp/sheepfold/.gdrive-upload.XXXXXX)" || exit 1
	# Путь принадлежит операции только после успешного mktemp.
	chmod 700 "$work" || { rm -rf "$work"; exit 1; }
	printf '%s' "$work"
)

drive_decimal() {
	local value
	value="$1"
	case "$value" in ''|*[!0-9]*) return 1 ;; esac
	[ "${#value}" -le 19 ] || return 1
	while :; do
		case "$value" in 0?*) value="${value#0}" ;; *) break ;; esac
	done
	printf '%s' "$value"
}

drive_local_bytes() {
	local bytes
	bytes="$(wc -c <"$1")" || return 1
	bytes="$(printf '%s' "$bytes" | tr -d '[:space:]')" || return 1
	drive_decimal "$bytes"
}

# jshn уже входит в зависимости обеих редакций. Не подключаем AI-only JSON
# library и не разбираем ответ Drive регуляркой, зависящей от пробелов.
drive_metadata_values() (
	# Native jshn проверяет отсутствующие поля через unset-переменные.
	set +u
	[ -r /usr/share/libubox/jshn.sh ] || exit 1
	. /usr/share/libubox/jshn.sh
	json_init
	drive_json_load "$1" || exit 1
	json_get_type value_type id || exit 1
	[ "$value_type" = string ] || exit 1
	json_get_var file_id id || exit 1
	case "$file_id" in ''|*[!A-Za-z0-9_-]*) exit 1 ;; esac
	[ "${#file_id}" -le 256 ] || exit 1
	if [ -z "${2:-}" ]; then
		printf '%s' "$file_id"
		exit 0
	fi
	[ "$file_id" = "$2" ] || exit 1
	json_get_type value_type size || exit 1
	case "$value_type" in string|int) ;; *) exit 1 ;; esac
	json_get_var remote_bytes size || exit 1
	remote_bytes="$(drive_decimal "$remote_bytes")" || exit 1
	printf '%s\t%s' "$file_id" "$remote_bytes"
)

remote_file_metadata() (
	file_id="$1"
	case "$file_id" in ''|*[!A-Za-z0-9_-]*) exit 1 ;; esac
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	token="$(access_token)" || exit 1
	drive_context_check || exit 1
	code="$(curl -sS -m 60 -o "$work/metadata" -w '%{http_code}' \
		-H "Authorization: Bearer $token" \
		"$DRIVE_API/files/$file_id?fields=id,size")" || exit 1
	drive_context_check || exit 1
	[ "$code" = 200 ] || exit 1
	response="$(cat "$work/metadata")" || exit 1
	drive_metadata_values "$response" "$file_id"
)

drive_upload_media() {
	local file_id local_path token code
	file_id="$1"
	local_path="$2"
	token="$(access_token)" || return 1
	drive_context_check || return 1
	code="$(curl -sS -m 120 -o /dev/null -w '%{http_code}' -X PATCH \
		-H "Authorization: Bearer $token" \
		-H "Content-Type: application/octet-stream" \
		--data-binary "@$local_path" \
		"$DRIVE_UPLOAD/files/$file_id?uploadType=media")" || return 1
	drive_context_check || return 1
	case "$code" in 200|201|204) printf '%s' "$code" ;; *) return 1 ;; esac
}

drive_create_file() (
	folder_id="$1"
	local_path="$2"
	filename="$3"
	umask 077
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	boundary="sheepfold_gdrive_${work##*/}"
	token="$(access_token)" || exit 1
	name_json="$(json_escape "$filename")" || exit 1
	{
		printf -- '--%s\r\n' "$boundary" || exit 1
		printf 'Content-Type: application/json; charset=UTF-8\r\n\r\n' || exit 1
		printf '{"name":"%s","parents":["%s"]}\r\n' "$name_json" "$folder_id" || exit 1
		printf -- '--%s\r\n' "$boundary" || exit 1
		printf 'Content-Type: application/octet-stream\r\n\r\n' || exit 1
		cat "$local_path" || exit 1
		printf '\r\n--%s--\r\n' "$boundary" || exit 1
	} >"$work/multipart" || exit 1
	chmod 600 "$work/multipart" || exit 1
	drive_context_check || exit 1
	code="$(curl -sS -m 120 -o "$work/response" -w '%{http_code}' -X POST \
		-H "Authorization: Bearer $token" \
		-H "Content-Type: multipart/related; boundary=$boundary" \
		--data-binary "@$work/multipart" \
		"$DRIVE_UPLOAD/files?uploadType=multipart&fields=id,size")" || exit 1
	drive_context_check || exit 1
	case "$code" in 200|201) ;; *) exit 1 ;; esac
	response="$(cat "$work/response")" || exit 1
	drive_metadata_values "$response"
)

# Поиск имеет три исхода: 0 — один проверенный ID; 4 — доказанно пустой
# полный ответ; 1 — отказ/неоднозначность. Только 4 разрешает новое создание.
drive_id_valid() {
	[ "${#1}" -le 256 ] || return 1
	case "$1" in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac
}

drive_query_literal() {
	local plain
	[ -n "$1" ] && [ "${#1}" -le 1024 ] || return 1
	plain="$(printf '%s' "$1" | LC_ALL=C tr -d '[:cntrl:]')" || return 1
	[ "$plain" = "$1" ] || return 1
	# Сначала экранирование языка Drive (\ и '), затем curl кодирует URL.
	# Подмена только пробелов не защищает &, +, %, # и обратную косую черту.
	printf '%s' "$1" | LC_ALL=C awk '
		{ for (i=1;i<=length($0);i++) {
			c=substr($0,i,1)
			if(c=="\\") printf "\\\\"
			else if(c=="\047") printf "\\\047"
			else printf "%s",c
		} }
	'
}

drive_search_id() (
	set +u
	set -f
	[ -r /usr/share/libubox/jshn.sh ] || exit 1
	. /usr/share/libubox/jshn.sh
	json_init
	drive_json_load "$1" || exit 1
	if json_get_type value_type error; then exit 1; fi
	if json_get_type value_type incompleteSearch; then
		[ "$value_type" = boolean ] || exit 1
		json_get_var incomplete incompleteSearch || exit 1
		[ "$incomplete" = 0 ] || exit 1
	fi
	if json_get_type value_type nextPageToken; then
		[ "$value_type" = string ] || exit 1
		json_get_var page_token nextPageToken || exit 1
		[ -z "$page_token" ] || exit 1
	fi
	json_get_type value_type files || exit 1
	[ "$value_type" = array ] || exit 1
	json_select files || exit 1
	json_get_keys indexes || exit 1
	# jshn возвращает только собственные числовые индексы массива.
	set -- $indexes
	[ "$#" -gt 0 ] || exit 4
	# Два совпадения/следующая страница не дают права выбрать произвольное.
	[ "$#" = 1 ] || exit 1
	json_get_type value_type "$1" || exit 1
	[ "$value_type" = object ] || exit 1
	json_select "$1" || exit 1
	json_get_type value_type id || exit 1
	[ "$value_type" = string ] || exit 1
	json_get_var file_id id || exit 1
	drive_id_valid "$file_id" || exit 1
	printf '%s' "$file_id"
)

drive_find_id() (
	parent_id="$1"
	name="$2"
	kind="$3"
	drive_id_valid "$parent_id" || exit 1
	literal="$(drive_query_literal "$name")" || exit 1
	case "$kind" in
		folder) mime_test="mimeType='application/vnd.google-apps.folder'" ;;
		file) mime_test="mimeType!='application/vnd.google-apps.folder'" ;;
		*) exit 1 ;;
	esac
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	umask 077
	printf "name='%s' and %s and '%s' in parents and trashed=false" \
		"$literal" "$mime_test" "$parent_id" >"$work/query" || exit 1
	token="$(access_token)" || exit 1
	drive_context_check || exit 1
	code="$(curl -sS -m 60 --get -o "$work/search" -w '%{http_code}' \
		-H "Authorization: Bearer $token" \
		--data-urlencode "q@$work/query" \
		--data-urlencode 'fields=files(id),nextPageToken,incompleteSearch' \
		--data-urlencode 'pageSize=2' "$DRIVE_API/files")" || exit 1
	drive_context_check || exit 1
	[ "$code" = 200 ] || exit 1
	bytes="$(drive_local_bytes "$work/search")" || exit 1
	[ "${#bytes}" -le 5 ] && [ "$bytes" -le 65536 ] || exit 1
	response="$(cat "$work/search")" || exit 1
	drive_search_id "$response"
)

find_folder_id() {
	drive_find_id "$1" "$2" folder
}

create_folder_id() (
	parent_id="$1"
	name="$2"
	drive_id_valid "$parent_id" || exit 1
	drive_query_literal "$name" >/dev/null || exit 1
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	umask 077
	name_json="$(json_escape "$name")" || exit 1
	printf '{"name":"%s","mimeType":"application/vnd.google-apps.folder","parents":["%s"]}' \
		"$name_json" "$parent_id" >"$work/folder-metadata" || exit 1
	chmod 600 "$work/folder-metadata" || exit 1
	token="$(access_token)" || exit 1
	drive_context_check || exit 1
	code="$(curl -sS -m 60 -X POST -o "$work/response" -w '%{http_code}' \
		-H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
		--data-binary "@$work/folder-metadata" "$DRIVE_API/files?fields=id")" || exit 1
	drive_context_check || exit 1
	case "$code" in 200|201) ;; *) exit 1 ;; esac
	response="$(cat "$work/response")" || exit 1
	drive_metadata_values "$response"
)

ensure_folder_id() {
	local parent_id name folder_id result
	parent_id="$1"
	name="$2"
	if folder_id="$(find_folder_id "$parent_id" "$name")"; then
		printf '%s' "$folder_id"
		return 0
	else
		result=$?
		[ "$result" = 4 ] || return 1
	fi
	create_folder_id "$parent_id" "$name"
}

cache_folder_ids() (
	drive_context_begin || exit 1
	# Старый кэш остаётся до полной подготовки нового. Ссылки и каталоги
	# по имени кэша не должны перенаправлять запись в другой объект.
	[ ! -L "$FOLDER_CACHE" ] || exit 1
	[ ! -e "$FOLDER_CACHE" ] || [ -f "$FOLDER_CACHE" ] || exit 1
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	umask 077
	root_name="$DRIVE_CONTEXT_ROOT"
	root_id="$(ensure_folder_id root "$root_name")" || exit 1
	logs_id="$(ensure_folder_id "$root_id" logs)" || exit 1
	backups_id="$(ensure_folder_id "$root_id" backups)" || exit 1
	name_json="$(json_escape "$root_name")" || exit 1
	printf '{"root":"%s","logs":"%s","backups":"%s","root_name":"%s","context_key":"%s"}\n' \
		"$root_id" "$logs_id" "$backups_id" "$name_json" "$DRIVE_CONTEXT_KEY" >"$work/folders" || exit 1
	chmod 600 "$work/folders" || exit 1
	[ ! -L "$FOLDER_CACHE" ] || exit 1
	[ ! -e "$FOLDER_CACHE" ] || [ -f "$FOLDER_CACHE" ] || exit 1
	drive_context_check || exit 1
	mv "$work/folders" "$FOLDER_CACHE" || exit 1
	drive_context_check
)

drive_cached_folder() (
	set +u
	[ -r /usr/share/libubox/jshn.sh ] || exit 1
	. /usr/share/libubox/jshn.sh
	json_init
	drive_json_load "$1" || exit 1
	for key in root logs backups; do
		json_get_type value_type "$key" || exit 1
		[ "$value_type" = string ] || exit 1
		json_get_var folder_id "$key" || exit 1
		drive_id_valid "$folder_id" || exit 1
	done
	json_get_type value_type root_name || exit 1
	[ "$value_type" = string ] || exit 1
	json_get_var root_name root_name || exit 1
	# 4 означает старый/чужой контекст, не повреждённый JSON. При отказе
	# повторного поиска такой кэш нельзя использовать как запасной.
	if ! json_get_type value_type context_key; then exit 4; fi
	[ "$value_type" = string ] || exit 1
	json_get_var stored_key context_key || exit 1
	[ "${#stored_key}" = 64 ] || exit 1
	case "$stored_key" in *[!a-f0-9]*) exit 1 ;; esac
	[ "$stored_key" = "$3" ] && [ "$root_name" = "$4" ] || exit 4
	json_get_var folder_id "$2" || exit 1
	printf '%s' "$folder_id"
)

folder_id_from_cache() (
	key="$1"
	case "$key" in root|logs|backups) ;; *) exit 1 ;; esac
	drive_context_begin || exit 1
	[ ! -L "$FOLDER_CACHE" ] || exit 1
	if [ ! -e "$FOLDER_CACHE" ]; then cache_folder_ids || exit 1; fi
	[ ! -L "$FOLDER_CACHE" ] && [ -f "$FOLDER_CACHE" ] || exit 1
	response="$(cat "$FOLDER_CACHE")" || exit 1
	if folder_id="$(drive_cached_folder "$response" "$key" "$DRIVE_CONTEXT_KEY" "$DRIVE_CONTEXT_ROOT")"; then
		:
	else
		result=$?
		[ "$result" = 4 ] || exit 1
		cache_folder_ids || exit 1
		# Другой publisher может заменить файл: проверяем реально прочитанный
		# результат, не считаем собственный прежний rename доказательством.
		[ ! -L "$FOLDER_CACHE" ] && [ -f "$FOLDER_CACHE" ] || exit 1
		response="$(cat "$FOLDER_CACHE")" || exit 1
		folder_id="$(drive_cached_folder "$response" "$key" "$DRIVE_CONTEXT_KEY" "$DRIVE_CONTEXT_ROOT")" || exit 1
	fi
	drive_context_check || exit 1
	printf '%s' "$folder_id"
)

remote_name_allowed() {
	local name
	name="$1"
	case "$name" in
		*/*|*..*) return 1 ;;
	esac
	return 0
}

resolve_remote_name() {
	local spec
	spec="$1"
	case "$spec" in
		logs/*) printf '%s' "${spec#logs/}" ;;
		backups/*) printf '%s' "${spec#backups/}" ;;
		*) printf '%s' "$spec" ;;
	esac
}

find_file_in_folder() {
	drive_find_id "$1" "$2" file
}

# Вывод для LuCI сохраняет прежние name/bytes/modified. JSON строит штатный
# jshn: разбор по строкам зависит от pretty-print и портит экранированные имена.
drive_listing_item() (
	row="$(drive_inventory_item "$1")" || exit 1
	tab="$(printf '\t')"
	item_id="${row%%$tab*}"
	rest="${row#*$tab}"
	item_bytes="${rest%%$tab*}"
	json_get_var item_name name || exit 1
	json_get_type value_type modifiedTime || exit 1
	[ "$value_type" = string ] || exit 1
	json_get_var modified modifiedTime || exit 1
	[ -n "$modified" ] && [ "${#modified}" -le 64 ] || exit 1
	json_init
	json_add_string name "$item_name" || exit 1
	json_add_int bytes "$item_bytes" || exit 1
	json_add_string modified "$modified" || exit 1
	# Одна JSON-строка на объект нужна только внутреннему framing. Переводы
	# строк в самом имени остаются экранированными, не становятся разделителями.
	JSON_INDENT=''
	encoded="$(json_dump -n)" || exit 1
	[ -n "$encoded" ] || exit 1
	printf '%s\t%s\n' "$item_id" "$encoded"
)

drive_listing_rows() (
	set +u
	set -f
	[ -r /usr/share/libubox/jshn.sh ] || exit 1
	. /usr/share/libubox/jshn.sh
	json_init
	drive_json_load "$1" || exit 1
	parent_id="$2"
	if json_get_type value_type error; then exit 1; fi
	if json_get_type value_type incompleteSearch; then
		[ "$value_type" = boolean ] || exit 1
		json_get_var incomplete incompleteSearch || exit 1
		[ "$incomplete" = 0 ] || exit 1
	fi
	if json_get_type value_type nextPageToken; then
		[ "$value_type" = string ] || exit 1
		json_get_var page_token nextPageToken || exit 1
		[ -z "$page_token" ] || exit 1
	fi
	json_get_type value_type files || exit 1
	[ "$value_type" = array ] || exit 1
	json_select files || exit 1
	json_get_keys indexes || exit 1
	set -- $indexes
	[ "$#" -le 200 ] || exit 1
	for index in "$@"; do
		json_get_type value_type "$index" || exit 1
		[ "$value_type" = object ] || exit 1
		( json_select "$index" && drive_listing_item "$parent_id" ) || exit 1
	done
)

folder_list_json_array() (
	folder_id="$1"
	drive_id_valid "$folder_id" || exit 1
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	umask 077
	token="$(access_token)" || exit 1
	drive_context_check || exit 1
	code="$(curl -sS -m 60 --get -o "$work/listing-response" -w '%{http_code}' \
		-H "Authorization: Bearer $token" \
		--data-urlencode "q='$folder_id' in parents and trashed=false and mimeType!='application/vnd.google-apps.folder'" \
		--data-urlencode 'fields=files(id,name,size,modifiedTime,mimeType,parents,trashed),nextPageToken,incompleteSearch' \
		--data-urlencode 'pageSize=200' --data-urlencode 'orderBy=modifiedTime desc,name' \
		"$DRIVE_API/files")" || exit 1
	drive_context_check || exit 1
	[ "$code" = 200 ] || exit 1
	bytes="$(drive_local_bytes "$work/listing-response")" || exit 1
	[ "${#bytes}" -le 6 ] && [ "$bytes" -le 262144 ] || exit 1
	response="$(cat "$work/listing-response")" || exit 1
	# До публикации проверяется вся папка. Ошибка последней записи не должна
	# оставлять вызывающему коду успешный или частичный список первых записей.
	drive_listing_rows "$response" "$folder_id" >"$work/listing-rows" || exit 1
	awk -F '\t' 'seen[$1]++ { exit 1 }' "$work/listing-rows" || exit 1
	drive_context_check || exit 1
	awk 'BEGIN { sep="" } { sub(/^[^\t]*\t/, ""); printf "%s%s", sep, $0; sep="," }' "$work/listing-rows"
)

# Квота основана на полном списке двух папок, не на regex отдельных size.
# Числа ограничены до арифметики: total*100 также помещается в int64.
drive_usage_number() {
	local value
	value="$(drive_decimal "$1")" || return 1
	[ "${#value}" -le 15 ] || return 1
	printf '%s' "$value"
}

drive_inventory_item() (
	json_get_type value_type id || exit 1
	[ "$value_type" = string ] || exit 1
	json_get_var item_id id || exit 1
	drive_id_valid "$item_id" || exit 1
	json_get_type value_type size || exit 1
	case "$value_type" in string|int) ;; *) exit 1 ;; esac
	json_get_var item_bytes size || exit 1
	item_bytes="$(drive_usage_number "$item_bytes")" || exit 1
	json_get_type value_type name || exit 1
	[ "$value_type" = string ] || exit 1
	json_get_var item_name name || exit 1
	json_get_type value_type mimeType || exit 1
	[ "$value_type" = string ] || exit 1
	json_get_var mime_type mimeType || exit 1
	case "$mime_type" in ''|application/vnd.google-apps.folder) exit 1 ;; esac
	json_get_type value_type trashed || exit 1
	[ "$value_type" = boolean ] || exit 1
	json_get_var trashed trashed || exit 1
	[ "$trashed" = 0 ] || exit 1
	json_get_type value_type parents || exit 1
	[ "$value_type" = array ] || exit 1
	json_select parents || exit 1
	json_get_keys parent_keys || exit 1
	set -- "$1" $parent_keys
	[ "$#" = 2 ] || exit 1
	json_get_type value_type "$2" || exit 1
	[ "$value_type" = string ] || exit 1
	json_get_var parent_id "$2" || exit 1
	[ "$parent_id" = "$1" ] || exit 1
	# Квота учитывает всё, но чистка не получает права удалить произвольный
	# документ или подпапку. Имена наружу не сериализуем в строковый протокол.
	eligible=0
	if remote_name_allowed "$item_name"; then
		case "$item_name" in *.tar.gz|*.tar|*.log) eligible=1 ;; esac
	fi
	printf '%s\t%s\t%s\n' "$item_id" "$item_bytes" "$eligible"
)

drive_inventory_rows() (
	set +u
	set -f
	[ -r /usr/share/libubox/jshn.sh ] || exit 1
	. /usr/share/libubox/jshn.sh
	json_init
	drive_json_load "$1" || exit 1
	parent_id="$2"
	if json_get_type value_type error; then exit 1; fi
	if json_get_type value_type incompleteSearch; then
		[ "$value_type" = boolean ] || exit 1
		json_get_var incomplete incompleteSearch || exit 1
		[ "$incomplete" = 0 ] || exit 1
	fi
	if json_get_type value_type nextPageToken; then
		[ "$value_type" = string ] || exit 1
		json_get_var page_token nextPageToken || exit 1
		[ -z "$page_token" ] || exit 1
	fi
	json_get_type value_type files || exit 1
	[ "$value_type" = array ] || exit 1
	json_select files || exit 1
	json_get_keys indexes || exit 1
	set -- $indexes
	[ "$#" -le 200 ] || exit 1
	for index in "$@"; do
		json_get_type value_type "$index" || exit 1
		[ "$value_type" = object ] || exit 1
		# Подобъект разбирается в дочерней оболочке, JSON cursor родителя
		# остаётся на массиве. Ошибку любой записи caller отбрасывает целиком.
		( json_select "$index" && drive_inventory_item "$parent_id" ) || exit 1
	done
)

drive_read_inventory() (
	folder_id="$1"
	output="$2"
	drive_id_valid "$folder_id" || exit 1
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	umask 077
	token="$(access_token)" || exit 1
	drive_context_check || exit 1
	code="$(curl -sS -m 60 --get -o "$work/inventory" -w '%{http_code}' \
		-H "Authorization: Bearer $token" \
		--data-urlencode "q='$folder_id' in parents and trashed=false and mimeType!='application/vnd.google-apps.folder'" \
		--data-urlencode 'fields=files(id,name,size,mimeType,parents,trashed),nextPageToken,incompleteSearch' \
		--data-urlencode 'pageSize=200' --data-urlencode 'orderBy=modifiedTime,name' \
		"$DRIVE_API/files")" || exit 1
	drive_context_check || exit 1
	[ "$code" = 200 ] || exit 1
	bytes="$(drive_local_bytes "$work/inventory")" || exit 1
	[ "${#bytes}" -le 6 ] && [ "$bytes" -le 262144 ] || exit 1
	response="$(cat "$work/inventory")" || exit 1
	drive_inventory_rows "$response" "$folder_id" >"$work/rows" || exit 1
	awk -F '\t' 'seen[$1]++ { exit 1 }' "$work/rows" || exit 1
	drive_context_check || exit 1
	cat "$work/rows" >"$output" || exit 1
)

drive_inventory_total() (
	# Один ID нельзя учесть дважды и затем удалить из неверной группы.
	awk -F '\t' 'seen[$1]++ { exit 1 }' "$@" || exit 1
	used=0
	tab="$(printf '\t')"
	for rows in "$@"; do
		while IFS="$tab" read -r item_id item_bytes eligible; do
			item_bytes="$(drive_usage_number "$item_bytes")" || exit 1
			used=$((used + item_bytes))
			[ "$used" -le 999999999999999 ] || exit 1
		done <"$rows"
	done
	printf '%s' "$used"
)

folder_used_bytes() (
	drive_context_begin || exit 1
	logs_id="$(folder_id_from_cache logs)" || exit 1
	backups_id="$(folder_id_from_cache backups)" || exit 1
	[ "$logs_id" != "$backups_id" ] || exit 1
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	drive_read_inventory "$logs_id" "$work/logs" || exit 1
	drive_read_inventory "$backups_id" "$work/backups" || exit 1
	used="$(drive_inventory_total "$work/logs" "$work/backups")" || exit 1
	drive_context_check || exit 1
	printf '%s' "$used"
)

# Просмотр статуса не разрешает создавать папки или переписывать folder cache.
# Только подтверждённое отсутствие даёт нулевой расход; ошибка поиска — отказ.
drive_status_bytes() (
	drive_context_begin || exit 1
	if root_id="$(find_folder_id root "$DRIVE_CONTEXT_ROOT")"; then
		:
	else
		result=$?
		[ "$result" = 4 ] || exit 1
		drive_context_check || exit 1
		printf '0'
		exit 0
	fi
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	umask 077
	seen="|$root_id|"
	for name in logs backups; do
		: >"$work/$name" || exit 1
		if folder_id="$(find_folder_id "$root_id" "$name")"; then
			case "$seen" in *"|$folder_id|"*) exit 1 ;; esac
			seen="$seen$folder_id|"
			drive_read_inventory "$folder_id" "$work/$name" || exit 1
		else
			result=$?
			[ "$result" = 4 ] || exit 1
		fi
	done
	used="$(drive_inventory_total "$work/logs" "$work/backups")" || exit 1
	drive_context_check || exit 1
	printf '%s' "$used"
)

usage_state() {
	local used_bytes quota_bytes pct
	used_bytes="$1"
	quota_bytes="$2"
	[ "$quota_bytes" -gt 0 ] || { printf 'error\t0\n'; return; }
	pct=$((used_bytes * 100 / quota_bytes))
	if [ "$used_bytes" -ge "$quota_bytes" ]; then
		printf 'error\t%s\n' "$pct"
	elif [ "$pct" -ge 80 ]; then
		printf 'warn\t%s\n' "$pct"
	else
		printf 'ok\t%s\n' "$pct"
	fi
}

write_sync_status() {
	local command_name ok message
	command_name="$1"
	ok="$2"
	message="$3"
	mkdir -p /tmp/sheepfold 2>/dev/null || true
	printf '{"command":"%s","ok":%s,"message":"%s","at":"%s"}\n' \
		"$(json_escape "$command_name")" "$ok" "$(json_escape "$message")" "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
		>"$SYNC_STATUS_FILE"
	chmod 600 "$SYNC_STATUS_FILE" 2>/dev/null || true
}

verify_upload() {
	local local_path remote_bytes local_bytes
	local_path="$1"
	if [ ! -f "$local_path" ]; then
		printf '{"ok":false,"error":"local_missing"}\n'
		return 1
	fi
	local_bytes="$(drive_local_bytes "$local_path")" || {
		printf '{"ok":false,"error":"local_read_failed"}\n'; return 1;
	}
	remote_bytes="$(drive_decimal "$2")" || {
		printf '{"ok":false,"error":"remote_metadata_invalid"}\n'; return 1;
	}
	# Сравниваем нормализованные строки, не int64/int32-арифметику shell.
	if [ "$local_bytes" = "$remote_bytes" ]; then
		printf '{"ok":true,"local_bytes":%s,"remote_bytes":%s}\n' "$local_bytes" "$remote_bytes"
		return 0
	fi
	printf '{"ok":false,"error":"size_mismatch","local_bytes":%s,"remote_bytes":%s}\n' \
		"$local_bytes" "$remote_bytes"
	return 1
}

upload_file_to_folder() {
	local folder_id local_path filename file_id result
	folder_id="$1"
	local_path="$2"
	filename="$3"
	if file_id="$(find_file_in_folder "$folder_id" "$filename")"; then
		case "$file_id" in *[!A-Za-z0-9_-]*) return 1 ;; esac
		drive_upload_media "$file_id" "$local_path" >/dev/null || return 1
	else
		result=$?
		[ "$result" = 4 ] || return 1
		file_id="$(drive_create_file "$folder_id" "$local_path" "$filename")" || return 1
	fi
	# Только отдельный ответ о конкретном Drive ID является удалённым размером.
	# wc локального файла здесь создавал фиктивное подтверждение загрузки.
	remote_file_metadata "$file_id"
}

upload_and_verify() (
	folder_id="$1"
	local_path="$2"
	filename="$3"
	umask 077
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	[ -f "$local_path" ] && [ ! -L "$local_path" ] || exit 1
	cp "$local_path" "$work/content" || exit 1
	chmod 600 "$work/content" || exit 1
	cmp -s "$local_path" "$work/content" || exit 1
	# Снимок не меняется от дописывания живого журнала во время HTTP-запроса.
	# Удалять исходный архив при замеченном изменении тоже нельзя.
	drive_local_bytes "$work/content" >/dev/null || exit 1
	if ! result="$(upload_file_to_folder "$folder_id" "$work/content" "$filename")"; then
		printf '{"ok":false,"error":"upload_unverified"}\n'
		exit 1
	fi
	remote_bytes="${result#*	}"
	verify_json="$(verify_upload "$work/content" "$remote_bytes")" || {
		printf '%s\n' "$verify_json"; exit 1;
	}
	if ! cmp -s "$local_path" "$work/content"; then
		printf '{"ok":false,"error":"source_changed"}\n'
		exit 1
	fi
	drive_context_check || exit 1
	printf '%s\n' "$verify_json"
)

# Секундное имя сохраняет внешний формат, но не задаёт владельца временных
# данных: config/events готовятся в закрытом каталоге одной операции.
drive_archive_stamp() {
	local stamp
	stamp="$(date +%Y%m%d-%H%M%S)" || return 1
	case "$stamp" in
		[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]) ;;
		*) return 1 ;;
	esac
	printf '%s' "$stamp"
}

create_config_backup() (
	work="${1:-}"
	[ -n "$work" ] && [ -d "$work" ] && [ ! -L "$work" ] || exit 1
	umask 077
	[ -f /etc/config/sheepfold ] && [ ! -L /etc/config/sheepfold ] || exit 1
	mkdir "$work/config-source" || exit 1
	cp -p /etc/config/sheepfold "$work/config-source/sheepfold" || exit 1
	chmod 600 "$work/config-source/sheepfold" || exit 1
	cmp -s /etc/config/sheepfold "$work/config-source/sheepfold" || exit 1
	stamp="$(drive_archive_stamp)" || exit 1
	backup_file="$work/sheepfold-config-$stamp.tar.gz"
	if command -v gzip >/dev/null 2>&1; then
		tar -C "$work/config-source" -czf "$backup_file" sheepfold || exit 1
		list_flags=-tzf
		read_flags=-xzOf
	else
		backup_file="${backup_file%.gz}"
		tar -C "$work/config-source" -cf "$backup_file" sheepfold || exit 1
		list_flags=-tf
		read_flags=-xOf
	fi
	chmod 600 "$backup_file" || exit 1
	# Проверяется собственный архив одного файла, не включается импорт.
	# Извлечение в stdout не применяет пути/права архива к роутеру.
	members="$(tar "$list_flags" "$backup_file")" || exit 1
	[ "$members" = sheepfold ] || exit 1
	tar "$read_flags" "$backup_file" sheepfold >"$work/config-verified" || exit 1
	cmp -s "$work/config-source/sheepfold" "$work/config-verified" || exit 1
	[ ! -L /etc/config/sheepfold ] || exit 1
	cmp -s /etc/config/sheepfold "$work/config-source/sheepfold" || exit 1
	printf '%s' "$backup_file"
)

# Отказ диагностики не должен мешать вернуть исходную ошибку подготовки.
drive_archive_prepare_error() {
	write_sync_status archive-push false "completed with errors" >/dev/null 2>&1 || :
	printf '{"ok":false,"error":"%s","pushed":0,"errors":1}\n' "$1"
	return 1
}

cmd_test() {
	require_tooling || return 1
	if access_token >/dev/null 2>&1; then
		printf '{"ok":true,"message":"Google Drive authorization works"}\n'
		cache_folder_ids >/dev/null 2>&1 || true
		return 0
	fi
	printf '{"ok":false,"error":"auth_failed"}\n'
	return 1
}

drive_list_error() {
	printf '{"ok":false,"error":"list_unavailable"}\n'
	return 1
}

cmd_list() (
	require_tooling || exit 1
	# Один контекст на обе папки. При отказе второй не отдаём первую как
	# полный результат и не повторяем чтение с незаметно сменившимся аккаунтом.
	drive_context_begin || { drive_list_error; exit 1; }
	cache_folder_ids || { drive_list_error; exit 1; }
	logs_id="$(folder_id_from_cache logs)" || { drive_list_error; exit 1; }
	backups_id="$(folder_id_from_cache backups)" || { drive_list_error; exit 1; }
	[ "$logs_id" != "$backups_id" ] || { drive_list_error; exit 1; }
	logs_json="$(folder_list_json_array "$logs_id")" || { drive_list_error; exit 1; }
	backups_json="$(folder_list_json_array "$backups_id")" || { drive_list_error; exit 1; }
	root_json="$(json_escape "/$DRIVE_CONTEXT_ROOT")" || { drive_list_error; exit 1; }
	drive_context_check || { drive_list_error; exit 1; }
	printf '{"ok":true,"root":"%s","logs":[%s],"backups":[%s]}\n' \
		"$root_json" "$logs_json" "$backups_json"
)

# Назначение download остаётся внутри /tmp. Проверяется каждый компонент:
# совпадение префикса не закрывает '..', ссылку или каталог вместо файла.
# Корень задаётся кодом, не окружением; тест переносит его в свой fixture.
drive_download_path() {
	local remaining part current
	[ -n "$1" ] && [ "${#1}" -le 4096 ] || return 1
	case "$1" in *[[:cntrl:]]*) return 1 ;; esac
	case "$1" in "$DOWNLOAD_ROOT"/*) ;; *) return 1 ;; esac
	[ -d "$DOWNLOAD_ROOT" ] && [ ! -L "$DOWNLOAD_ROOT" ] || return 1
	remaining="${1#"$DOWNLOAD_ROOT"/}"
	current="$DOWNLOAD_ROOT"
	while :; do
		part="${remaining%%/*}"
		case "$part" in ''|.|..) return 1 ;; esac
		current="$current/$part"
		[ ! -L "$current" ] || return 1
		if [ "$remaining" = "$part" ]; then
			[ ! -e "$current" ] || [ -f "$current" ] || return 1
			return 0
		fi
		[ ! -e "$current" ] || [ -d "$current" ] || return 1
		remaining="${remaining#*/}"
	done
}

drive_download_error() {
	# Только фиксированные внутренние коды, без текста сервера и секретов.
	printf '{"ok":false,"error":"%s"}\n' "$1"
	return 1
}

cmd_download() (
	# Изоляция сохраняет параметры caller и trap его резервной копии.
	# Ошибки проверяются явно: функцию вызывают также внутри условия.
	if [ "$#" != 2 ] || [ -z "${1:-}" ] || [ -z "${2:-}" ]; then
		printf '{"ok":false,"error":"usage","hint":"download <remote> <local>"}\n'
		exit 1
	fi
	remote_spec="$1"
	local_path="$2"
	filename="$(resolve_remote_name "$remote_spec")" || exit 1
	if ! remote_name_allowed "$filename" || [ -z "$filename" ] || [ "${#filename}" -gt 4096 ]; then
		drive_download_error path_not_allowed; exit 1
	fi
	# Управляющие байты не являются поддерживаемым CLI-именем; не подменяем
	# их пробелами при JSON-ответе и не меняем глобальный encoder ради download.
	case "$filename" in *[[:cntrl:]]*) drive_download_error path_not_allowed; exit 1 ;; esac
	drive_download_path "$local_path" || { drive_download_error local_path_not_allowed; exit 1; }
	require_tooling || exit 1
	drive_context_begin || { drive_download_error download_context_changed; exit 1; }
	case "$remote_spec" in
		logs/*) folder_key=logs ;;
		*) folder_key=backups ;;
	esac
	folder_id="$(folder_id_from_cache "$folder_key")" || { drive_download_error remote_lookup_failed; exit 1; }
	if file_id="$(find_file_in_folder "$folder_id" "$filename")"; then
		:
	else
		result=$?
		if [ "$result" = 4 ]; then drive_download_error remote_missing
		else drive_download_error remote_lookup_failed; fi
		exit 1
	fi
	before="$(remote_file_metadata "$file_id")" || { drive_download_error download_metadata_failed; exit 1; }
	expected_bytes="${before#*	}"
	token="$(access_token)" || { drive_download_error download_auth_failed; exit 1; }
	drive_context_check || { drive_download_error download_context_changed; exit 1; }

	# curl никогда не открывает старый получатель. Временный файл рядом
	# с ним позволяет опубликовать готовые байты одной операцией rename.
	umask 077
	parent="${local_path%/*}"
	drive_download_path "$local_path" || { drive_download_error local_path_not_allowed; exit 1; }
	mkdir -p "$parent" || { drive_download_error download_local_failed; exit 1; }
	drive_download_path "$local_path" || { drive_download_error local_path_not_allowed; exit 1; }
	work="$(mktemp -d "$parent/.gdrive-download.XXXXXX")" || { drive_download_error download_local_failed; exit 1; }
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	chmod 700 "$work" || { drive_download_error download_local_failed; exit 1; }
	: >"$work/content" || { drive_download_error download_local_failed; exit 1; }
	chmod 600 "$work/content" || { drive_download_error download_local_failed; exit 1; }
	# 0 отключает max-filesize: для пустого blob разрешаем не более одного
	# байта на уровне curl, а ниже в любом случае требуем точное совпадение.
	max_bytes="$expected_bytes"
	[ "$max_bytes" != 0 ] || max_bytes=1
	if ! code="$(curl -sS -m 120 --max-filesize "$max_bytes" -o "$work/content" -w '%{http_code}' \
		-H "Authorization: Bearer $token" "$DRIVE_API/files/$file_id?alt=media")"; then
		printf '{"ok":false,"error":"download_failed","http":0}\n'; exit 1
	fi
	drive_context_check || { drive_download_error download_context_changed; exit 1; }
	if [ "$code" != 200 ]; then
		case "$code" in [1-5][0-9][0-9]) ;; *) code=0 ;; esac
		printf '{"ok":false,"error":"download_failed","http":%s}\n' "$code"; exit 1
	fi
	actual_bytes="$(drive_local_bytes "$work/content")" || { drive_download_error download_local_failed; exit 1; }
	[ "$actual_bytes" = "$expected_bytes" ] || { drive_download_error download_size_mismatch; exit 1; }
	after="$(remote_file_metadata "$file_id")" || { drive_download_error download_metadata_failed; exit 1; }
	[ "$before" = "$after" ] || { drive_download_error download_remote_changed; exit 1; }
	remote_json="$(json_escape "$filename")" || { drive_download_error download_local_failed; exit 1; }
	local_json="$(json_escape "$local_path")" || { drive_download_error download_local_failed; exit 1; }
	chmod 600 "$work/content" || { drive_download_error download_local_failed; exit 1; }
	drive_context_check || { drive_download_error download_context_changed; exit 1; }
	drive_download_path "$local_path" || { drive_download_error local_path_not_allowed; exit 1; }
	# -T не позволяет незаметно переместить content внутрь каталога,
	# появившегося по целевому имени. Родительские path races остаются R14.
	mv -T "$work/content" "$local_path" || { drive_download_error download_local_failed; exit 1; }
	printf '{"ok":true,"remote":"%s","local":"%s","bytes":%s}\n' \
		"$remote_json" "$local_json" "$actual_bytes"
)

latest_backup_name() {
	backups_id response

	backups_id="$(folder_id_from_cache backups)" || return 1
	folder_list_json_array "$backups_id" |
		sed -n 's/.*"name":"\([^"]*\)".*/\1/p' |
		grep '^sheepfold-config-.*\.tar' |
		sort |
		tail -1
}

cmd_restore_config() {
	requested="$1"
	remote_spec local_archive safety_backup restore_dir tar_extract_flags=""

	require_tooling || return 1
	cache_folder_ids || return 1
	mkdir -p "$BACKUP_STAGING" 2>/dev/null || true

	if [ -n "$requested" ]; then
		remote_spec="backups/$requested"
	else
		requested="$(latest_backup_name 2>/dev/null || true)"
		[ -n "$requested" ] || {
			printf '{"ok":false,"error":"no_backups"}\n'
			return 1
		}
		remote_spec="backups/$requested"
	fi

	local_archive="$BACKUP_STAGING/restore-config-$$.tar.gz"
	cmd_download "$remote_spec" "$local_archive" >/dev/null || return 1

	if tar -tzf "$local_archive" 2>/dev/null | grep -Eq '^sheepfold$'; then
		tar_extract_flags="-xzf"
	elif tar -tf "$local_archive" 2>/dev/null | grep -Eq '^sheepfold$'; then
		tar_extract_flags="-xf"
	else
		rm -f "$local_archive"
		printf '{"ok":false,"error":"invalid_backup_archive"}\n'
		return 1
	fi

	safety_backup="/tmp/sheepfold/sheepfold-config-before-restore-$(date +%Y%m%d-%H%M%S).tar.gz"
	mkdir -p /tmp/sheepfold 2>/dev/null || true
	if command -v gzip >/dev/null 2>&1; then
		tar -C /etc/config -czf "$safety_backup" sheepfold 2>/dev/null || safety_backup=""
	else
		safety_backup="${safety_backup%.gz}"
		tar -C /etc/config -cf "$safety_backup" sheepfold 2>/dev/null || safety_backup=""
	fi

	restore_dir="$BACKUP_STAGING/restore-config-extract-$$"
	mkdir -p "$restore_dir"
	if ! tar -C "$restore_dir" $tar_extract_flags "$local_archive" sheepfold 2>/dev/null; then
		rm -rf "$restore_dir" "$local_archive"
		printf '{"ok":false,"error":"extract_failed"}\n'
		return 1
	fi

	if [ ! -f "$restore_dir/sheepfold" ]; then
		rm -rf "$restore_dir" "$local_archive"
		printf '{"ok":false,"error":"missing_sheepfold_config"}\n'
		return 1
	fi

	cp "$restore_dir/sheepfold" /etc/config/sheepfold
	chmod 600 /etc/config/sheepfold 2>/dev/null || true
	rm -rf "$restore_dir" "$local_archive"

	if [ -x /etc/init.d/sheepfold ]; then
		/etc/init.d/sheepfold restart >/dev/null 2>&1 || true
	fi

	printf '{"ok":true,"restored":"%s","safety_backup":"%s"}\n' \
		"$(json_escape "$requested")" "$(json_escape "${safety_backup:-}")"
}

cmd_status() (
	local backend authorized state message used_mb quota free_pct used_bytes quota_bytes state_line used_pct
	backend="google_drive"
	authorized=0
	state="error"
	message="Google Drive is not configured"
	used_mb=0
	quota="$(quota_mb)" || {
		printf '{"backend":"google_drive","state":"error","message":"Could not read storage status.","authorized":0,"used_mb":0,"quota_mb":0,"free_pct":0}\n'
		return 0
	}
	free_pct=100

	if [ "$(global_get log_storage ram)" != "google_drive" ]; then
		message="Google Drive is selected only when log storage is set to Google Drive"
		printf '{"backend":"%s","state":"%s","message":"%s","authorized":%s,"used_mb":%s,"quota_mb":%s,"free_pct":%s}\n' \
			"$backend" "$state" "$(json_escape "$message")" "$authorized" "$used_mb" "$quota" "$free_pct"
		return 0
	fi

	if ! have_curl; then
		message="curl is required for Google Drive on the router"
		printf '{"backend":"%s","state":"%s","message":"%s","authorized":%s,"used_mb":%s,"quota_mb":%s,"free_pct":%s}\n' \
			"$backend" "$state" "$(json_escape "$message")" "$authorized" "$used_mb" "$quota" "$free_pct"
		return 0
	fi

	if ! credentials_ready; then
		message="Enter Google OAuth client ID and refresh token"
		printf '{"backend":"%s","state":"%s","message":"%s","authorized":%s,"used_mb":%s,"quota_mb":%s,"free_pct":%s}\n' \
			"$backend" "$state" "$(json_escape "$message")" "$authorized" "$used_mb" "$quota" "$free_pct"
		return 0
	fi

	if ! drive_context_begin || ! access_token >/dev/null 2>&1; then
		message="Google Drive authorization failed"
		printf '{"backend":"%s","state":"error","message":"%s","authorized":0,"used_mb":0,"quota_mb":%s,"free_pct":0}\n' \
			"$backend" "$(json_escape "$message")" "$quota"
		return 0
	fi

	authorized=1
	if ! used_bytes="$(drive_status_bytes 2>/dev/null)" || ! drive_context_check; then
		printf '{"backend":"%s","state":"error","message":"Could not read storage status.","authorized":1,"used_mb":0,"quota_mb":%s,"free_pct":0}\n' "$backend" "$quota"
		return 0
	fi
	used_mb=$((used_bytes / 1024 / 1024))
	quota_bytes=$((quota * 1024 * 1024))
	state_line="$(usage_state "$used_bytes" "$quota_bytes")"
	state="${state_line%%	*}"
	used_pct="${state_line#*	}"
	free_pct=$((100 - used_pct))
	[ "$free_pct" -ge 0 ] || free_pct=0

	case "$state" in
		ok) message="Connected, ${used_mb} MB of ${quota} MB used" ;;
		warn) message="Low space soon, ${used_mb} MB of ${quota} MB used" ;;
		error) message="Sheepfold quota exceeded (${used_mb} MB of ${quota} MB)" ;;
	esac

	# authorized — результат этого чтения, не сохраняемая настройка.
	# Общий commit здесь сохранял также чужие pending-изменения Sheepfold.

	printf '{"backend":"%s","state":"%s","message":"%s","authorized":%s,"used_mb":%s,"quota_mb":%s,"free_pct":%s}\n' \
		"$backend" "$state" "$(json_escape "$message")" "$authorized" "$used_mb" "$quota" "$free_pct"
)

drive_delete_file() {
	local file_id token code
	file_id="$1"
	drive_id_valid "$file_id" || return 1
	token="$(access_token)" || return 1
	drive_context_check || return 1
	code="$(curl -sS -m 60 -o /dev/null -w '%{http_code}' -X DELETE \
		-H "Authorization: Bearer $token" \
		"$DRIVE_API/files/$file_id")" || return 1
	drive_context_check || return 1
	case "$code" in 200|204) return 0 ;; esac
	return 1
}

prune_remote_logs() (
	quota_bytes="$(drive_usage_number "$1")" || exit 1
	drive_context_begin || exit 1
	logs_id="$(folder_id_from_cache logs)" || exit 1
	backups_id="$(folder_id_from_cache backups)" || exit 1
	[ "$logs_id" != "$backups_id" ] || exit 1
	work="$(drive_workdir)" || exit 1
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	# Ни один DELETE не разрешён до полной проверки обеих папок. Частичная
	# страница, ошибка или неполный поиск не являются доказанной квотой.
	drive_read_inventory "$logs_id" "$work/plan" || exit 1
	drive_read_inventory "$backups_id" "$work/backups" || exit 1
	used_bytes="$(drive_inventory_total "$work/plan" "$work/backups")" || exit 1
	[ "$used_bytes" -gt "$quota_bytes" ] || exit 0
	tab="$(printf '\t')"
	while IFS="$tab" read -r file_id file_bytes eligible; do
		[ "$eligible" = 1 ] && [ "$file_bytes" -gt 0 ] || continue
		drive_delete_file "$file_id" || exit 1
		# Не продолжаем удаление по старому total после отказа или устаревшего
		# ответа. Уже выполненный DELETE не откатывается этим перечитыванием.
		previous_bytes="$used_bytes"
		drive_read_inventory "$logs_id" "$work/current" || exit 1
		drive_read_inventory "$backups_id" "$work/backups" || exit 1
		used_bytes="$(drive_inventory_total "$work/current" "$work/backups")" || exit 1
		[ "$used_bytes" -lt "$previous_bytes" ] || exit 1
		[ "$used_bytes" -gt "$quota_bytes" ] || exit 0
	done <"$work/plan"
	# Backups и посторонние документы остаются. Невозможность достичь квоты
	# удалением журналов — ошибка, не разрешение расширить область удаления.
	exit 1
)

cmd_push_events() (
	local logs_id verify_json

	[ "$(global_get log_storage ram)" = "google_drive" ] || return 0
	[ -f "$EVENTS_LOG" ] || return 0
	require_tooling || return 1
	drive_context_begin || return 1

	cache_folder_ids || return 1
	logs_id="$(folder_id_from_cache logs)" || return 1

	verify_json="$(upload_and_verify "$logs_id" "$EVENTS_LOG" events.log)" || {
		write_sync_status push-events false "upload verify failed"
		printf '%s\n' "$verify_json"
		return 1
	}

	drive_context_check || return 1
	write_sync_status push-events true "events.log uploaded"
	printf '%s\n' "$verify_json"
)

cmd_archive_push() (
	local logs_id backups_id quota quota_bytes pushed errors archive events_copy backup_file work stamp
	[ "$(global_get log_storage ram)" = "google_drive" ] || return 0
	# Старый флаг authorized не доказывает текущий доступ и не является
	# согласием на загрузку. Его задаёт log_storage; токен проверит поиск папок.
	require_tooling || return 1
	drive_context_begin || return 1

	umask 077
	work="$(drive_workdir)" || { drive_archive_prepare_error backup_prepare_failed; return 1; }
	trap 'rm -rf "$work"' EXIT
	trap 'exit 1' HUP INT TERM
	# Проверяем local backup до удаления отправленных RAM-архивов и до
	# облачных действий: подавленный tar-отказ раньше давал ложный ok=true.
	backup_file="$(create_config_backup "$work")" || {
		drive_archive_prepare_error backup_prepare_failed
		return 1
	}
	events_copy=''
	if [ -L "$EVENTS_LOG" ] || { [ -e "$EVENTS_LOG" ] && [ ! -f "$EVENTS_LOG" ]; }; then
		drive_archive_prepare_error events_snapshot_failed
		return 1
	fi
	if [ -f "$EVENTS_LOG" ]; then
		stamp="$(drive_archive_stamp)" || { drive_archive_prepare_error events_snapshot_failed; return 1; }
		events_copy="$work/events-$stamp.log"
		cp "$EVENTS_LOG" "$events_copy" && chmod 600 "$events_copy" && cmp -s "$EVENTS_LOG" "$events_copy" || {
			drive_archive_prepare_error events_snapshot_failed
			return 1
		}
	fi
	drive_context_check || return 1
	cache_folder_ids || return 1
	logs_id="$(folder_id_from_cache logs)" || return 1
	backups_id="$(folder_id_from_cache backups)" || return 1
	quota="$(quota_mb)" || return 1
	quota_bytes=$((quota * 1024 * 1024))

	pushed=0
	errors=0

	for archive in "$RAM_ARCHIVE_DIR"/*.tar.gz "$RAM_ARCHIVE_DIR"/*.tar; do
		[ -f "$archive" ] || continue
		if upload_and_verify "$logs_id" "$archive" "$(basename "$archive")" >/dev/null 2>&1; then
			drive_context_check || return 1
			rm -f "$archive"
			pushed=$((pushed + 1))
		else
			drive_context_check || return 1
			errors=$((errors + 1))
		fi
	done

	if [ -n "$events_copy" ]; then
		if upload_and_verify "$logs_id" "$events_copy" "$(basename "$events_copy")" >/dev/null 2>&1; then
			drive_context_check || return 1
			pushed=$((pushed + 1))
		else
			drive_context_check || return 1
			errors=$((errors + 1))
		fi
	fi

	if upload_and_verify "$backups_id" "$backup_file" "$(basename "$backup_file")" >/dev/null 2>&1; then
		drive_context_check || return 1
		pushed=$((pushed + 1))
	else
		drive_context_check || return 1
		errors=$((errors + 1))
	fi

	drive_context_check || return 1
	if ! prune_remote_logs "$quota_bytes"; then
		errors=$((errors + 1))
	fi
	drive_context_check || return 1

	if [ "$errors" -gt 0 ]; then
		write_sync_status archive-push false "completed with errors"
		printf '{"ok":false,"pushed":%d,"errors":%d}\n' "$pushed" "$errors"
		return 1
	fi

	write_sync_status archive-push true "archive push completed"
	printf '{"ok":true,"pushed":%d,"errors":0}\n' "$pushed"
)

cmd_sync_status() {
	if [ -r "$SYNC_STATUS_FILE" ]; then
		cat "$SYNC_STATUS_FILE"
		return 0
	fi
	printf '{"ok":false,"message":"no sync yet"}\n'
}

command_name="${1:-}"
shift || true
case "$command_name" in
	status) cmd_status ;;
	test) cmd_test ;;
	list) cmd_list ;;
	download) cmd_download "$@" ;;
	restore-config) cmd_restore_config "$1" ;;
	sync-status) cmd_sync_status ;;
	verify) verify_upload "$1" "$2" ;;
	push-events) cmd_push_events ;;
	archive-push) cmd_archive_push ;;
	*)
		echo "Usage: sheepfold-google-drive <status|test|list|download|restore-config|sync-status|verify|push-events|archive-push>" >&2
		exit 1
		;;
esac
